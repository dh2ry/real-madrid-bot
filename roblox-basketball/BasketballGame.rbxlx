-- 🏀 الكرة
------------------------------------------------------------------
local ball = Instance.new("Part")
ball.Name = "GameBall"
ball.Shape = Enum.PartType.Ball
ball.Size = Vector3.new(BALL_SIZE, BALL_SIZE, BALL_SIZE)
ball.CustomPhysicalProperties = PhysicalProperties.new(0.4, 0.4, 0.8, 1, 100)
ball.TopSurface = Enum.SurfaceType.Smooth
ball.BottomSurface = Enum.SurfaceType.Smooth
ball.Position = Vector3.new(0, 6, 0)
ball:SetAttribute("HolderId", 0)
ball:SetAttribute("ShotDeadline", 0)
ball.Parent = workspace
applyBallSkin(ball, "classic")

local bounceSound = makeSound(ball, SOUNDS.Bounce, "Bounce")
local rimSound = makeSound(ball, SOUNDS.Rim, "RimHit")
local stealSound = makeSound(ball, SOUNDS.Steal, "Steal")

-- قوة ترفع الكرة جزئياً عشان يكون قوس الرمية جميل (جاذبية أخف للكرة فقط)
local ballAttachment = Instance.new("Attachment")
ballAttachment.Parent = ball
local antiGravity = Instance.new("VectorForce")
antiGravity.Attachment0 = ballAttachment
antiGravity.RelativeTo = Enum.ActuatorRelativeTo.World
antiGravity.ApplyAtCenterOfMass = true
antiGravity.Force = Vector3.new(0, ball:GetMass() * (workspace.Gravity - CONFIG.BALL_GRAVITY), 0)
antiGravity.Parent = ball

local ballState = {
	Holder = nil,
	HeldSince = 0,
	StealProtect = 0,
	Locked = false,
	LastShot = nil,
	LastToucher = nil,
	LooseSince = os.clock(),
	LastBounce = 0,
	NoPickup = {},
	StealCooldown = {},
	PrevPos = ball.Position,
}

local function setBallOwnerServer()
	pcall(function()
		ball:SetNetworkOwner(nil)
	end)
end
setBallOwnerServer()

local function releaseBall()
	local weld = ball:FindFirstChild("HoldWeld")
	if weld then
		weld:Destroy()
	end
	ball.Massless = false
	ball.CanCollide = true
	antiGravity.Enabled = true
	ballState.Holder = nil
	ballState.LooseSince = os.clock()
	ball:SetAttribute("HolderId", 0)
	ball:SetAttribute("ShotDeadline", 0)
	setBallOwnerServer()
end

local function resetBallCenter()
	releaseBall()
	ballState.LastToucher = nil
	ballState.LastShot = nil
	ball.CFrame = CFrame.new(0, 9, 0)
	ball.AssemblyLinearVelocity = Vector3.zero
	ball.AssemblyAngularVelocity = Vector3.zero
end

------------------------------------------------------------------
-- 👥 الفرق
------------------------------------------------------------------
local Match = {
	State = "Waiting",
	Pads = {},              -- Pads[i] = اللاعب الواقف على المربع i (قبل المباراة)
	Teams = { {}, {} },     -- لاعبين كل فريق (وقت المباراة)
	Scores = { 0, 0 },
	TimeLeft = CONFIG.MATCH_TIME,
	Message = "",
}

local function isMatchLive()
	return Match.State == "Playing" or Match.State == "Overtime"
end

local function teamOf(plr)
	if not plr then
		return nil
	end
	for t = 1, 2 do
		for _, p in ipairs(Match.Teams[t]) do
			if p == plr then
				return t
			end
		end
	end
	return nil
end

local function presentMembers(t)
	local list = {}
	for _, p in ipairs(Match.Teams[t]) do
		if p.Parent then
			table.insert(list, p)
		end
	end
	return list
end

local function randomMember(t)
	local list = presentMembers(t)
	if #list == 0 then
		return nil
	end
	return list[math.random(1, #list)]
end

local function padIndexOf(plr)
	for i = 1, #pads do
		if Match.Pads[i] == plr then
			return i
		end
	end
	return nil
end

local function padPlayers(t)
	local list = {}
	for i, def in ipairs(PAD_DEFS) do
		if def.Team == t and Match.Pads[i] then
			table.insert(list, Match.Pads[i])
		end
	end
	return list
end

------------------------------------------------------------------
-- ✋ مسك الكرة
------------------------------------------------------------------
local function giveBall(plr)
	local char = plr and plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		resetBallCenter()
		return
	end
	releaseBall()
	ball.AssemblyLinearVelocity = Vector3.zero
	ball.AssemblyAngularVelocity = Vector3.zero
	ball.CanCollide = false
	ball.Massless = true
	antiGravity.Enabled = false
	ball.CFrame = hrp.CFrame * CFrame.new(0.9, -0.2, -1.6)
	local weld = Instance.new("WeldConstraint")
	weld.Name = "HoldWeld"
	weld.Part0 = hrp
	weld.Part1 = ball
	weld.Parent = ball

	ballState.Holder = plr
	ballState.HeldSince = os.clock()
	ballState.StealProtect = os.clock() + 0.8
	ballState.LastToucher = plr
	ball:SetAttribute("HolderId", plr.UserId)
	ball:SetAttribute("ShotDeadline", isMatchLive() and (workspace:GetServerTimeNow() + CONFIG.SHOT_CLOCK) or 0)
	local prof = profiles[plr]
	applyBallSkin(ball, prof and prof.EquippedBall or "classic")
end

local function giveBallToTeam(t)
	local p = randomMember(t)
	if p then
		giveBall(p)
	else
		resetBallCenter()
	end
	return p
end

local function canTouchBall(plr)
	if Match.State == "Waiting" then
		return true
	end
	if isMatchLive() then
		return teamOf(plr) ~= nil
	end
	return false
end

local function playerFromHit(hit)
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	local plr = Players:GetPlayerFromCharacter(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if plr and hum and hum.Health > 0 then
		return plr
	end
	return nil
end

ball.Touched:Connect(function(hit)
	if ballState.Holder then
		return
	end
	local plr = playerFromHit(hit)
	if not plr then
		-- صوت نطة الكرة أو ضربة الحلقة
		if os.clock() - ballState.LastBounce > 0.12 and ball.AssemblyLinearVelocity.Magnitude > 5 then
			ballState.LastBounce = os.clock()
			playSound(hit.Name == "Rim" and rimSound or bounceSound)
		end
		return
	end
	if ballState.Locked or not canTouchBall(plr) then
		return
	end
	local blockedUntil = ballState.NoPickup[plr]
	if blockedUntil and os.clock() < blockedUntil then
		return
	end
	giveBall(plr)
end)

------------------------------------------------------------------
-- 🎯 الرمي
------------------------------------------------------------------
local rng = Random.new()

local function targetHoopFor(plr, pos)
	local t = isMatchLive() and teamOf(plr)
	if t then
		return hoopForTeam(t)
	end
	return hoops[pos.X >= 0 and 1 or -1]
end

-- سرعة تخلي الكرة توصل من start إلى target خلال T ثانية
local function launchVelocity(start, target, T)
	local g = CONFIG.BALL_GRAVITY
	local d = target - start
	return Vector3.new(d.X / T, (d.Y + 0.5 * g * T * T) / T, d.Z / T)
end

ShootEvent.OnServerEvent:Connect(function(plr, power)
	if ballState.Holder ~= plr then
		return
	end
	if typeof(power) ~= "number" or power ~= power then
		return
	end
	power = math.clamp(power, 0, 1)
	local char = plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end

	local hoop = targetHoopFor(plr, hrp.Position)
	local rim = hoop.Center
	local start = hrp.Position + Vector3.new(0, 2.5, 0)
	local flat = Vector3.new(rim.X - start.X, 0, rim.Z - start.Z)
	local dist = flat.Magnitude
	local dir = dist > 0.01 and flat.Unit or Vector3.new(hoop.Side, 0, 0)
	start += dir * 1.2

	-- الدقة: كل ما بعدت عن المنطقة الخضراء كل ما زاد الخطأ
	local diff = power - CONFIG.PERFECT_POWER
	local err = math.max(0, math.abs(diff) - CONFIG.PERFECT_WINDOW) * 9
	local sideDir = Vector3.new(-dir.Z, 0, dir.X)
	local lateral = (rng:NextNumber() - 0.5) * (dist * 0.025 + err * 0.6)
	local target = rim + dir * (math.sign(diff) * err) + sideDir * lateral

	local rimFlat = Vector3.new(rim.X, 0, rim.Z)
	local posFlat = Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
	local isThree = (posFlat - rimFlat).Magnitude > THREE_R or math.abs(hrp.Position.Z) > THREE_CORNER_Z

	releaseBall()
	ball.CFrame = CFrame.new(start)
	ball.AssemblyLinearVelocity = launchVelocity(start, target, 0.55 + dist * 0.022)
	ball.AssemblyAngularVelocity = sideDir * -8
	ballState.LastShot = { Shooter = plr, Points = isThree and 3 or 2, Time = os.clock() }
	ballState.LastToucher = plr
	ballState.NoPickup[plr] = os.clock() + 0.6
end)

------------------------------------------------------------------
-- 🤝 التمرير (لزميلك في 2 ضد 2، أو لأقرب لاعب وقت التدريب)
------------------------------------------------------------------
PassEvent.OnServerEvent:Connect(function(plr)
	if ballState.Holder ~= plr then
		return
	end
	local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end

	local candidates
	local myTeam = isMatchLive() and teamOf(plr)
	if myTeam then
		candidates = presentMembers(myTeam)
	elseif Match.State == "Waiting" then
		candidates = Players:GetPlayers()
	else
		return
	end

	local best, bestDist
	for _, other in ipairs(candidates) do
		local ohrp = other ~= plr and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
		local hum = ohrp and other.Character:FindFirstChildOfClass("Humanoid")
		if ohrp and hum and hum.Health > 0 then
			local d = (ohrp.Position - hrp.Position).Magnitude
			if d <= CONFIG.PASS_RANGE and (not bestDist or d < bestDist) then
				best, bestDist = ohrp, d
			end
		end
	end
	if not best then
		notify(plr, myTeam and "زميلك بعيد أو مو موجود" or "ما فيه أحد قريب تمرر له", COLORS.Red)
		return
	end

	local dir = (best.Position - hrp.Position) * Vector3.new(1, 0, 1)
	dir = dir.Magnitude > 0.01 and dir.Unit or hrp.CFrame.LookVector
	local start = hrp.Position + Vector3.new(0, 1, 0) + dir * 1.6
	local T = math.clamp(bestDist / 45, 0.3, 0.9)
	local lead = best.AssemblyLinearVelocity * Vector3.new(1, 0, 1) * T
	local target = best.Position + lead + Vector3.new(0, 0.5, 0)

	releaseBall()
	ball.CFrame = CFrame.new(start)
	ball.AssemblyLinearVelocity = launchVelocity(start, target, T)
	ballState.LastShot = nil
	ballState.LastToucher = plr
	ballState.NoPickup[plr] = os.clock() + 0.5
end)

------------------------------------------------------------------
-- 🥷 السرقة
------------------------------------------------------------------
StealEvent.OnServerEvent:Connect(function(plr)
	local myTeam = teamOf(plr)
	if not (Match.State == "Waiting" or (isMatchLive() and myTeam)) then
		return
	end
	local now = os.clock()
	if (ballState.StealCooldown[plr] or 0) > now then
		return
	end
	ballState.StealCooldown[plr] = now + CONFIG.STEAL_COOLDOWN
	local holder = ballState.Holder
	if not holder or holder == plr or now < ballState.StealProtect then
		return
	end
	if isMatchLive() and teamOf(holder) == myTeam then
		return -- ما تسرق من زميلك
	end
	local myHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	local hisHrp = holder.Character and holder.Character:FindFirstChild("HumanoidRootPart")
	if not myHrp or not hisHrp or (myHrp.Position - hisHrp.Position).Magnitude > CONFIG.STEAL_RANGE then
		notify(plr, "اقترب أكثر عشان تسرق الكرة", COLORS.Red)
		return
	end
	if rng:NextNumber() < CONFIG.STEAL_CHANCE then
		giveBall(plr)
		playSound(stealSound)
		notify(plr, "🥷 سرقت الكرة!", COLORS.Green)
		notify(holder, "انسرقت منك الكرة!", COLORS.Red)
	else
		notify(plr, "فشلت محاولة السرقة", COLORS.Red)
	end
end)

------------------------------------------------------------------
-- 🏆 نظام المباراة
------------------------------------------------------------------
local STATE_TEXT = {
	Waiting = "بانتظار لاعبين",
	Countdown = "استعداد...",
	Playing = "المباراة جارية",
	Overtime = "السلة الذهبية!",
	Ended = "انتهت المباراة",
}

local function namesOf(list)
	local names = {}
	for _, p in ipairs(list) do
		table.insert(names, p.DisplayName)
	end
	return #names > 0 and table.concat(names, " و ") or "—"
end

local function currentTeamLists()
	if #Match.Teams[1] > 0 or #Match.Teams[2] > 0 then
		return Match.Teams[1], Match.Teams[2]
	end
	return padPlayers(1), padPlayers(2)
end

local function refresh()
	local team1, team2 = currentTeamLists()
	local n1, n2 = namesOf(team1), namesOf(team2)
	local size = math.max(#team1, #team2, 1)
	local mode = string.format("%d ضد %d", size, size)

	remotes:SetAttribute("State", Match.State)
	remotes:SetAttribute("TimeLeft", Match.TimeLeft)
	remotes:SetAttribute("Score1", Match.Scores[1])
	remotes:SetAttribute("Score2", Match.Scores[2])
	remotes:SetAttribute("P1Name", n1)
	remotes:SetAttribute("P2Name", n2)
	remotes:SetAttribute("Mode", mode)
	remotes:SetAttribute("Message", Match.Message)

	local t = math.max(0, Match.TimeLeft)
	local timeText = string.format("%d:%02d", t // 60, t % 60)
	for _, refs in ipairs(boardRefs) do
		refs.P1Name.Text = n1
		refs.P2Name.Text = n2
		refs.Score1.Text = tostring(Match.Scores[1])
		refs.Score2.Text = tostring(Match.Scores[2])
		refs.Time.Text = timeText
		refs.Status.Text = (STATE_TEXT[Match.State] or "") .. " • " .. mode
	end

	for i, def in ipairs(PAD_DEFS) do
		local plr = Match.Pads[i]
		padLabels[i].Text = TEAM_NAME[def.Team] .. "\n" .. (plr and plr.DisplayName or "قف هنا للعب")
	end
end

local function setState(state, message)
	Match.State = state
	Match.Message = message or ""
	refresh()
end

-- الانضمام عن طريق الوقوف على المربع (مسموح وقت الانتظار والعد التنازلي)
for i, pad in ipairs(pads) do
	pad.Touched:Connect(function(hit)
		if Match.State ~= "Waiting" and Match.State ~= "Countdown" then
			return
		end
		local plr = playerFromHit(hit)
		if not plr or padIndexOf(plr) or Match.Pads[i] then
			return
		end
		Match.Pads[i] = plr
		local team = PAD_DEFS[i].Team
		notify(plr, "انضممت للفريق " .. TEAM_NAME[team] .. "! 🏀", TEAM_COLOR[team])
		refresh()
	end)
end

local function validatePads()
	for i = 1, #pads do
		local plr = Match.Pads[i]
		if plr then
			local hrp = plr.Parent and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			local padPos = pads[i].Position
			local offPad = not hrp
				or Vector2.new(hrp.Position.X - padPos.X, hrp.Position.Z - padPos.Z).Magnitude > 5
			if offPad then
				Match.Pads[i] = nil
				notify(plr, "خرجت من المربع، تم إلغاء انضمامك", COLORS.Red)
			end
		end
	end
	refresh()
end

-- ترجع حجم الفريق إذا الفرق متساوية (1 ضد 1 أو 2 ضد 2)
local function balancedSize()
	local c1, c2 = #padPlayers(1), #padPlayers(2)
	if c1 >= 1 and c1 == c2 then
		return c1
	end
	return nil
end

local function teleport(plr, cf)
	local char = plr and plr.Character
	if char and char.PrimaryPart then
		char:PivotTo(cf)
	end
end

local function spawnFor(plr)
	local t = teamOf(plr)
	if not t then
		return nil
	end
	for k, p in ipairs(Match.Teams[t]) do
		if p == plr then
			return TEAM_SPAWN[t][k] or TEAM_SPAWN[t][1]
		end
	end
	return nil
end

local function kickSpectatorsOffCourt()
	for _, plr in ipairs(Players:GetPlayers()) do
		if not teamOf(plr) then
			local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local p = hrp.Position
				if math.abs(p.X) < HALF_L + 2 and math.abs(p.Z) < HALF_W + 2 and p.Y < 20 then
					teleport(plr, LOBBY_CF)
					notify(plr, "الملعب مشغول بمباراة، تفرّج من المدرجات 🍿", COLORS.Gold)
				end
			end
		end
	end
end

local function checkLiveBall()
	local holder = ballState.Holder
	if holder then
		if os.clock() - ballState.HeldSince > CONFIG.SHOT_CLOCK then
			local t = teamOf(holder)
			if t then
				local p = giveBallToTeam(3 - t)
				notifyAll("⏱️ انتهى وقت الهجمة! الكرة لـ " .. (p and p.DisplayName or "الخصم"), COLORS.Gold)
			end
		end
		return
	end
	if ballState.Locked then
		return
	end
	local p = ball.Position
	local outside = math.abs(p.X) > HALF_L + 0.5 or math.abs(p.Z) > HALF_W + 0.5
	local resting = p.Y < FLOOR_Y + 3 or ball.AssemblyLinearVelocity.Magnitude < 2
	local stale = os.clock() - ballState.LooseSince > 10
	if (outside and resting) or p.Y < -20 or stale then
		local t = teamOf(ballState.LastToucher)
		if t then
			local receiver = giveBallToTeam(3 - t)
			notifyAll("🚫 خرجت الكرة! الاستحواذ لـ " .. (receiver and receiver.DisplayName or "الخصم"), COLORS.Gold)
		else
			resetBallCenter()
		end
	end
end

local function onBasket(hoop)
	flashHoop(hoop)
	playSound(hoop.Swish)
	local shot = ballState.LastShot
	local recentShooter = shot and (os.clock() - shot.Time < 4) and shot.Shooter or nil
	ballState.LastShot = nil

	if isMatchLive() then
		local t = (hoop.Side == 1) and 1 or 2
		local shooterOnTeam = recentShooter and teamOf(recentShooter) == t
		local points = (shooterOnTeam and shot) and shot.Points or 2
		local scorer = shooterOnTeam and recentShooter or randomMember(t)
		Match.Scores[t] += points
		addCoins(scorer, CONFIG.COINS_PER_BASKET)
		notifyAll(string.format("🏀 %s سجّل %d نقاط للفريق %s!", scorer and scorer.DisplayName or "؟", points, TEAM_NAME[t]),
			TEAM_COLOR[t])
		playSound(cheerSound)
		refresh()
		ballState.Locked = true
		task.delay(1.2, function()
			ballState.Locked = false
			if isMatchLive() then
				giveBallToTeam(3 - t)
			end
		end)
	elseif recentShooter and shot then
		notify(recentShooter, string.format("🏀 سلة! %d نقاط (تدريب)", shot.Points), COLORS.Green)
	end
end

-- كشف دخول الكرة في السلة (لازم تنزل من فوق الحلقة لتحتها داخل الدائرة)
RunService.Heartbeat:Connect(function()
	local pos = ball.Position
	local prev = ballState.PrevPos
	ballState.PrevPos = pos
	if ballState.Holder or ballState.Locked or not prev then
		return
	end
	for _, hoop in pairs(hoops) do
		local c = hoop.Center
		if prev.Y >= c.Y and pos.Y < c.Y then
			local t = (prev.Y - c.Y) / (prev.Y - pos.Y)
			local cross = prev:Lerp(pos, t)
			if Vector2.new(cross.X - c.X, cross.Z - c.Z).Magnitude < RIM_R - 0.25 then
				onBasket(hoop)
			end
		end
	end
end)

-- فحص دوري: إذا مات حامل الكرة أو طلع، أو طاحت الكرة من الماب
task.spawn(function()
	while true do
		local holder = ballState.Holder
		if holder then
			local char = holder.Parent and holder.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local weld = ball:FindFirstChild("HoldWeld")
			if not hrp or not hum or hum.Health <= 0 or not weld or weld.Part0 ~= hrp then
				local dropAt = ball.Position
				releaseBall()
				ball.CFrame = CFrame.new(dropAt.X, math.max(dropAt.Y, 3), dropAt.Z)
			end
		elseif not isMatchLive() then
			local p = ball.Position
			if p.Y < -20 or math.abs(p.X) > 150 or math.abs(p.Z) > 150 then
				resetBallCenter()
			end
		end
		task.wait(0.1)
	end
end)

local function finishMatch(winnerTeam, reason)
	local message
	if winnerTeam then
		local loserTeam = 3 - winnerTeam
		for _, p in ipairs(Match.Teams[winnerTeam]) do
			addCoins(p, CONFIG.COINS_WIN)
			local prof = profiles[p]
			if prof then
				prof.Wins += 1
				updateLeaderstats(p)
				task.spawn(saveWins, p)
			end
			notify(p, "🏆 فزت! +" .. CONFIG.COINS_WIN .. " 💰", COLORS.Gold)
		end
		for _, p in ipairs(Match.Teams[loserTeam]) do
			addCoins(p, CONFIG.COINS_LOSS)
			notify(p, "خسرت هالمرة، +" .. CONFIG.COINS_LOSS .. " 💰 للمشاركة", COLORS.White)
		end
		message = string.format("🏆 فاز الفريق %s: %s (%d - %d)%s", TEAM_NAME[winnerTeam],
			namesOf(Match.Teams[winnerTeam]), Match.Scores[1], Match.Scores[2], reason and ("\n" .. reason) or "")
	else
		for t = 1, 2 do
			for _, p in ipairs(Match.Teams[t]) do
				addCoins(p, CONFIG.COINS_DRAW)
			end
		end
		message = string.format("🤝 تعادل! (%d - %d)", Match.Scores[1], Match.Scores[2])
	end
	notifyAll(message, COLORS.Gold)
	resetBallCenter()
	setState("Ended", message)
	task.delay(1, refreshLeaderboard)
	task.wait(CONFIG.RESULTS_TIME)

	local k = 0
	for t = 1, 2 do
		for _, p in ipairs(Match.Teams[t]) do
			if p.Parent then
				k += 1
				teleport(p, LOBBY_CF * CFrame.new(0, 0, (k - 2.5) * 3))
			end
		end
	end
	Match.Teams = { {}, {} }
	Match.Scores = { 0, 0 }
	Match.TimeLeft = CONFIG.MATCH_TIME
	resetBallCenter()
end

local function runMatch(teams)
	Match.Teams = teams
	Match.Scores = { 0, 0 }
	ballState.NoPickup = {}
	for t = 1, 2 do
		for k, p in ipairs(teams[t]) do
			teleport(p, TEAM_SPAWN[t][k] or TEAM_SPAWN[t][1])
		end
	end
	resetBallCenter()
	setState("Playing")
	notifyAll(string.format("🏀 بدأت المباراة (%d ضد %d): %s ضد %s!", #teams[1], #teams[2],
		namesOf(teams[1]), namesOf(teams[2])), COLORS.Gold)

	local endTime = os.clock() + CONFIG.MATCH_TIME
	while true do
		-- انسحاب فريق كامل
		local here1, here2 = #presentMembers(1) > 0, #presentMembers(2) > 0
		if not here1 or not here2 then
			finishMatch(here1 and 1 or (here2 and 2 or nil), "انسحب الفريق الخصم")
			return
		end

		local left = endTime - os.clock()
		Match.TimeLeft = math.max(0, math.ceil(left))

		if Match.State == "Overtime" and Match.Scores[1] ~= Match.Scores[2] then
			break
		end
		if left <= 0 then
			if Match.Scores[1] ~= Match.Scores[2] or Match.State == "Overtime" then
				break
			end
			setState("Overtime", "تعادل! أول سلة تفوز")
			notifyAll("⚡ تعادل! السلة الذهبية: أول من يسجّل يفوز", COLORS.Gold)
			endTime = os.clock() + CONFIG.OVERTIME_TIME
		end

		checkLiveBall()
		kickSpectatorsOffCourt()
		refresh()
		task.wait(0.1)
	end

	local winner = nil
	if Match.Scores[1] > Match.Scores[2] then
		winner = 1
	elseif Match.Scores[2] > Match.Scores[1] then
		winner = 2
	end
	finishMatch(winner)
end

-- الحلقة الرئيسية للعبة
task.spawn(function()
	while true do
		Match.TimeLeft = CONFIG.MATCH_TIME
		setState("Waiting")
		while not balancedSize() do
			validatePads()
			task.wait(0.25)
		end

		setState("Countdown")
		local ready = true
		for i = CONFIG.COUNTDOWN, 1, -1 do
			Match.TimeLeft = i
			refresh()
			for _ = 1, 4 do
				task.wait(0.25)
				validatePads()
				if not balancedSize() then
					ready = false
					break
				end
			end
			if not ready then
				break
			end
		end

		if ready then
			local teams = { padPlayers(1), padPlayers(2) }
			Match.Pads = {}
			Match.TimeLeft = CONFIG.MATCH_TIME
			runMatch(teams)
		else
			notifyAll("⏸️ توقف العد التنازلي: لازم الفريقين يكونون بنفس العدد", COLORS.Red)
		end
	end
end)

------------------------------------------------------------------
-- 🛒 الشراء والتجهيز
------------------------------------------------------------------
GetDataFn.OnServerInvoke = function(plr)
	local prof = waitForProfile(plr)
	if not prof then
		return nil
	end
	return { Profile = prof, Shop = SHOP }
end

local function equip(plr, category, id)
	local prof = profiles[plr]
	if category == "Balls" then
		prof.EquippedBall = id
		if ballState.Holder == plr then
			applyBallSkin(ball, id)
		end
	else
		prof.EquippedJersey = id
		applyJersey(plr)
	end
end

BuyFn.OnServerInvoke = function(plr, category, id)
	local prof = profiles[plr]
	local item = findItem(category, id)
	if not prof or not item then
		return { Success = false, Message = "غرض غير موجود" }
	end
	if prof[category][id] then
		return { Success = false, Message = "تملكه من قبل!", Profile = prof }
	end
	if prof.Coins < item.Price then
		return { Success = false, Message = "ما عندك عملات كافية 💰", Profile = prof }
	end
	prof.Coins -= item.Price
	prof[category][id] = true
	equip(plr, category, id)
	updateLeaderstats(plr)
	return { Success = true, Message = "✅ اشتريت " .. item.Name .. " وتم تجهيزه!", Profile = prof }
end

EquipFn.OnServerInvoke = function(plr, category, id)
	local prof = profiles[plr]
	local item = findItem(category, id)
	if not prof or not item or not prof[category][id] then
		return { Success = false, Message = "لازم تشتريه أول" }
	end
	equip(plr, category, id)
	return { Success = true, Message = "تم تجهيز " .. item.Name, Profile = prof }
end

------------------------------------------------------------------
-- 👤 دخول وخروج اللاعبين
------------------------------------------------------------------
local function onPlayerAdded(plr)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "عملات"
	coins.Parent = ls
	local wins = Instance.new("IntValue")
	wins.Name = "فوز"
	wins.Parent = ls
	ls.Parent = plr

	plr.CharacterAppearanceLoaded:Connect(function()
		applyJersey(plr)
	end)
	plr.CharacterAdded:Connect(function(char)
		if isMatchLive() and teamOf(plr) then
			task.wait(0.2)
			local cf = spawnFor(plr)
			if cf and char.Parent then
				char:PivotTo(cf)
			end
		end
	end)

	loadProfile(plr)
	if plr.Character then
		applyJersey(plr)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, plr in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, plr)
end

Players.PlayerRemoving:Connect(function(plr)
	if ballState.Holder == plr then
		releaseBall()
	end
	local padIdx = padIndexOf(plr)
	if padIdx then
		Match.Pads[padIdx] = nil
	end
	ballState.NoPickup[plr] = nil
	ballState.StealCooldown[plr] = nil
	saveProfile(plr)
	profiles[plr] = nil
end)

game:BindToClose(function()
	for _, plr in ipairs(Players:GetPlayers()) do
		saveProfile(plr)
	end
end)

-- حفظ تلقائي كل دقيقتين
task.spawn(function()
	while true do
		task.wait(120)
		for _, plr in ipairs(Players:GetPlayers()) do
			saveProfile(plr)
		end
	end
end)

refresh()
print("🏀 تم بناء ملعب كرة السلة والمتجر بنجاح!")
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX_SP">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX_SPS">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
    <Item class="LocalScript" referent="RBX_CLIENT">
        <Properties>
          <string name="Name">BasketballClient</string>
          <bool name="Disabled">false</bool>
          <ProtectedString name="Source"><![CDATA[--==================================================================
  -- 🏀 سكربت اللاعب: لوحة النتيجة + عداد الرمي + المتجر
  -- المكان: StarterPlayer > StarterPlayerScripts  (نوعه LocalScript)
  --
  -- التحكم:
  --   • كمبيوتر: اضغط مطولاً على زر الماوس الأيسر ثم أفلت للرمي، Q للتمرير، F للسرقة
  --   • جوال: أزرار "رمي" و "تمرير" و "سرقة" على الشاشة
  --   • يد تحكم: R2 للرمي، Y للتمرير، X للسرقة
  --==================================================================
  
  local Players = game:GetService("Players")
  local ReplicatedStorage = game:GetService("ReplicatedStorage")
  local UserInputService = game:GetService("UserInputService")
  local RunService = game:GetService("RunService")
  local TweenService = game:GetService("TweenService")
  local SoundService = game:GetService("SoundService")
  
  local player = Players.LocalPlayer
  local remotes = ReplicatedStorage:WaitForChild("Basketball")
  local ShootEvent = remotes:WaitForChild("Shoot")
  local StealEvent = remotes:WaitForChild("Steal")
  local PassEvent = remotes:WaitForChild("Pass")
  local NotifyEvent = remotes:WaitForChild("Notify")
  local OpenShopEvent = remotes:WaitForChild("OpenShop")
  local GetDataFn = remotes:WaitForChild("GetData")
  local BuyFn = remotes:WaitForChild("Buy")
  local EquipFn = remotes:WaitForChild("Equip")
  local ball = workspace:WaitForChild("GameBall")
  
  local PERFECT = remotes:GetAttribute("PerfectPower") or 0.85
  local WINDOW = remotes:GetAttribute("PerfectWindow") or 0.06
  
  local RED = Color3.fromRGB(230, 60, 60)
  local BLUE = Color3.fromRGB(60, 130, 240)
  local GOLD = Color3.fromRGB(240, 195, 60)
  local GREEN = Color3.fromRGB(70, 200, 90)
  local DARK = Color3.fromRGB(18, 18, 28)
  local WHITE = Color3.new(1, 1, 1)
  
  ------------------------------------------------------------------
  -- 🔊 أصوات الواجهة (تقدر تبدلها بـ "rbxassetid://الرقم" من Creator Store)
  ------------------------------------------------------------------
  local UI_SOUNDS = {
  	Beep = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Speed = 1 },   -- العد التنازلي
  	Buzzer = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 1, Speed = 0.45 }, -- بداية ونهاية المباراة
  	Buy = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.7, Speed = 1.6 },  -- شراء ناجح
  	Click = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.6, Speed = 1 },            -- أزرار المتجر
  }
  
  local soundObjects = {}
  for name, def in pairs(UI_SOUNDS) do
  	if def.Id ~= "" then
  		local s = Instance.new("Sound")
  		s.Name = "BasketballUI_" .. name
  		s.SoundId = def.Id
  		s.Volume = def.Volume
  		s.PlaybackSpeed = def.Speed
  		s.Parent = SoundService
  		soundObjects[name] = s
  	end
  end
  
  local function playUi(name)
  	local s = soundObjects[name]
  	if s then
  		s:Play()
  	end
  end
  
  ------------------------------------------------------------------
  -- أدوات بناء الواجهة
  ------------------------------------------------------------------
  local function make(className, props, children)
  	local inst = Instance.new(className)
  	for k, v in pairs(props or {}) do
  		if k ~= "Parent" then
  			inst[k] = v
  		end
  	end
  	for _, child in ipairs(children or {}) do
  		child.Parent = inst
  	end
  	if props and props.Parent then
  		inst.Parent = props.Parent
  	end
  	return inst
  end
  
  local function corner(radius)
  	return make("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
  end
  
  local function stroke(color, thickness)
  	return make("UIStroke", { Color = color or Color3.new(0, 0, 0), Thickness = thickness or 2,
  		ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
  end
  
  local function label(props, children)
  	local defaults = { BackgroundTransparency = 1, TextScaled = true, Font = Enum.Font.GothamBlack,
  		TextColor3 = WHITE, Text = "" }
  	for k, v in pairs(defaults) do
  		if props[k] == nil then
  			props[k] = v
  		end
  	end
  	return make("TextLabel", props, children)
  end
  
  local gui = make("ScreenGui", { Name = "BasketballUI", ResetOnSpawn = false,
  	ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })
  
  ------------------------------------------------------------------
  -- 📊 لوحة النتيجة أعلى الشاشة
  ------------------------------------------------------------------
  local top = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8),
  	Size = UDim2.fromOffset(440, 66), BackgroundColor3 = DARK, BackgroundTransparency = 0.15, Parent = gui },
  	{ corner(12), stroke(GOLD, 2) })
  
  local p1NameL = label({ Position = UDim2.fromOffset(10, 4), Size = UDim2.fromOffset(140, 20), TextColor3 = RED, Parent = top })
  local p1ScoreL = label({ Position = UDim2.fromOffset(10, 24), Size = UDim2.fromOffset(140, 38), TextColor3 = RED, Parent = top })
  local p2NameL = label({ Position = UDim2.new(1, -150, 0, 4), Size = UDim2.fromOffset(140, 20), TextColor3 = BLUE, Parent = top })
  local p2ScoreL = label({ Position = UDim2.new(1, -150, 0, 24), Size = UDim2.fromOffset(140, 38), TextColor3 = BLUE, Parent = top })
  local timeL = label({ Position = UDim2.new(0.5, -65, 0, 4), Size = UDim2.fromOffset(130, 34), TextColor3 = GOLD, Parent = top })
  local stateL = label({ Position = UDim2.new(0.5, -65, 0, 40), Size = UDim2.fromOffset(130, 20), Font = Enum.Font.GothamBold, Parent = top })
  
  -- رسالة كبيرة بالنص (العد التنازلي ونتيجة المباراة)
  local banner = label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.35),
  	Size = UDim2.fromOffset(620, 90), TextColor3 = GOLD, TextStrokeTransparency = 0.2, Visible = false, Parent = gui })
  
  -- العملات (أسفل اليسار)
  local coinsFrame = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -12),
  	Size = UDim2.fromOffset(130, 40), BackgroundColor3 = DARK, BackgroundTransparency = 0.15, Parent = gui },
  	{ corner(10), stroke(GOLD, 2) })
  local coinsL = label({ Size = UDim2.fromScale(1, 1), TextColor3 = GOLD, Text = "💰 0", Parent = coinsFrame },
  	{ make("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }) })
  
  ------------------------------------------------------------------
  -- 🔔 الإشعارات
  ------------------------------------------------------------------
  local toastHolder = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 82),
  	Size = UDim2.fromOffset(480, 220), BackgroundTransparency = 1, Parent = gui },
  	{ make("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center,
  		SortOrder = Enum.SortOrder.LayoutOrder }) })
  local toastCount = 0
  
  local function toast(text, color)
  	toastCount += 1
  	local labels = {}
  	for _, c in ipairs(toastHolder:GetChildren()) do
  		if c:IsA("TextLabel") then
  			table.insert(labels, c)
  		end
  	end
  	table.sort(labels, function(a, b)
  		return a.LayoutOrder < b.LayoutOrder
  	end)
  	if #labels >= 5 then
  		labels[1]:Destroy()
  	end
  	local l = make("TextLabel", { LayoutOrder = toastCount, Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = DARK,
  		BackgroundTransparency = 0.2, Text = text, TextColor3 = color or WHITE, Font = Enum.Font.GothamBold,
  		TextScaled = true, Parent = toastHolder },
  		{ corner(8), make("UITextSizeConstraint", { MaxTextSize = 20 }),
  			make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
  				PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }) })
  	task.delay(3.2, function()
  		if l.Parent then
  			local tween = TweenService:Create(l, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
  			tween:Play()
  			tween.Completed:Wait()
  			l:Destroy()
  		end
  	end)
  end
  
  NotifyEvent.OnClientEvent:Connect(function(text, color)
  	toast(text, color)
  end)
  
  ------------------------------------------------------------------
  -- 🔄 تحديث لوحة النتيجة
  ------------------------------------------------------------------
  local STATE_TEXT = {
  	Waiting = "بانتظار لاعبين",
  	Countdown = "استعداد...",
  	Playing = "المباراة جارية",
  	Overtime = "⚡ السلة الذهبية",
  	Ended = "انتهت المباراة",
  }
  
  local lastState, lastTime = nil, nil
  
  local function updateHud()
  	local state = remotes:GetAttribute("State") or "Waiting"
  	local t = remotes:GetAttribute("TimeLeft") or 0
  
  	-- أصوات العد التنازلي والصافرة
  	if state == "Countdown" and (t ~= lastTime or lastState ~= "Countdown") then
  		playUi("Beep")
  	end
  	if state ~= lastState and (state == "Playing" or state == "Overtime" or state == "Ended") then
  		playUi("Buzzer")
  	end
  	lastState, lastTime = state, t
  
  	p1NameL.Text = remotes:GetAttribute("P1Name") or "—"
  	p2NameL.Text = remotes:GetAttribute("P2Name") or "—"
  	p1ScoreL.Text = tostring(remotes:GetAttribute("Score1") or 0)
  	p2ScoreL.Text = tostring(remotes:GetAttribute("Score2") or 0)
  	timeL.Text = string.format("%d:%02d", t // 60, t % 60)
  	timeL.TextColor3 = (state == "Playing" and t <= 10) and RED or GOLD
  	local mode = remotes:GetAttribute("Mode") or ""
  	stateL.Text = (state == "Waiting" or mode == "") and (STATE_TEXT[state] or "") or ((STATE_TEXT[state] or "") .. " • " .. mode)
  
  	if state == "Countdown" then
  		banner.Text = tostring(t)
  		banner.Visible = true
  	elseif state == "Ended" then
  		banner.Text = remotes:GetAttribute("Message") or ""
  		banner.Visible = true
  	else
  		banner.Visible = false
  	end
  end
  
  remotes.AttributeChanged:Connect(updateHud)
  updateHud()
  
  task.spawn(function()
  	local leaderstats = player:WaitForChild("leaderstats")
  	local coins = leaderstats:WaitForChild("عملات")
  	local function update()
  		coinsL.Text = "💰 " .. coins.Value
  	end
  	coins.Changed:Connect(update)
  	update()
  end)
  
  ------------------------------------------------------------------
  -- 🎯 عداد قوة الرمي
  ------------------------------------------------------------------
  local powerFrame = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -110),
  	Size = UDim2.fromOffset(320, 28), BackgroundColor3 = DARK, BackgroundTransparency = 0.1, Visible = false,
  	Parent = gui }, { corner(8), stroke(WHITE, 2) })
  make("Frame", { Position = UDim2.fromScale(PERFECT - WINDOW, 0), Size = UDim2.fromScale(WINDOW * 2, 1),
  	BackgroundColor3 = GREEN, BorderSizePixel = 0, ZIndex = 1, Parent = powerFrame })
  local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = GOLD, BackgroundTransparency = 0.45,
  	BorderSizePixel = 0, ZIndex = 2, Parent = powerFrame })
  local marker = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.new(0, 4, 1, 0),
  	BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3, Parent = powerFrame })
  local powerHint = label({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -4),
  	Size = UDim2.fromOffset(420, 22), Font = Enum.Font.GothamBold, TextStrokeTransparency = 0.4, Parent = powerFrame })
  
  local charging = false
  local chargeStart = 0
  local shootTouch = nil
  
  local function isHolding()
  	return ball:GetAttribute("HolderId") == player.UserId
  end
  
  -- القوة تطلع وتنزل بين 0 و 1 طول ما أنت ضاغط
  local function currentPower()
  	local t = (os.clock() - chargeStart) % 1.8
  	local p = t / 0.9
  	if p > 1 then
  		p = 2 - p
  	end
  	return p
  end
  
  local function beginCharge()
  	if isHolding() and not charging then
  		charging = true
  		chargeStart = os.clock()
  	end
  end
  
  local function releaseCharge()
  	if not charging then
  		return
  	end
  	charging = false
  	if isHolding() then
  		ShootEvent:FireServer(currentPower())
  	end
  end
  
  RunService.RenderStepped:Connect(function()
  	local holding = isHolding()
  	powerFrame.Visible = holding
  	if not holding then
  		charging = false
  		return
  	end
  	local p = charging and currentPower() or 0
  	fill.Size = UDim2.fromScale(p, 1)
  	marker.Position = UDim2.fromScale(p, 0)
  
  	local hint = charging and "أفلت في المنطقة الخضراء! 🎯" or "اضغط مطوّلاً للرمي  •  Q تمرير"
  	local deadline = ball:GetAttribute("ShotDeadline") or 0
  	if deadline > 0 then
  		local remaining = math.max(0, math.ceil(deadline - workspace:GetServerTimeNow()))
  		hint = hint .. "   ⏱️ " .. remaining
  	end
  	powerHint.Text = hint
  end)
  
  ------------------------------------------------------------------
  -- 🎮 التحكم
  ------------------------------------------------------------------
  local function isShootInput(input)
  	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2
  end
  
  UserInputService.InputBegan:Connect(function(input, gameProcessed)
  	if gameProcessed then
  		return
  	end
  	if isShootInput(input) then
  		beginCharge()
  	elseif input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonX then
  		StealEvent:FireServer()
  	elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonY then
  		if isHolding() then
  			charging = false
  			PassEvent:FireServer()
  		end
  	end
  end)
  
  UserInputService.InputEnded:Connect(function(input)
  	if input == shootTouch then
  		shootTouch = nil
  		releaseCharge()
  	elseif isShootInput(input) then
  		releaseCharge()
  	end
  end)
  
  -- أزرار الجوال
  if UserInputService.TouchEnabled then
  	local shootBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -170),
  		Size = UDim2.fromOffset(90, 90), BackgroundColor3 = Color3.fromRGB(230, 110, 30), Text = "🏀\nرمي",
  		TextColor3 = WHITE, Font = Enum.Font.GothamBlack, TextScaled = true, AutoButtonColor = true, Parent = gui },
  		{ make("UICorner", { CornerRadius = UDim.new(0.5, 0) }), stroke(WHITE, 3) })
  	local stealBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -130, 1, -150),
  		Size = UDim2.fromOffset(70, 70), BackgroundColor3 = Color3.fromRGB(70, 70, 90), Text = "🥷\nسرقة",
  		TextColor3 = WHITE, Font = Enum.Font.GothamBlack, TextScaled = true, Parent = gui },
  		{ make("UICorner", { CornerRadius = UDim.new(0.5, 0) }), stroke(WHITE, 2) })
  
  	local passBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -270),
  		Size = UDim2.fromOffset(70, 70), BackgroundColor3 = Color3.fromRGB(40, 140, 90), Text = "🤝\nتمرير",
  		TextColor3 = WHITE, Font = Enum.Font.GothamBlack, TextScaled = true, Parent = gui },
  		{ make("UICorner", { CornerRadius = UDim.new(0.5, 0) }), stroke(WHITE, 2) })
  	passBtn.Activated:Connect(function()
  		if isHolding() then
  			charging = false
  			PassEvent:FireServer()
  		end
  	end)
  
  	shootBtn.InputBegan:Connect(function(input)
  		if input.UserInputType == Enum.UserInputType.Touch then
  			shootTouch = input
  			beginCharge()
  		end
  	end)
  	stealBtn.Activated:Connect(function()
  		StealEvent:FireServer()
  	end)
  end
  
  ------------------------------------------------------------------
  -- 🛒 واجهة المتجر
  ------------------------------------------------------------------
  local shop = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
  	Size = UDim2.fromScale(0.92, 0.85), BackgroundColor3 = DARK, Visible = false, ZIndex = 10, Parent = gui },
  	{ corner(16), stroke(GOLD, 3), make("UISizeConstraint", { MaxSize = Vector2.new(620, 440) }) })
  
  label({ Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -120, 0, 36), Text = "🛒 متجر السلة",
  	TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 11, Parent = shop })
  local shopCoinsL = label({ Position = UDim2.fromOffset(60, 14), Size = UDim2.fromOffset(140, 28), TextColor3 = GOLD,
  	TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11, Parent = shop })
  local closeBtn = make("TextButton", { Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(36, 36),
  	BackgroundColor3 = RED, Text = "✕", TextColor3 = WHITE, Font = Enum.Font.GothamBlack, TextScaled = true,
  	ZIndex = 11, Parent = shop }, { corner(8) })
  
  local tabs = {}
  local function makeTab(name, text, x)
  	tabs[name] = make("TextButton", { Position = UDim2.new(x, 8, 0, 56), Size = UDim2.new(0.5, -16, 0, 34),
  		BackgroundColor3 = Color3.fromRGB(50, 50, 70), Text = text, TextColor3 = WHITE, Font = Enum.Font.GothamBold,
  		TextScaled = true, ZIndex = 11, Parent = shop }, { corner(8),
  		make("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }) })
  end
  makeTab("Jerseys", "👕 القمصان", 0)
  makeTab("Balls", "🏀 الكرات", 0.5)
  
  local list = make("ScrollingFrame", { Position = UDim2.fromOffset(12, 100), Size = UDim2.new(1, -24, 1, -112),
  	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, CanvasSize = UDim2.new(),
  	AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 11, Parent = shop },
  	{ make("UIGridLayout", { CellSize = UDim2.fromOffset(180, 190), CellPadding = UDim2.fromOffset(10, 10),
  		HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }) })
  
  local currentTab = "Balls"
  local shopData = nil
  local busy = false
  local render -- (معرّفة تحت)
  
  local EFFECT_ICON = { fire = "🔥", sparkles = "✨" }
  
  local function onItemClicked(item, owned)
  	if busy then
  		return
  	end
  	busy = true
  	playUi("Click")
  	local ok, res = pcall(function()
  		if owned then
  			return EquipFn:InvokeServer(currentTab, item.Id)
  		end
  		return BuyFn:InvokeServer(currentTab, item.Id)
  	end)
  	busy = false
  	if ok and type(res) == "table" then
  		toast(res.Message or "", res.Success and GREEN or RED)
  		if res.Success and not owned then
  			playUi("Buy")
  		end
  		if res.Profile then
  			shopData.Profile = res.Profile
  		end
  		render()
  	else
  		toast("صار خطأ، حاول مرة ثانية", RED)
  	end
  end
  
  render = function()
  	for _, c in ipairs(list:GetChildren()) do
  		if c:IsA("Frame") then
  			c:Destroy()
  		end
  	end
  	if not shopData then
  		return
  	end
  	local profile = shopData.Profile
  	shopCoinsL.Text = "💰 " .. profile.Coins
  	for name, tab in pairs(tabs) do
  		tab.BackgroundColor3 = (name == currentTab) and GOLD or Color3.fromRGB(50, 50, 70)
  		tab.TextColor3 = (name == currentTab) and DARK or WHITE
  	end
  
  	local equippedId = (currentTab == "Balls") and profile.EquippedBall or profile.EquippedJersey
  	for i, item in ipairs(shopData.Shop[currentTab]) do
  		local owned = profile[currentTab][item.Id] == true
  		local equipped = equippedId == item.Id
  
  		local card = make("Frame", { LayoutOrder = i, BackgroundColor3 = Color3.fromRGB(35, 35, 50), ZIndex = 11,
  			Parent = list }, { corner(12), stroke(equipped and GREEN or Color3.fromRGB(70, 70, 90), 2) })
  
  		-- معاينة الغرض
  		if currentTab == "Balls" then
  			local preview = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12),
  				Size = UDim2.fromOffset(70, 70), BackgroundColor3 = item.Color, ZIndex = 12, Parent = card },
  				{ make("UICorner", { CornerRadius = UDim.new(0.5, 0) }), stroke(Color3.new(0, 0, 0), 2) })
  			label({ Size = UDim2.fromScale(1, 1), Text = EFFECT_ICON[item.Effect] or "", ZIndex = 13, Parent = preview })
  		else
  			local preview = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12),
  				Size = UDim2.fromOffset(62, 70), BackgroundColor3 = item.Color or Color3.fromRGB(90, 90, 100),
  				ZIndex = 12, Parent = card }, { corner(6), stroke(Color3.new(0, 0, 0), 2) })
  			label({ Size = UDim2.fromScale(1, 1), Text = item.Number or "👤", TextColor3 = item.TextColor or WHITE,
  				ZIndex = 13, Parent = preview }, { make("UIPadding", { PaddingTop = UDim.new(0, 12),
  				PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })
  		end
  
  		label({ Position = UDim2.new(0, 6, 0, 90), Size = UDim2.new(1, -12, 0, 24), Text = item.Name,
  			Font = Enum.Font.GothamBold, ZIndex = 12, Parent = card })
  		label({ Position = UDim2.new(0, 6, 0, 116), Size = UDim2.new(1, -12, 0, 20),
  			Text = item.Price == 0 and "مجاني" or (item.Price .. " 💰"), TextColor3 = GOLD,
  			Font = Enum.Font.GothamBold, ZIndex = 12, Parent = card })
  
  		local btnText, btnColor
  		if equipped then
  			btnText, btnColor = "✔ مُجهّز", Color3.fromRGB(60, 120, 70)
  		elseif owned then
  			btnText, btnColor = "تجهيز", BLUE
  		else
  			local canAfford = profile.Coins >= item.Price
  			btnText, btnColor = "شراء", canAfford and GREEN or Color3.fromRGB(110, 60, 60)
  		end
  		local btn = make("TextButton", { Position = UDim2.new(0, 10, 1, -44), Size = UDim2.new(1, -20, 0, 34),
  			BackgroundColor3 = btnColor, Text = btnText, TextColor3 = WHITE, Font = Enum.Font.GothamBlack,
  			TextScaled = true, AutoButtonColor = not equipped, ZIndex = 12, Parent = card },
  			{ corner(8), make("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }) })
  		if not equipped then
  			btn.Activated:Connect(function()
  				onItemClicked(item, owned)
  			end)
  		end
  	end
  end
  
  for name, tab in pairs(tabs) do
  	tab.Activated:Connect(function()
  		currentTab = name
  		playUi("Click")
  		render()
  	end)
  end
  
  closeBtn.Activated:Connect(function()
  	shop.Visible = false
  end)
  
  OpenShopEvent.OnClientEvent:Connect(function()
  	local ok, res = pcall(function()
  		return GetDataFn:InvokeServer()
  	end)
  	if not ok or type(res) ~= "table" then
  		toast("تعذّر فتح المتجر، حاول مرة ثانية", RED)
  		return
  	end
  	shopData = res
  	shop.Visible = true
  	render()
  end)
  ]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>
