      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Minimal pure-Luau signal used for communication between server/client modules.

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handler = { fn = fn, connected = true }
	table.insert(self._handlers, handler)
	local handlers = self._handlers
	return {
		Disconnect = function()
			handler.connected = false
			local i = table.find(handlers, handler)
			if i then
				table.remove(handlers, i)
			end
		end,
	}
end

function Signal:Fire(...)
	for _, handler in table.clone(self._handlers) do
		if handler.connected then
			task.spawn(handler.fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	local conn
	conn = self:Connect(function(...)
		conn.Disconnect()
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Sounds</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Sound library.
--
-- Out of the box every sound uses audio files that ship with the Roblox client
-- (rbxasset://sounds/...), shaped with pitch/volume/looping so the game is fully audible
-- without uploading anything. To make the game sound truly professional, replace the
-- `id` values with "rbxassetid://<id>" of horror audio you own or that is licensed for
-- use (Creator Store / your own uploads). Nothing else needs to change.

local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Sounds = {}

local FALL = "rbxasset://sounds/action_falling.mp3"
local SWIM = "rbxasset://sounds/action_swim.mp3"
local STEP = "rbxasset://sounds/action_footsteps_plastic.mp3"
local LAND = "rbxasset://sounds/action_jump_land.mp3"
local GETUP = "rbxasset://sounds/action_get_up.mp3"
local WATER = "rbxasset://sounds/impact_water.mp3"
local UHH = "rbxasset://sounds/uuhhh.mp3"
local PING = "rbxasset://sounds/electronicpingshort.wav"
local CLICK = "rbxasset://sounds/clickfast.wav"
local SLASH = "rbxasset://sounds/swordslash.wav"
local UNSHEATH = "rbxasset://sounds/unsheath.wav"

Sounds.Library = {
	-- Ambience / music (2D, played on the client)
	Wind = { id = FALL, volume = 0.35, pitch = 0.5, looped = true, group = "Ambience" },
	Rain = { id = SWIM, volume = 0.22, pitch = 0.55, looped = true, group = "Ambience" },
	Drone = { id = FALL, volume = 0.3, pitch = 0.16, looped = true, group = "Music" },
	ChaseLayer = { id = FALL, volume = 0, pitch = 0.3, looped = true, group = "Music" },
	Hum = { id = CLICK, volume = 0.08, pitch = 0.22, looped = true, group = "Ambience" },
	Heartbeat = { id = LAND, volume = 0.9, pitch = 0.42, group = "SFX" },
	-- 3D world sounds
	Footstep = { id = STEP, volume = 0.5, pitch = 0.75, group = "SFX", range = 60 },
	HeavyStep = { id = LAND, volume = 1.1, pitch = 0.32, group = "SFX", range = 90 },
	DoorOpen = { id = GETUP, volume = 0.7, pitch = 0.45, group = "SFX", range = 50 },
	DoorClose = { id = LAND, volume = 0.8, pitch = 0.6, group = "SFX", range = 50 },
	DoorSlam = { id = LAND, volume = 2, pitch = 0.3, group = "SFX", range = 160 },
	Creak = { id = GETUP, volume = 0.9, pitch = 0.28, group = "SFX", range = 60 },
	Locked = { id = CLICK, volume = 0.6, pitch = 0.55, group = "SFX", range = 30 },
	Unlock = { id = CLICK, volume = 0.7, pitch = 1.15, group = "SFX", range = 30 },
	Pickup = { id = PING, volume = 0.35, pitch = 1.5, group = "SFX", range = 20 },
	Paper = { id = SWIM, volume = 0.4, pitch = 2.4, group = "SFX", range = 15 },
	Ding = { id = PING, volume = 0.9, pitch = 0.8, group = "SFX", range = 80 },
	ElevatorRun = { id = FALL, volume = 0.6, pitch = 0.22, looped = true, group = "SFX", range = 40 },
	Whisper = { id = SWIM, volume = 0.45, pitch = 2.2, group = "SFX", range = 40 },
	Scream = { id = UHH, volume = 1.3, pitch = 0.5, group = "SFX", range = 200 },
	Growl = { id = UHH, volume = 1.1, pitch = 0.28, group = "SFX", range = 90 },
	Shriek = { id = UHH, volume = 1.2, pitch = 1.6, group = "SFX", range = 120 },
	Breathing = { id = FALL, volume = 0.7, pitch = 0.4, looped = true, group = "SFX", range = 45 },
	Static = { id = CLICK, volume = 0.35, pitch = 0.38, looped = true, group = "SFX", range = 30 },
	PhoneRing = { id = PING, volume = 1, pitch = 1.9, group = "SFX", range = 90 },
	Thunder = { id = WATER, volume = 2.2, pitch = 0.12, group = "Ambience" },
	Click = { id = CLICK, volume = 0.5, pitch = 1, group = "SFX", range = 20 },
	Hit = { id = SLASH, volume = 1.1, pitch = 0.45, group = "SFX", range = 50 },
	Lever = { id = UNSHEATH, volume = 0.9, pitch = 0.45, group = "SFX", range = 50 },
	Generator = { id = FALL, volume = 1.3, pitch = 0.13, looped = true, group = "SFX", range = 120 },
	GeneratorStart = { id = UNSHEATH, volume = 2, pitch = 0.25, group = "SFX", range = 220 },
	Crash = { id = WATER, volume = 1.4, pitch = 0.4, group = "SFX", range = 90 },
	Alarm = { id = PING, volume = 1.1, pitch = 0.55, group = "SFX", range = 300 },
	Heart = { id = LAND, volume = 1.5, pitch = 0.25, group = "SFX", range = 70 },
	UIClick = { id = CLICK, volume = 0.4, pitch = 1.3, group = "SFX" },
	UIHover = { id = CLICK, volume = 0.15, pitch = 2, group = "SFX" },
	Sting = { id = UHH, volume = 0.9, pitch = 0.22, group = "Music" },
}

function Sounds.Group(name: string): SoundGroup?
	local group = SoundService:FindFirstChild(name)
	if group and group:IsA("SoundGroup") then
		return group
	end
	return nil
end

-- Creates (but does not play) a configured Sound.
function Sounds.Make(name: string, parent: Instance?, overrides: { [string]: any }?): Sound?
	local def = Sounds.Library[name]
	if not def then
		warn("[Sounds] unknown sound", name)
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = def.id
	sound.Volume = def.volume or 0.5
	sound.PlaybackSpeed = def.pitch or 1
	sound.Looped = def.looped == true
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 6
	sound.RollOffMaxDistance = def.range or 80
	sound.SoundGroup = Sounds.Group(def.group or "SFX")
	if overrides then
		for key, value in overrides do
			sound[key] = value
		end
	end
	sound.Parent = parent or SoundService
	return sound
end

-- Plays a one-shot sound attached to `parent` (3D if parent is a BasePart/Attachment).
function Sounds.Play(name: string, parent: Instance?, overrides: { [string]: any }?): Sound?
	local sound = Sounds.Make(name, parent, overrides)
	if not sound then
		return nil
	end
	sound:Play()
	if not sound.Looped then
		Debris:AddItem(sound, 12)
	end
	return sound
end

-- Plays a one-shot sound at a world position.
function Sounds.PlayAt(name: string, position: Vector3, overrides: { [string]: any }?): Sound?
	local attachment = Instance.new("Attachment")
	attachment.Name = "SoundEmitter"
	attachment.WorldPosition = position
	attachment.Parent = workspace.Terrain
	Debris:AddItem(attachment, 12)
	return Sounds.Play(name, attachment, overrides)
end

return Sounds
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="15">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="16">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- THE FORGOTTEN HOTEL - server bootstrap.
-- Initialises collision groups, sound groups, remotes and every service, then builds the
-- hotel and opens the lobby.

local PhysicsService = game:GetService("PhysicsService")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Net = require(ReplicatedStorage.Shared.Net)

-- collision groups ------------------------------------------------------------------
for _, group in { "Monsters", "Doors", "Debris" } do
	if not PhysicsService:IsCollisionGroupRegistered(group) then
		PhysicsService:RegisterCollisionGroup(group)
	end
end
PhysicsService:CollisionGroupSetCollidable("Monsters", "Doors", false)
PhysicsService:CollisionGroupSetCollidable("Monsters", "Debris", false)
PhysicsService:CollisionGroupSetCollidable("Debris", "Doors", false)

-- sound groups (volumes are adjusted per player on the client) ------------------------
for _, name in { "SFX", "Music", "Ambience" } do
	if not SoundService:FindFirstChild(name) then
		local group = Instance.new("SoundGroup")
		group.Name = name
		group.Volume = 1
		group.Parent = SoundService
	end
end
SoundService.RespectFilteringEnabled = true

Players.CharacterAutoLoads = true

-- remotes ---------------------------------------------------------------------------
Net.Event("Notify") -- creates the Remotes folder with every RemoteEvent

-- services --------------------------------------------------------------------------
local Services = script.Parent.Services
local Power = require(Services.Power)
local Data = require(Services.Data)
local Survival = require(Services.Survival)
local Hiding = require(Services.Hiding)
local Puzzles = require(Services.Puzzles)
local Elevator = require(Services.Elevator)
local Missions = require(Services.Missions)
local Events = require(Services.Events)
local Session = require(Services.Session)
local Run = require(Services.Run)
local Monsters = require(script.Parent.Monsters.Monsters)

Power.Init()
Survival.Init()
Hiding.Init()
Puzzles.Init()
Elevator.Init()
Missions.Init()
Monsters.Init()
Events.Init()
Session.Init()

local started = os.clock()
Session.BuildWorld()
print(string.format("[ForgottenHotel] hotel built in %.2fs (%d parts)", os.clock() - started, #workspace.Hotel:GetDescendants()))

Data.Init(Survival.ApplySkin)
Run.SetState("Lobby")
Session.Broadcast()
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Map</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Low-level geometry helpers used by the procedural hotel builder.
-- All geometry is axis aligned and anchored. Decorative parts are made non-collidable
-- and non-touchable so physics, pathfinding and raycasts stay cheap.

local CollectionService = game:GetService("CollectionService")

local Build = {}

local Smooth = Enum.SurfaceType.Smooth

-- Generic part constructor.
-- opts: shape, transparency, collide(false), reflect, shadow(false), name, class, decor(true)
function Build.P(parent: Instance, size: Vector3, cf: CFrame, color: Color3?, material: Enum.Material?, opts: { [string]: any }?): BasePart
	local part: BasePart
	if opts and opts.class then
		part = Instance.new(opts.class)
	else
		part = Instance.new("Part")
	end
	part.Anchored = true
	part.Size = size
	part.CFrame = cf
	part.Color = color or Color3.new(0.5, 0.5, 0.5)
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Smooth
	part.BottomSurface = Smooth
	if opts then
		if opts.shape then
			(part :: Part).Shape = opts.shape
		end
		if opts.transparency then
			part.Transparency = opts.transparency
		end
		if opts.collide == false or opts.decor then
			part.CanCollide = false
		end
		if opts.decor then
			part.CanTouch = false
			part.CanQuery = false
		end
		if opts.reflect then
			part.Reflectance = opts.reflect
		end
		if opts.shadow == false then
			part.CastShadow = false
		end
		if opts.name then
			part.Name = opts.name
		end
	end
	part.Parent = parent
	return part
end

-- Decorative (non-colliding) part shorthand.
function Build.D(parent, size, cf, color, material, opts)
	opts = opts or {}
	opts.decor = true
	return Build.P(parent, size, cf, color, material, opts)
end

-- Vertical cylinder centred at `pos` (height along Y).
function Build.Cyl(parent, diameter: number, height: number, pos: Vector3 | CFrame, color, material, opts)
	opts = opts or {}
	opts.shape = Enum.PartType.Cylinder
	local base = typeof(pos) == "CFrame" and pos or CFrame.new(pos)
	return Build.P(parent, Vector3.new(height, diameter, diameter), base * CFrame.Angles(0, 0, math.rad(90)), color, material, opts)
end

function Build.Ball(parent, diameter: number, pos: Vector3, color, material, opts)
	opts = opts or {}
	opts.shape = Enum.PartType.Ball
	return Build.P(parent, Vector3.new(diameter, diameter, diameter), CFrame.new(pos), color, material, opts)
end

function Build.Model(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

function Build.Folder(parent: Instance, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local DIRS = {
	N = Vector3.new(0, 0, 1),
	S = Vector3.new(0, 0, -1),
	E = Vector3.new(1, 0, 0),
	W = Vector3.new(-1, 0, 0),
}
Build.Dirs = DIRS

-- CFrame at (x,y,z) whose LookVector (the prop's "front") points toward compass direction.
function Build.At(x: number, y: number, z: number, facing: string?): CFrame
	local pos = Vector3.new(x, y, z)
	return CFrame.lookAt(pos, pos + DIRS[facing or "S"])
end

-- Axis-aligned wall from (x1,z1) to (x2,z2) starting at height y.
-- openings: { {c = centre along the wall axis, w = width, h = height, b = bottom (default 0), fill = fn?} }
-- style: { color, material, thickness, trim (Color3 for baseboards), name }
function Build.Wall(parent: Instance, x1: number, z1: number, x2: number, z2: number, y: number, h: number, style, openings)
	openings = openings or {}
	local alongX = math.abs(z1 - z2) < 0.01
	local s0 = alongX and math.min(x1, x2) or math.min(z1, z2)
	local s1 = alongX and math.max(x1, x2) or math.max(z1, z2)
	local fixed = alongX and z1 or x1
	local t = style.thickness or 0.8
	local parts = {}

	local function seg(a: number, b: number, bottom: number, top: number)
		if b - a < 0.05 or top - bottom < 0.05 then
			return
		end
		local len = b - a
		local mid = (a + b) / 2
		local cy = y + (bottom + top) / 2
		local size = alongX and Vector3.new(len, top - bottom, t) or Vector3.new(t, top - bottom, len)
		local pos = alongX and Vector3.new(mid, cy, fixed) or Vector3.new(fixed, cy, mid)
		local part = Build.P(parent, size, CFrame.new(pos), style.color, style.material, { name = style.name or "Wall" })
		table.insert(parts, part)
	end

	local function trim(a: number, b: number)
		if not style.trim or b - a < 0.3 then
			return
		end
		local len = b - a
		local mid = (a + b) / 2
		for _, side in { -1, 1 } do
			local off = side * (t / 2 + 0.1)
			local size = alongX and Vector3.new(len, 0.9, 0.2) or Vector3.new(0.2, 0.9, len)
			local pos = alongX and Vector3.new(mid, y + 0.45, fixed + off) or Vector3.new(fixed + off, y + 0.45, mid)
			Build.D(parent, size, CFrame.new(pos), style.trim, Enum.Material.Wood)
		end
	end

	table.sort(openings, function(a, b)
		return a.c < b.c
	end)
	local cursor = s0
	local trimCursor = s0
	for _, o in openings do
		local oa, ob = o.c - o.w / 2, o.c + o.w / 2
		local bottom = o.b or 0
		seg(cursor, oa, 0, h)
		seg(oa, ob, 0, bottom)
		seg(oa, ob, bottom + o.h, h)
		if bottom <= 0.01 then
			trim(trimCursor, oa)
			trimCursor = ob
		end
		cursor = ob
	end
	seg(cursor, s1, 0, h)
	trim(trimCursor, s1)
	return parts
end

-- Splits rectangle (x1,z1,x2,z2) minus rectangular holes into parts at height range.
function Build.Slab(parent: Instance, rect, holes, yTop: number, thickness: number, color: Color3, material: Enum.Material, opts)
	holes = holes or {}
	local xs, zs = { rect[1], rect[3] }, { rect[2], rect[4] }
	for _, hole in holes do
		for _, v in { hole[1], hole[3] } do
			if v > rect[1] and v < rect[3] then
				table.insert(xs, v)
			end
		end
		for _, v in { hole[2], hole[4] } do
			if v > rect[2] and v < rect[4] then
				table.insert(zs, v)
			end
		end
	end
	table.sort(xs)
	table.sort(zs)
	local function solid(cx, cz)
		for _, hole in holes do
			if cx > hole[1] and cx < hole[3] and cz > hole[2] and cz < hole[4] then
				return false
			end
		end
		return true
	end
	local parts = {}
	for j = 1, #zs - 1 do
		local za, zb = zs[j], zs[j + 1]
		if zb - za > 0.01 then
			local runStart = nil
			for i = 1, #xs do
				local isSolid = false
				if i < #xs and xs[i + 1] - xs[i] > 0.01 then
					isSolid = solid((xs[i] + xs[i + 1]) / 2, (za + zb) / 2)
				end
				if isSolid and not runStart then
					runStart = xs[i]
				elseif not isSolid and runStart then
					local xa, xb = runStart, xs[i]
					local part = Build.P(
						parent,
						Vector3.new(xb - xa, thickness, zb - za),
						CFrame.new((xa + xb) / 2, yTop - thickness / 2, (za + zb) / 2),
						color,
						material,
						opts
					)
					table.insert(parts, part)
					runStart = nil
				end
			end
		end
	end
	return parts
end

-- Floor finish (carpet, marble...) for a room rectangle.
function Build.Floor(parent, x1, z1, x2, z2, y, color, material)
	return Build.P(parent, Vector3.new(x2 - x1, 0.2, z2 - z1), CFrame.new((x1 + x2) / 2, y - 0.1, (z1 + z2) / 2), color, material, { name = "Floor" })
end

-- Text on the front face of a thin part. Used for signs, plaques, wall writing.
function Build.Text(parent, size: Vector3, cf: CFrame, text: string, opts)
	opts = opts or {}
	local part = Build.D(parent, size, cf, opts.bg or Color3.new(0, 0, 0), opts.material or Enum.Material.SmoothPlastic, {
		transparency = opts.bgTransparency or 0,
		name = opts.name or "Sign",
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.ppu or 40
	gui.LightInfluence = opts.lightInfluence or 1
	gui.Brightness = opts.brightness or 1
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextScaled = true
	label.Font = opts.font or Enum.Font.Bodoni
	label.TextColor3 = opts.color or Color3.fromRGB(178, 142, 74)
	label.TextTransparency = opts.textTransparency or 0
	label.Rotation = opts.rotation or 0
	label.Parent = gui
	return part, label
end

-- Light helpers. Every powered hotel light is tagged so the Power service can control it.
function Build.Light(parent: Instance, kind: string, props, zone: string?, powered: boolean?)
	local light = Instance.new(kind)
	for key, value in props do
		light[key] = value
	end
	light.Parent = parent
	if zone and powered ~= false then
		light:SetAttribute("Zone", zone)
		light:SetAttribute("BaseBrightness", light.Brightness)
		CollectionService:AddTag(light, "HotelLight")
	end
	return light
end

-- Deterministic random generator so the hotel looks identical every build.
function Build.Rng(seed: number)
	return Random.new(seed)
end

function Build.Tag(instance: Instance, tag: string)
	CollectionService:AddTag(instance, tag)
	return instance
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Hotel</string>
            <string name="Source"><![CDATA[--!nonstrict
-- THE GRAND AURELIA HOTEL - procedural, deterministic map builder.
--
-- Footprint X[-60,60] Z[-50,50], entrance on the south (Z = -50).
-- Levels: Basement -14, Ground 0, First 16, Second 32, Third 48, Roof 64.
-- Every room is furnished; interactive objects are registered with the services here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)

local Build = require(script.Parent.Build)
local Props = require(script.Parent.Props)

local Services = script.Parent.Parent.Services
local Run = require(Services.Run)
local Doors = require(Services.Doors)
local Pickups = require(Services.Pickups)
local Hiding = require(Services.Hiding)
local Puzzles = require(Services.Puzzles)
local Elevator = require(Services.Elevator)
local Interact = require(Services.Interact)

local Hotel = {}
Hotel.Refs = {}

local C = Config.Palette
local M = Enum.Material
local Y = Config.Floors
local V = Vector3.new
local At = Build.At
local P, D = Build.P, Build.D

local FACADE = Color3.fromRGB(72, 64, 58)
local STYLE = {
	G = { color = Color3.fromRGB(58, 30, 32), material = M.Marble, trim = C.DarkBrown },
	F1 = { color = Color3.fromRGB(84, 38, 42), material = M.Fabric, trim = C.Walnut },
	F2 = { color = Color3.fromRGB(74, 48, 34), material = M.Wood, trim = C.Gold },
	F3 = { color = Color3.fromRGB(78, 80, 86), material = M.Plaster, trim = Color3.fromRGB(60, 56, 52) },
	B = { color = Color3.fromRGB(70, 70, 72), material = M.Concrete },
}
local RIGHT = -math.pi / 2

local function door(c: number, w: number?, h: number?)
	return { c = c, w = w or 4.5, h = h or 9 }
end

local function wall(parent, floor: string, x1, z1, x2, z2, openings, style)
	return Build.Wall(parent, x1, z1, x2, z2, Y[floor], floor == "B" and 13 or 15, style or STYLE[floor], openings)
end

local function finish(parent, rect, floor: string, color: Color3, material: Enum.Material, holes)
	return Build.Slab(parent, rect, holes, Y[floor], 0.2, color, material, { name = "Floor" })
end

local function wp(floor: string, x: number, z: number)
	Run.AddWaypoint(floor, V(x, Y[floor], z))
end

local function concierge(floor: string, x: number, z: number, facing: string)
	table.insert(Run.ConciergeSpots, { cf = At(x, Y[floor], z, facing), floor = floor })
end

local function roomSign(parent, cf: CFrame, text: string)
	D(parent, Vector3.new(1.8, 1, 0.12), cf * CFrame.new(0, 0, -0.04), C.DimGold, M.Metal)
	Build.Text(parent, Vector3.new(1.6, 0.8, 0.05), cf * CFrame.new(0, 0, -0.12), text, { bg = C.Black, color = C.Gold, font = Enum.Font.Bodoni })
end

----------------------------------------------------------------------------------------
-- Shell: slabs, exterior walls, windows, cornices
----------------------------------------------------------------------------------------

local function exteriorWindows(parent, floor: string, windows, opts)
	opts = opts or {}
	local y = Y[floor]
	local h = 15
	local style = STYLE[floor]
	local inner = { color = style.color, material = style.material, thickness = 0.6, trim = style.trim }
	local outer = { color = floor == "G" and Color3.fromRGB(48, 44, 42) or FACADE, material = floor == "G" and M.Granite or M.Limestone, thickness = 0.6 }
	local outerBase = floor == "G" and 0 or -1
	local sides = {
		S = { -60.6, -49.7, 60.6, -49.7, -60.6, -50.3, 60.6, -50.3 },
		N = { -60.6, 49.7, 60.6, 49.7, -60.6, 50.3, 60.6, 50.3 },
		E = { 59.7, -50, 59.7, 50, 60.3, -50.6, 60.3, 50.6 },
		W = { -59.7, -50, -59.7, 50, -60.3, -50.6, -60.3, 50.6 },
	}
	for side, coords in sides do
		local list = windows[side] or {}
		local ops, opsOuter = {}, {}
		for _, w in list do
			local b = w.b or 0
			table.insert(ops, { c = w.c, w = w.w, h = w.h, b = b })
			if b == 0 then
				table.insert(opsOuter, { c = w.c, w = w.w, h = w.h - outerBase, b = 0 })
			else
				table.insert(opsOuter, { c = w.c, w = w.w, h = w.h, b = b - outerBase })
			end
		end
		Build.Wall(parent, coords[1], coords[2], coords[3], coords[4], y, h, inner, ops)
		Build.Wall(parent, coords[5], coords[6], coords[7], coords[8], y + outerBase, h - outerBase, outer, opsOuter)
		for _, w in list do
			if not w.door then
				local cy = y + (w.b or 0) + w.h / 2
				local cf
				if side == "S" then
					cf = At(w.c, cy, -49.4, "N")
				elseif side == "N" then
					cf = At(w.c, cy, 49.4, "S")
				elseif side == "E" then
					cf = At(59.4, cy, w.c, "W")
				else
					cf = At(-59.4, cy, w.c, "E")
				end
				Props.Window(parent, cf, w.w, w.h, {
					broken = w.broken or opts.broken,
					curtains = opts.curtains ~= false,
					curtain = opts.curtain,
				})
				-- exterior sill + lintel
				D(parent, Vector3.new(w.w + 1, 0.4, 0.8), cf * CFrame.new(0, -w.h / 2 - 0.2, 1.3), Color3.fromRGB(90, 82, 74), M.Limestone)
				D(parent, Vector3.new(w.w + 1.4, 0.8, 0.7), cf * CFrame.new(0, w.h / 2 + 0.4, 1.25), Color3.fromRGB(90, 82, 74), M.Limestone)
			end
		end
	end
	-- cornice band below each floor
	if floor ~= "G" then
		for _, spec in {
			{ Vector3.new(122.6, 0.8, 1.2), V(0, y - 0.6, -50.9) },
			{ Vector3.new(122.6, 0.8, 1.2), V(0, y - 0.6, 50.9) },
			{ Vector3.new(1.2, 0.8, 102.6), V(60.9, y - 0.6, 0) },
			{ Vector3.new(1.2, 0.8, 102.6), V(-60.9, y - 0.6, 0) },
		} do
			D(parent, spec[1], CFrame.new(spec[2]), Color3.fromRGB(96, 86, 74), M.Limestone)
		end
	end
end

local function slabs(parent)
	local footprint = { -60.6, -50.6, 60.6, 50.6 }
	-- ground slab (basement ceiling) with the basement stairwell opening
	Build.Slab(parent, footprint, { { 26, -50, 60, -40 } }, Y.G - 0.2, 0.8, Color3.fromRGB(60, 60, 62), M.Concrete, { name = "Slab" })
	Build.Slab(parent, footprint, nil, Y.F1 - 0.2, 0.8, Color3.fromRGB(94, 84, 74), M.Plaster, { name = "Slab" })
	Build.Slab(parent, footprint, { { -59, 45, -55, 49 } }, Y.F2 - 0.2, 0.8, Color3.fromRGB(80, 76, 70), M.Plaster, { name = "Slab" })
	Build.Slab(parent, footprint, nil, Y.F3 - 0.2, 0.8, Color3.fromRGB(46, 34, 26), M.Wood, { name = "Slab" })
	Build.Slab(parent, footprint, nil, 64, 1, Color3.fromRGB(64, 66, 70), M.Plaster, { name = "Roof" })
	-- basement floor + escape tunnel floor
	Build.Slab(parent, { -60.6, -50.6, 60.6, 50.6 }, nil, Y.B, 1, Color3.fromRGB(54, 54, 56), M.Concrete, { name = "Floor" })
	Build.Slab(parent, { -101, -35, -60.6, -25 }, nil, Y.B, 1, Color3.fromRGB(50, 50, 52), M.Concrete, { name = "Floor" })
end

----------------------------------------------------------------------------------------
-- Exterior: courtyard, fountain, lamps, trees, fence, rain, roof sign
----------------------------------------------------------------------------------------

local function rainEmitter(parent, pos: Vector3, size: Vector3, rate: number)
	local box = D(parent, size, CFrame.new(pos), Color3.new(), M.SmoothPlastic, { transparency = 1, name = "RainCloud" })
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(170, 185, 210))
	e.LightEmission = 0.15
	e.LightInfluence = 0.6
	e.Transparency = NumberSequence.new(0.45)
	e.Size = NumberSequence.new(0.09)
	e.Squash = NumberSequence.new(3.5)
	e.Orientation = Enum.ParticleOrientation.VelocityParallel
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Shape = Enum.ParticleEmitterShape.Box
	e.Speed = NumberRange.new(95, 110)
	e.Lifetime = NumberRange.new(0.9, 1)
	e.Rate = rate
	e.Acceleration = Vector3.new(4, 0, 2)
	e.Parent = box
	Build.Tag(e, "Rain")
end

local function lampPost(parent, x: number, z: number, faulty: boolean)
	local m = Build.Model(parent, "LampPost")
	Build.Cyl(m, 0.5, 11, V(x, 5.5, z), C.Black, M.Metal)
	Build.Cyl(m, 1.2, 0.6, V(x, 0.3, z), C.Black, M.Metal)
	D(m, Vector3.new(1.6, 0.3, 1.6), CFrame.new(x, 11, z), C.Black, M.Metal)
	local glass = D(m, Vector3.new(1.2, 1.6, 1.2), CFrame.new(x, 12, z), Color3.fromRGB(255, 220, 160), M.Neon, { name = "Bulb", transparency = 0.15 })
	D(m, Vector3.new(1.8, 0.4, 1.8), CFrame.new(x, 13, z), C.Black, M.Metal)
	local light = Build.Light(glass, "PointLight", { Range = 26, Brightness = 1.3, Color = Color3.fromRGB(255, 205, 140), Shadows = true }, "Ext")
	if faulty then
		light:SetAttribute("Faulty", true)
	end
end

local function deadTree(parent, x: number, z: number, seed: number)
	local m = Build.Model(parent, "DeadTree")
	local rng = Build.Rng(seed)
	local h = rng:NextNumber(14, 20)
	local bark = Color3.fromRGB(38, 32, 28)
	P(m, Vector3.new(1.4, h, 1.4), CFrame.new(x, h / 2, z) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.06, 0.06)), bark, M.Wood)
	for i = 1, 7 do
		local y = h * rng:NextNumber(0.45, 0.95)
		local len = rng:NextNumber(4, 8)
		local a = rng:NextNumber(0, math.pi * 2)
		local branch = CFrame.new(x, y, z) * CFrame.Angles(0, a, 0) * CFrame.Angles(rng:NextNumber(0.5, 1.1), 0, 0) * CFrame.new(0, len / 2, 0)
		D(m, Vector3.new(0.5, len, 0.5), branch, bark, M.Wood)
		if i % 2 == 0 then
			D(m, Vector3.new(0.25, len * 0.6, 0.25), branch * CFrame.new(0, len / 2, 0) * CFrame.Angles(0.6, 0, 0) * CFrame.new(0, len * 0.3, 0), bark, M.Wood)
		end
	end
end

local function exterior(parent)
	local ext = Build.Folder(parent, "Exterior")
	-- ground with a hole for the hotel footprint
	Build.Slab(ext, { -170, -175, 170, 150 }, { { -60.6, -50.6, 60.6, 50.6 } }, 0, 2, Color3.fromRGB(34, 36, 30), M.Ground, { name = "Ground" })
	-- driveway + forecourt
	D(ext, Vector3.new(16, 0.1, 64), CFrame.new(0, 0.05, -82), Color3.fromRGB(40, 40, 42), M.Asphalt)
	D(ext, Vector3.new(60, 0.1, 10), CFrame.new(0, 0.06, -55.6), Color3.fromRGB(64, 60, 56), M.Cobblestone)
	for _, x in { -9, 9 } do
		D(ext, Vector3.new(1, 0.4, 64), CFrame.new(x, 0.2, -82), Color3.fromRGB(80, 76, 70), M.Concrete)
	end
	-- entrance canopy
	P(ext, Vector3.new(18, 1, 9), CFrame.new(0, 12, -55), C.DeepBurgundy, M.Fabric)
	D(ext, Vector3.new(18.4, 0.4, 9.4), CFrame.new(0, 11.4, -55), C.Gold, M.Metal)
	for _, x in { -8, 8 } do
		Build.Cyl(ext, 0.8, 11.5, V(x, 5.75, -59), C.Gold, M.Metal)
	end
	Props.Sconce(ext, At(-6.5, 8, -50.7, "S"), "Ext", { brightness = 1.2, range = 16 })
	Props.Sconce(ext, At(6.5, 8, -50.7, "S"), "Ext", { brightness = 1.2, range = 16 })
	-- facade lettering above the canopy (some letters dead)
	local _, sign = Build.Text(ext, Vector3.new(30, 3.5, 0.2), At(0, 20, -50.95, "S"), "غراند أوريليا", {
		bgTransparency = 1,
		color = Color3.fromRGB(255, 205, 130),
		font = Enum.Font.Bodoni,
		lightInfluence = 0,
		brightness = 1.6,
	})
	Hotel.Refs.FacadeSign = sign
	Build.Text(ext, Vector3.new(10, 1.6, 0.2), At(0, 17.6, -50.95, "S"), "ف  ن  د  ق", {
		bgTransparency = 1,
		color = Color3.fromRGB(200, 170, 120),
		font = Enum.Font.Bodoni,
		lightInfluence = 0.5,
	})
	-- roof sign frame + letters
	for _, x in { -24, 24 } do
		D(ext, Vector3.new(0.6, 10, 0.6), CFrame.new(x, 69, -44), C.Rust, M.CorrodedMetal)
	end
	D(ext, Vector3.new(50, 0.6, 0.6), CFrame.new(0, 66, -44), C.Rust, M.CorrodedMetal)
	Build.Text(ext, Vector3.new(46, 6, 0.3), At(0, 70, -44.3, "S"), "فندق غراند أوريليا", {
		bgTransparency = 1,
		color = Color3.fromRGB(150, 40, 36),
		font = Enum.Font.Bodoni,
		lightInfluence = 0.3,
		brightness = 1,
	})
	-- roof parapet + water tank
	for _, spec in {
		{ Vector3.new(122, 3, 1), V(0, 65.5, -50.1) },
		{ Vector3.new(122, 3, 1), V(0, 65.5, 50.1) },
		{ Vector3.new(1, 3, 100), V(60.1, 65.5, 0) },
		{ Vector3.new(1, 3, 100), V(-60.1, 65.5, 0) },
	} do
		P(ext, spec[1], CFrame.new(spec[2]), FACADE, M.Limestone)
	end
	Build.Cyl(ext, 10, 9, V(-35, 70.5, 30), C.Rust, M.CorrodedMetal)
	for _, x in { -39, -31 } do
		for _, z in { 26, 34 } do
			D(ext, Vector3.new(0.6, 6, 0.6), CFrame.new(x, 67, z), C.Charcoal, M.Metal)
		end
	end
	-- fountain
	local fountain = Build.Model(ext, "Fountain")
	Build.Cyl(fountain, 18, 2, V(0, 1, -85), Color3.fromRGB(90, 86, 80), M.Limestone)
	Build.Cyl(fountain, 16, 0.3, V(0, 1.9, -85), Color3.fromRGB(20, 26, 28), M.Glass, { decor = true, transparency = 0.2, reflect = 0.2 })
	Build.Cyl(fountain, 3, 6, V(0, 3, -85), Color3.fromRGB(90, 86, 80), M.Limestone)
	Build.Cyl(fountain, 7, 0.8, V(0, 6, -85), Color3.fromRGB(90, 86, 80), M.Limestone)
	local statue = Color3.fromRGB(110, 110, 104)
	P(fountain, Vector3.new(1.4, 3, 1), CFrame.new(0, 8, -85), statue, M.Marble)
	Build.Ball(fountain, 1.1, V(0, 10.1, -85), statue, M.Marble)
	for _, sx in { -1, 1 } do
		D(fountain, Vector3.new(3, 2.4, 0.2), CFrame.new(sx * 1.6, 8.8, -84.4) * CFrame.Angles(0, sx * 0.5, sx * 0.5), statue, M.Marble)
	end
	D(fountain, Vector3.new(0.6, 0.8, 0.6), CFrame.new(1.2, 2.3, -79), statue, M.Marble) -- broken-off hand in the basin
	-- lamps, trees, car, benches
	for i, z in { -62, -78, -94, -110 } do
		lampPost(ext, -11, z, i == 2)
		lampPost(ext, 11, z, i == 3)
	end
	for i, pos in { V(-35, 0, -70), V(-48, 0, -100), V(36, 0, -76), V(52, 0, -105), V(-75, 0, -30), V(78, 0, 10), V(-80, 0, 40) } do
		deadTree(ext, pos.X, pos.Z, i * 13)
	end
	local car = Build.Model(ext, "OldCar")
	local carCf = CFrame.new(-28, 0, -98) * CFrame.Angles(0, math.rad(20), 0)
	P(car, Vector3.new(6, 2.4, 14), carCf * CFrame.new(0, 2, 0), Color3.fromRGB(52, 20, 22), M.Metal)
	P(car, Vector3.new(5.6, 2, 7), carCf * CFrame.new(0, 4, 1), Color3.fromRGB(52, 20, 22), M.Metal)
	D(car, Vector3.new(5.4, 1.6, 0.2), carCf * CFrame.new(0, 4.1, -2.5), Color3.fromRGB(40, 50, 60), M.Glass, { transparency = 0.4 })
	for _, sx in { -3, 3 } do
		for _, sz in { -4.5, 4.5 } do
			Build.Cyl(car, 2.4, 0.9, carCf * CFrame.new(sx, 1.2, sz) * CFrame.Angles(0, 0, math.rad(90)), C.Black, M.Rubber, { decor = true })
		end
	end
	-- hedges + iron fence
	for _, spec in { { -60, -88 }, { 60, -88 } } do
		P(ext, Vector3.new(66, 6, 4), CFrame.new(spec[1] * 1.08, 3, spec[2] + 30) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(22, 34, 22), M.LeafyGrass)
	end
	for x = -98, 98, 4 do
		if math.abs(x) > 8 then
			D(ext, Vector3.new(0.3, 9, 0.3), CFrame.new(x, 4.5, -125), C.Black, M.Metal)
			D(ext, Vector3.new(0.5, 0.8, 0.5), CFrame.new(x, 9.2, -125), C.Black, M.Metal)
		end
	end
	for _, spec in { { -53, 2 }, { 53, 2 } } do
		D(ext, Vector3.new(90, 0.4, 0.3), CFrame.new(spec[1], 8, -125), C.Black, M.Metal)
		D(ext, Vector3.new(90, 0.4, 0.3), CFrame.new(spec[1], 1.5, -125), C.Black, M.Metal)
	end
	for _, x in { -7, 7 } do
		P(ext, Vector3.new(2.5, 12, 2.5), CFrame.new(x, 6, -125), Color3.fromRGB(70, 66, 60), M.Limestone)
		Build.Ball(ext, 1.6, V(x, 12.8, -125), Color3.fromRGB(70, 66, 60), M.Limestone)
	end
	-- the gate stands open (the hotel wants guests)
	for i, sx in { -1, 1 } do
		local hinge = CFrame.new(sx * 6, 0, -125) * CFrame.Angles(0, sx * math.rad(-75), 0)
		for b = 0, 5 do
			D(ext, Vector3.new(0.25, 10, 0.25), hinge * CFrame.new(-sx * (0.5 + b), 5, 0), C.Black, M.Metal)
		end
		D(ext, Vector3.new(6, 0.4, 0.3), hinge * CFrame.new(-sx * 3, 9.2, 0), C.Black, M.Metal, { name = "Gate" .. i })
	end
	-- invisible world boundary
	for _, spec in {
		{ Vector3.new(220, 60, 2), V(0, 30, -128) },
		{ Vector3.new(220, 60, 2), V(0, 30, 82) },
		{ Vector3.new(2, 60, 212), V(-104, 30, -23) },
		{ Vector3.new(2, 60, 212), V(104, 30, -23) },
	} do
		P(ext, spec[1], CFrame.new(spec[2]), Color3.new(), M.SmoothPlastic, { transparency = 1, name = "Boundary" })
	end
	-- rain (outside only)
	rainEmitter(ext, V(0, 75, -90), Vector3.new(200, 1, 70), 900)
	rainEmitter(ext, V(-82, 75, 15), Vector3.new(40, 1, 140), 350)
	rainEmitter(ext, V(82, 75, 15), Vector3.new(40, 1, 140), 350)
	rainEmitter(ext, V(0, 75, 66), Vector3.new(130, 1, 30), 300)
	-- spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "CourtyardSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(0, -0.45, -108)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = ext
	Run.SetPoint("Courtyard", CFrame.new(0, 3, -105))
	Run.SetPoint("MenuCamera", CFrame.lookAt(V(-34, 9, -118), V(0, 22, -50)))
end

----------------------------------------------------------------------------------------
-- Furnished guest room template
----------------------------------------------------------------------------------------

-- forward = direction from the room centre to the door wall. W = width, Dp = depth.
local function bedroom(parent, floor: string, cx: number, cz: number, forward: Vector3, W: number, Dp: number, opts)
	opts = opts or {}
	local y = Y[floor]
	local base = CFrame.lookAt(V(cx, y, cz), V(cx, y, cz) + forward)
	local function L(x: number, z: number, rot: number?)
		return base * CFrame.new(x, 0, z) * CFrame.Angles(0, rot or 0, 0)
	end
	local abandoned = floor == "F3"
	local lightZone = if opts.dark then nil else floor
	local bed = Props.Bed(parent, L(0, Dp / 2 - 5.1), {
		messy = opts.messy or abandoned,
		blanket = abandoned and Color3.fromRGB(70, 60, 56) or opts.blanket,
		sheet = abandoned and Color3.fromRGB(150, 140, 120) or nil,
	})
	Hiding.Add(bed)
	Props.Nightstand(parent, L(-5, Dp / 2 - 1.4), not abandoned and lightZone or nil)
	Props.Nightstand(parent, L(5, Dp / 2 - 1.4), nil)
	if not opts.noWardrobe then
		Hiding.Add(Props.Wardrobe(parent, L(-W / 2 + 1.8, Dp / 2 - 11, RIGHT)))
	end
	Props.Desk(parent, L(W / 2 - 1.7, Dp / 2 - 12, RIGHT), { width = 5, lamp = not abandoned, zone = lightZone })
	Props.Armchair(parent, L(W / 2 - 4, -Dp / 2 + 7, math.rad(200)), { color = abandoned and Color3.fromRGB(80, 60, 56) or C.Burgundy })
	Props.Rug(parent, L(0, 2), math.min(W - 6, 12), 9, abandoned and Color3.fromRGB(60, 40, 38) or C.Burgundy)
	Props.Painting(parent, base * CFrame.new(0, 9.5, Dp / 2 - 0.45), 5, 3.4, opts.painting or "hotel", math.floor(cx + cz))
	if not opts.noLamp then
		local pendant = Props.Pendant(parent, (base * CFrame.new(0, 15, 0)).Position, floor, { brightness = abandoned and 0.8 or 1, color = abandoned and C.ColdBlue or nil })
		if abandoned or opts.faulty then
			for _, d in pendant:GetDescendants() do
				if d:IsA("Light") then
					d:SetAttribute("Faulty", true)
				end
			end
		end
	end
	Props.Suitcase(parent, L(-W / 2 + 4, -Dp / 2 + 5, 0.4), { lying = opts.messy or abandoned })
	if opts.messy or abandoned then
		Props.Chair(parent, L(2, -2, 0.7), { fallen = true })
		Props.BloodStain(parent, (L(1.5, Dp / 2 - 10)).Position, 2.4, math.floor(cx))
	end
	if abandoned then
		Props.Debris(parent, (L(-2, -4)).Position, 8, math.floor(cx + 100))
	end
	Props.Dust(parent, V(cx, y + 6, cz), Vector3.new(W - 4, 8, Dp - 4))
	wp(floor, cx, cz)
	return base, L
end

