    <Item class="LocalScript" referent="3">
      <Properties>
        <string name="Name">Loading</string>
        <string name="Source"><![CDATA[--!nonstrict
-- Loading screen (ReplicatedFirst runs before anything else replicates).

local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
ReplicatedFirst:RemoveDefaultLoadingScreen()

local gold = Color3.fromRGB(196, 160, 92)
local gui = Instance.new("ScreenGui")
gui.Name = "HotelLoading"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 100
gui.Parent = player:WaitForChild("PlayerGui")

local bg = Instance.new("Frame")
bg.Size = UDim2.fromScale(1, 1)
bg.BackgroundColor3 = Color3.fromRGB(6, 4, 6)
bg.BorderSizePixel = 0
bg.Parent = gui
local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new(Color3.fromRGB(40, 10, 16), Color3.fromRGB(4, 2, 4))
gradient.Rotation = 90
gradient.Parent = bg

local function label(text, font, size, y, color, height)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	l.Position = UDim2.fromScale(0.5, y)
	l.Size = UDim2.new(0.9, 0, 0, height)
	l.Font = font
	l.Text = text
	l.TextColor3 = color
	l.TextScaled = true
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = size
	c.Parent = l
	l.Parent = bg
	return l
end

label("الفندق المنسي", Enum.Font.Arial, 64, 0.4, gold, 70)
label("THE FORGOTTEN HOTEL", Enum.Font.Bodoni, 30, 0.48, Color3.fromRGB(230, 220, 200), 40)
local status = label("جارٍ تسجيل الوصول...", Enum.Font.Garamond, 22, 0.62, Color3.fromRGB(160, 148, 132), 26)
local tip = label("", Enum.Font.Garamond, 18, 0.88, Color3.fromRGB(130, 120, 110), 22)

local ring = Instance.new("Frame")
ring.AnchorPoint = Vector2.new(0.5, 0.5)
ring.Position = UDim2.fromScale(0.5, 0.7)
ring.Size = UDim2.fromOffset(36, 36)
ring.BackgroundTransparency = 1
ring.Parent = bg
local stroke = Instance.new("UIStroke")
stroke.Color = gold
stroke.Thickness = 3
stroke.Parent = ring
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0.5, 0)
corner.Parent = ring
local strokeGradient = Instance.new("UIGradient")
strokeGradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 1), NumberSequenceKeypoint.new(1, 1) })
strokeGradient.Parent = stroke

local tips = {
	"تسلّل في الظلام ولن يكاد الظل يراك.",
	"شعاع المصباح يُرى من أقصى الفندق.",
	"اختبئ قبل أن يراك. إن رآك وأنت تدخل، سيسحبك إلى الخارج.",
	"حارسة الغرف لا تغادر غرفتها أبدًا. اخرج وستكون بأمان.",
	"اقرأ كل شيء. كل رمز في الفندق مكتوب في مكان ما.",
	"يمكن لرفاقك إنعاشك إن سقطت. ابقوا معًا.",
	"الركض صاخب. المشي أهدأ. التسلّل صامت.",
}
local running = true
task.spawn(function()
	local i = math.random(1, #tips)
	while running do
		tip.Text = tips[i]
		i = i % #tips + 1
		task.wait(4)
	end
end)
local spin = RunService.RenderStepped:Connect(function(dt)
	strokeGradient.Rotation = (strokeGradient.Rotation + dt * 360) % 360
end)

local started = os.clock()
if not game:IsLoaded() then
	game.Loaded:Wait()
end
status.Text = "فتح الأبواب..."
ReplicatedStorage:WaitForChild("Remotes")
ReplicatedStorage:WaitForChild("Shared")
status.Text = "الفندق يتذكّرك."
while os.clock() - started < 3 do
	task.wait(0.1)
end
running = false
for _, d in bg:GetDescendants() do
	if d:IsA("TextLabel") then
		TweenService:Create(d, TweenInfo.new(1), { TextTransparency = 1 }):Play()
	end
end
TweenService:Create(stroke, TweenInfo.new(1), { Transparency = 1 }):Play()
TweenService:Create(bg, TweenInfo.new(1.5), { BackgroundTransparency = 1 }):Play()
task.wait(1.6)
spin:Disconnect()
gui:Destroy()
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="4">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Central tuning values for The Forgotten Hotel. Everything gameplay-related that a
-- designer might want to tweak lives here so it can be balanced without touching logic.

local Config = {}

Config.GameName = "THE FORGOTTEN HOTEL"
Config.GameNameArabic = "الفندق المنسي"
Config.HotelName = "GRAND AURELIA HOTEL"
Config.MaxPlayers = 6
Config.DataStoreName = "ForgottenHotel_v1"
Config.TotalDocuments = 12

-- Vertical layout (walkable floor surface Y of every level).
Config.Floors = { B = -14, G = 0, F1 = 16, F2 = 32, F3 = 48 }
Config.FloorOrder = { "B", "G", "F1", "F2", "F3" }
Config.FloorNames = { B = "القبو", G = "الطابق الأرضي", F1 = "الطابق الأول", F2 = "الطابق الثاني", F3 = "الطابق الثالث" }
Config.ElevatorFloors = { "G", "F1", "F2", "F3" }
Config.ElevatorLabels = { G = "أ", F1 = "1", F2 = "2", F3 = "3" }
Config.Footprint = { minX = -60, maxX = 60, minZ = -50, maxZ = 50 }

function Config.FloorAt(y: number): string
	if y < -2 then
		return "B"
	elseif y < 15 then
		return "G"
	elseif y < 31 then
		return "F1"
	elseif y < 47 then
		return "F2"
	end
	return "F3"
end

function Config.IsInside(pos: Vector3): boolean
	local f = Config.Footprint
	if pos.X < -100 and pos.Y < -2 then
		return true -- escape tunnel
	end
	return pos.X > f.minX - 1 and pos.X < f.maxX + 1 and pos.Z > f.minZ - 1 and pos.Z < f.maxZ + 1
end

Config.Palette = {
	Burgundy = Color3.fromRGB(92, 24, 34),
	DeepBurgundy = Color3.fromRGB(58, 14, 22),
	Black = Color3.fromRGB(14, 12, 14),
	Charcoal = Color3.fromRGB(32, 29, 31),
	Gold = Color3.fromRGB(178, 142, 74),
	DimGold = Color3.fromRGB(120, 96, 52),
	DarkBrown = Color3.fromRGB(52, 34, 24),
	Walnut = Color3.fromRGB(78, 50, 34),
	ColdBlue = Color3.fromRGB(120, 160, 220),
	Bone = Color3.fromRGB(214, 204, 182),
	Paper = Color3.fromRGB(222, 210, 180),
	Blood = Color3.fromRGB(74, 6, 8),
	DryBlood = Color3.fromRGB(52, 10, 10),
	Marble = Color3.fromRGB(28, 24, 26),
	Plaster = Color3.fromRGB(86, 88, 94),
	Concrete = Color3.fromRGB(70, 70, 72),
	Rust = Color3.fromRGB(96, 54, 36),
	Warm = Color3.fromRGB(255, 196, 132),
	Emergency = Color3.fromRGB(255, 40, 30),
}

Config.Movement = {
	CrouchSpeed = 6,
	WalkSpeed = 12,
	SprintSpeed = 21,
	DownedSpeed = 3,
	StaminaMax = 100,
	StaminaDrain = 20, -- per second while sprinting
	StaminaRegen = 13, -- per second otherwise
	ExhaustRecover = 30, -- stamina needed to sprint again after exhausting
	Noise = { idle = 0, crouch = 0.15, walk = 0.45, sprint = 1 },
}

Config.Flashlight = {
	Range = 52,
	Angle = 52,
	Brightness = 2.6,
	BatteryMax = 100,
	LowBattery = 15,
	BatteryItemRestore = 100,
}

Config.Health = {
	Max = 100,
	RegenPerSecond = 0.6,
	RegenDelay = 10,
	BandageHeal = 35,
	ReviveHealth = 45,
	ReviveHoldTime = 3.5,
}

Config.Difficulty = {
	Easy = {
		label = "سهل",
		monsterSpeed = 0.85,
		damage = 0.6,
		eventRate = 0.7,
		sight = 0.8,
		battery = 0.25,
		downedTime = 60,
		warning = 4,
		reward = 0.75,
	},
	Normal = {
		label = "عادي",
		monsterSpeed = 1,
		damage = 1,
		eventRate = 1,
		sight = 1,
		battery = 0.42,
		downedTime = 45,
		warning = 3,
		reward = 1,
	},
	Nightmare = {
		label = "كابوس",
		monsterSpeed = 1.12,
		damage = 1.45,
		eventRate = 1.4,
		sight = 1.25,
		battery = 0.62,
		downedTime = 30,
		warning = 2,
		reward = 1.6,
	},
}
Config.DifficultyOrder = { "Easy", "Normal", "Nightmare" }

Config.Shadow = {
	PatrolSpeed = 9,
	InvestigateSpeed = 13,
	ChaseSpeed = 18.5, -- players sprint at 21 but stamina runs out
	EscapeChaseSpeed = 17.5,
	Damage = 34,
	AttackRange = 5,
	AttackCooldown = 1.7,
	SightRange = 80, -- vs. players with flashlight on
	DarkSightRange = 34, -- vs. players in the dark
	CrouchSightRange = 20,
	FieldOfView = 0.25, -- dot product threshold (wide)
	HearRange = 56, -- multiplied by player noise
	LoseTime = 4.5,
	SearchTime = 7,
	RelocateTime = 30,
}

Config.Roomkeeper = {
	StepDistance = 3.4,
	StepInterval = 0.34,
	Damage = 40,
	AttackRange = 5,
}

Config.Concierge = {
	MinInterval = 35,
	MaxInterval = 85,
	MinDistance = 32,
	VanishDistance = 17,
	Lifetime = 12,
	StareTime = 2.2,
}

-- Puzzle solutions. Every one of them is discoverable through in-game clues:
--  Security: "Est. 1931" plaque above the lobby arch + reception memo.
--  ManagerSafe: Journal I says "her birthday, day then month"; the photograph says 27 April.
--  Laboratory: Journal III / maintenance note "the night she vanished" = 7 March 1974 (DDMM).
--  Library books: housekeeping rhyme "blood, crown, cold sky, the night".
Config.Codes = {
	Security = "1931",
	ManagerSafe = "2704",
	Laboratory = "0703",
}
Config.BookOrder = { "Red", "Gold", "Blue", "Black" }

Config.Rewards = {
	escape = 100,
	liberation = 200,
	concierge = 120,
	secret = 300,
	perDocument = 10,
}

-- Player settings (saved in the profile). Numbers are clamped to [min, max] on the server.
Config.DefaultSettings = {
	cameraMode = "first", -- "first" | "third"
	fov = 75,
	sensitivity = 1,
	headBob = true,
	particles = true,
	rain = true,
	shadows = true,
	brightness = 0,
	master = 1,
	music = 0.7,
	sfx = 1,
	ambience = 0.8,
}
Config.SettingRanges = {
	fov = { 60, 100 },
	sensitivity = { 0.2, 3 },
	brightness = { -0.2, 0.4 },
	master = { 0, 1 },
	music = { 0, 1 },
	sfx = { 0, 1 },
	ambience = { 0, 1 },
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Documents</string>
          <string name="Source"><![CDATA[--!nonstrict
-- الوثائق القابلة للجمع. تحمل القصة وكل تلميحات الألغاز.
-- الوثائق التي تحمل journal = true تُحتسب ضمن مهمة «اجمع مذكرات المالك».

local Documents = {
	welcome_card = {
		order = 1,
		title = "بطاقة ترحيب",
		where = "الردهة - مكتب الاستقبال",
		body = "مرحبًا بكم في فندق غراند أوريليا.\n\nفي خدمة الضيوف المميّزين منذ عام 1931.\n\nموظفونا في خدمتكم في كل ساعة. إن احتجتم أي شيء، اقرعوا الجرس عند الاستقبال. سيأتي أحدهم دائمًا.\n\nنتمنى أن تبقوا معنا إلى الأبد.\n\n- الإدارة",
	},
	reception_memo = {
		order = 2,
		title = "مذكرة الاستقبال",
		where = "مكتب الاستقبال",
		body = "إلى جميع موظفي الليل،\n\nأُعيد ضبط لوحة أرقام مكتب الأمن على السنة التي افتتح فيها هذا الفندق أبوابه. إن نسيتموها فأنتم لا تستحقون العمل هنا - لكنها منحوتة فوق قوس الردهة.\n\nالقاطع في غرفة التخزين يحترق باستمرار. الفيوزات الاحتياطية محفوظة هنا، على الرف.\n\nلا تصعدوا إلى الطابق الثالث بعد منتصف الليل.\n\n- هـ. هالدن، كبير موظفي الاستقبال",
	},
	last_menu = {
		order = 3,
		title = "قائمة العشاء الأخير",
		where = "المطعم",
		body = "غراند أوريليا - خدمة العشاء\nالثلاثاء، 6 مارس 1974\n\nحساء الدرّاج\nلحم ضأن مشوي بإكليل الجبل\nإجاص مطبوخ بالنبيذ الأحمر\n\nبخط مرتجف في الأسفل:\n«لم يُنهِ الضيوف في قاعة الطعام وجبتهم. ترك الموظفون مفتاح الاستقبال تحت الغطاء الفضي على طاولة الزاوية. لم يعد أحد لأخذه.»",
	},
	suite_diary = {
		order = 4,
		title = "مذكرات نزيل - الجناح 203",
		where = "الجناح 203 (الطابق الثاني)",
		body = "الليلة الثالثة.\nعادت المرأة في غرفة النوم. إنها لا تمشي - بل تكون في مكان آخر كلما رمشت.\n\nيقول الموظفون إنها تحرس الغرف. لا تحب الضيوف في الأماكن التي تخص الأطفال.\n\nإن همست لك، اخرج من الغرفة. إنها لا تلحق بك أبدًا خارج الباب.",
	},
	housekeeping_rhyme = {
		order = 5,
		title = "أنشودة التدبير المنزلي",
		where = "غرفة الغسيل (الطابق الأول)",
		body = "أنشودة كانت الخادمات يغنّينها وهن يطوين الشراشف:\n\n«الدمُ أولًا، ثم التاجُ الذهبي،\nثم السماءُ الزرقاءُ الباردة، ثم الليلُ الأسودُ الذي يسحبنا.»\n\n(أحمر، ذهبي، أزرق، أسود)\n\nمكتوب تحتها:\nباب المكتبة مسمّر من الداخل. يقول العجوز بيتر إن جدار الغسيل أجوف، وإن السلّم خلفه يصعد إلى الكتب.",
	},
	journal_1 = {
		order = 6,
		journal = true,
		title = "مذكرات إلياس فارن - الجزء الأول",
		where = "المكتبة (الطابق الثاني)",
		body = "ابنتي لينا مريضة، وأطباء هذه المدينة حمقى.\n\nبدأت عملي تحت الفندق. الضيوف يقدّمون... كل ما أحتاجه. أيامهم، وسنواتهم، ودفأهم. سيشربهم الفندق ويبقيها حيّة.\n\nأحتفظ بمفتاح غرفتها، 307، في خزنة مكتبي. لا تُفتح الخزنة إلا بتاريخ ميلادها - اليوم ثم الشهر. الصورة على مكتبي ستذكّرني، إن سلبني الحزن حتى ذلك.",
	},
	manager_photo = {
		order = 7,
		title = "صورة فوتوغرافية",
		where = "مكتب المدير (الطابق الثاني)",
		body = "صورة بالأبيض والأسود لفتاة تبتسم أمام نافورة الفندق.\n\nعلى ظهرها، بخط أنيق:\n«لينا، في عيد ميلادها الثامن.\n27 أبريل 1966.\nنوري.»",
	},
	journal_2 = {
		order = 8,
		journal = true,
		title = "مذكرات إلياس فارن - الجزء الثاني",
		where = "الغرفة السرية خلف مكتب المدير",
		body = "لقد نجح الأمر. القلب ينبض تحتنا، والفندق انزلق خارج العالم. لا خريطة تظهرنا. لا رسالة تصلنا.\n\nقَبِل هالدن منصبه إلى الأبد؛ سيستقبل كل ضيف حتى نهاية الزمن. وشيء آخر يمشي في الممرات الآن - ظلّ مصنوع من كل ما لم يستطع القلب هضمه. إنه يصطاد الصاخبين والمضيئين.\n\nلينا لم تعد تتكلم. إنها تنتظر في 307.",
	},
	journal_3 = {
		order = 9,
		journal = true,
		title = "مذكرات إلياس فارن - الجزء الثالث",
		where = "الغرفة 307",
		body = "اختفت في ليلة 7 مارس 1974. أخذها القلب هي أيضًا. أحتفظ بقلادتها في غرفة الأطفال، حيث تحرسها حارسة الغرف. إن أُحضرت القلادة إلى القلب، فقد ترقد أخيرًا بسلام - والفندق معها.\n\nباب المختبر لا يستجيب إلا لتلك الليلة. اليوم، ثم الشهر.\n\nمفتاح القبو مع هالدن. سيعطيه لمن يجيب على اتصاله.",
	},
	security_log = {
		order = 10,
		title = "سجل الأمن",
		where = "مكتب الأمن",
		body = "02:14 - الكاميرا 3 (الطابق الثالث) تُظهر شخصًا طويلًا. لا يوجد موظفون في ذلك الطابق.\n02:31 - المصعد يتحرك وحده. لا أحد بداخله.\n02:40 - ذهب رودريغز ليتفقد الممر. لم يعد.\n03:05 - لا يراك إن اختبأت قبل أن ينظر نحوك. الخزائن. تحت الأسرّة. أطفئ مصباحك.\n03:06 - إنه ينزل الدرج.",
	},
	maintenance_note = {
		order = 11,
		title = "ملاحظة صيانة",
		where = "غرفة الغلاية (القبو)",
		body = "مولّد القبو فارغ. الوقود الاحتياطي في المخزن السفلي، بجانب الأثاث القديم.\n\nحبل التشغيل صاخب جدًا. ما يعيش هنا في الأسفل سيسمعه. املأه بالوقود، اسحب الحبل، ثم اختبئ أو اركض.\n\nباب مختبر الطبيب خلف رفوف المخزن. قفل برقم. غيّره إلى تاريخ الليلة التي اختفت فيها ابنته.",
	},
	lab_report = {
		order = 12,
		title = "تقرير المختبر رقم 47",
		where = "المختبر السري",
		body = "الموضوع: القلب.\nالحالة: مستقر. يتغذّى.\n\nيمكن ختم القلب من هذه اللوحة، مما يسمح للموظفين بالمغادرة عبر نفق الخدمة - لكن الفندق يبقى.\n\nلا يمكن تدميره إلا بشيء أخذه وأحبّه.\n\nوإن جُمعت كل صفحة من قصتنا في مكان واحد، فقد تستيقظ الطفلة.\n\nمن يأخذ المفتاح الرئيسي يصبح حارس الفندق. إلى الأبد.",
	},
}

Documents.Order = {
	"welcome_card",
	"reception_memo",
	"last_menu",
	"suite_diary",
	"housekeeping_rhyme",
	"journal_1",
	"manager_photo",
	"journal_2",
	"journal_3",
	"security_log",
	"maintenance_note",
	"lab_report",
}

return Documents
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--!nonstrict
-- تعريفات الأدوات. الأدوات "المهمة" (critical) تسقط مكان اللاعب إذا غادر الخادم
-- حتى لا يخسر الفريق تقدّمه أبدًا.

local Items = {
	ReceptionKey = {
		name = "مفتاح الاستقبال",
		desc = "مفتاح نحاسي ثقيل محفور عليه: «الاستقبال - للموظفين فقط».",
		icon = "🗝",
