  <Item class="StarterPlayer" referent="45">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">14</float>
      <float name="CameraMinZoomDistance">0.5</float>
      <float name="CharacterJumpPower">30</float>
      <bool name="CharacterUseJumpPower">true</bool>
