end

function Props.MusicBox(parent, cf: CFrame)
	local m = Build.Model(parent, "MusicBox")
	P(m, Vector3.new(1.6, 0.9, 1.2), at(cf, 0, 0.45, 0), C.Burgundy, M.Wood, { collide = false })
	D(m, Vector3.new(1.6, 0.1, 1.2), at(cf, 0, 1.3, 0.5) * CFrame.Angles(math.rad(-70), 0, 0), C.Burgundy, M.Wood)
	Ball(m, 0.35, at(cf, 0, 1.05, 0).Position, C.Gold, M.Metal, { decor = true })
	return m
end

function Props.Wheelchair(parent, cf: CFrame)
	local m = Build.Model(parent, "Wheelchair")
	for _, sx in { -1, 1 } do
		Cyl(m, 2.6, 0.2, at(cf, sx * 1.1, 1.3, 0.3) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(0, 0, math.rad(90)), C.Charcoal, M.Metal, { decor = true })
	end
	P(m, Vector3.new(2, 0.3, 2), at(cf, 0, 1.8, 0), C.DeepBurgundy, M.Leather, { collide = false })
	D(m, Vector3.new(2, 2.2, 0.2), at(cf, 0, 3, 1), C.DeepBurgundy, M.Leather)
	return m
end

-- Ambient dust motes for a room. Disabled locally by clients on low graphics.
function Props.Dust(parent, pos: Vector3, size: Vector3)
	local box = D(parent, size, CFrame.new(pos), Color3.new(), M.SmoothPlastic, { transparency = 1, name = "DustVolume" })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Rate = 2.5
	emitter.Lifetime = NumberRange.new(8, 14)
	emitter.Speed = NumberRange.new(0.1, 0.4)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new(0.07)
	emitter.LightEmission = 0.3
	emitter.LightInfluence = 1
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Color = ColorSequence.new(Color3.fromRGB(230, 220, 200))
	emitter.Drag = 1
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emitter.Parent = box
	Build.Tag(emitter, "AmbientParticles")
	return box
end

return Props
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Monsters</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Concierge</string>
            <string name="Source"><![CDATA[--!nonstrict
-- THE CONCIERGE: Halden, the head concierge, bound to the hotel. He never attacks. He
-- appears at a distance (behind the reception desk, at corridor ends...), turns to face
-- you, and vanishes when approached or stared at for too long. Builds dread, and in the
-- story he hands over the basement key.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)

local Services = script.Parent.Parent.Services
local Run = require(Services.Run)
local Power = require(Services.Power)

local Rig = require(script.Parent.Rig)
local Senses = require(script.Parent.Senses)

local Concierge = {}
Concierge.__index = Concierge

local cfg = Config.Concierge
local ROOT_HEIGHT = 3.1

function Concierge.new()
	local self = setmetatable({}, Concierge)
	local model, root, head = Rig.Concierge()
	self.model = model
	self.root = root
	self.head = head
	root.Anchored = true
	self.visible = false
	self.enabled = false
	self.nextAppear = os.clock() + 25
	self.until_ = 0
	self.stare = {}
	self.scripted = false
	return self
end

function Concierge:Show(cf: CFrame, duration: number?, scripted: boolean?)
	local container = Run.Map and Run.Map:FindFirstChild("Monsters") or workspace
	self.model:PivotTo(cf + Vector3.new(0, ROOT_HEIGHT, 0))
	self.model.Parent = container
	self.model:SetAttribute("Anim", "stand")
	self.visible = true
	self.scripted = scripted == true
	self.until_ = os.clock() + (duration or cfg.Lifetime)
	self.stare = {}
	Sounds.Play("Whisper", self.head)
end

function Concierge:Hide(effect: boolean?)
	if not self.visible then
		return
	end
	if effect and self.root.Parent then
		Power.Flicker(self.root.Position, 18, 0.6)
		Sounds.Play("Static", self.head, { Looped = false })
	end
	self.visible = false
	self.scripted = false
	self.model.Parent = nil
end

local function facePlayers(self)
	local pos = self.root.Position
	local nearest, nd = nil, math.huge
	for _, entry in Run.Characters(true) do
		local d = (entry.root.Position - pos).Magnitude
		if d < nd then
			nearest, nd = entry, d
		end
	end
	if nearest then
		local target = Vector3.new(nearest.root.Position.X, pos.Y, nearest.root.Position.Z)
		if (target - pos).Magnitude > 0.5 then
			self.model:PivotTo(CFrame.lookAt(pos, target))
		end
	end
	return nearest, nd
end

local function chooseSpot(self)
	local occupied = Run.FloorsWithPlayers()
	local options = {}
	for _, spot in Run.ConciergeSpots do
		if occupied[spot.floor] then
			local pos = spot.cf.Position + Vector3.new(0, 6, 0)
			local tooClose = false
			local visibleTo = false
			for _, entry in Run.Characters(false) do
				local d = (entry.root.Position - spot.cf.Position).Magnitude
				if d < cfg.MinDistance then
					tooClose = true
				elseif d < 90 and Senses.LineOfSight(pos, entry.character, self.model) then
					visibleTo = true
				end
			end
			if not tooClose then
				table.insert(options, { spot = spot, weight = visibleTo and 3 or 1 })
			end
		end
	end
	if #options == 0 then
		return nil
	end
	local total = 0
	for _, o in options do
		total += o.weight
	end
	local r = math.random() * total
	for _, o in options do
		r -= o.weight
		if r <= 0 then
			return o.spot
		end
	end
	return options[1].spot
end

function Concierge:Step(dt: number)
	local now = os.clock()
	if self.visible then
		local _, nearestDist = facePlayers(self)
		if not self.scripted then
			if nearestDist < cfg.VanishDistance or now > self.until_ then
				self:Hide(true)
				return
			end
			-- vanish when someone stares at him too long
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local head = character and character:FindFirstChild("Head")
				if head then
					local toMe = (self.head.Position - head.Position)
					local facing = head.CFrame.LookVector:Dot(toMe.Unit)
					if facing > 0.96 and toMe.Magnitude < 90 then
						self.stare[player] = (self.stare[player] or 0) + dt
						if self.stare[player] > cfg.StareTime then
							self:Hide(true)
							return
						end
					end
				end
			end
		elseif now > self.until_ then
			self:Hide(true)
		end
		return
	end
	if not self.enabled or not Run.IsPlaying() then
		return
	end
	if now >= self.nextAppear then
		local rate = Run.Diff().eventRate
		self.nextAppear = now + math.random(cfg.MinInterval, cfg.MaxInterval) / rate
		local spot = chooseSpot(self)
		if spot then
			self:Show(spot.cf)
		end
	end
end

return Concierge
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Monsters</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Orchestrates the three monsters and their update loops.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Run = require(script.Parent.Parent.Services.Run)
local Shadow = require(script.Parent.Shadow)
local Concierge = require(script.Parent.Concierge)
local Roomkeeper = require(script.Parent.Roomkeeper)

local Monsters = {}
Monsters.Shadow = nil
Monsters.Concierge = nil
Monsters.Roomkeeper = nil

function Monsters.SetShadowMode(mode: string)
	if Monsters.Shadow then
		Monsters.Shadow:SetMode(mode)
	end
end

function Monsters.ShadowMode(): string
	return Monsters.Shadow and Monsters.Shadow.mode or "off"
end

function Monsters.SetConcierge(enabled: boolean)
	if Monsters.Concierge then
		Monsters.Concierge.enabled = enabled
		if not enabled then
			Monsters.Concierge:Hide(false)
		end
	end
end

-- Builds fresh monsters (called after every map build).
function Monsters.Reset()
	if Monsters.Shadow then
		Monsters.Shadow:Despawn()
		Monsters.Shadow.model:Destroy()
	end
	if Monsters.Concierge then
		Monsters.Concierge.model:Destroy()
	end
	if Monsters.Roomkeeper then
		Monsters.Roomkeeper.model:Destroy()
	end
	Monsters.Shadow = Shadow.new()
	Monsters.Concierge = Concierge.new()
	Monsters.Roomkeeper = Roomkeeper.new()
end

-- Places the Shadow at an exact spot (scripted scenes).
function Monsters.PlaceShadow(mode: string, ground: Vector3)
	local shadow = Monsters.Shadow
	if not shadow then
		return
	end
	shadow.mode = mode
	shadow:Despawn()
	shadow:Spawn(ground)
end

function Monsters.Init()
	Run.Noise:Connect(function(position: Vector3, loudness: number)
		if Monsters.Shadow then
			Monsters.Shadow:HearWorld(position, loudness)
		end
	end)
	local function loop(interval: number, getter)
		task.spawn(function()
			local last = os.clock()
			while true do
				task.wait(interval)
				local now = os.clock()
				local monster = getter()
				if monster and Run.IsPlaying() then
					local ok, err = pcall(monster.Step, monster, now - last)
					if not ok then
						warn("[Monsters] step error:", err)
					end
				end
				last = now
			end
		end)
	end
	loop(0.1, function()
		return Monsters.Shadow
	end)
	loop(0.2, function()
		return Monsters.Concierge
	end)
	loop(0.1, function()
		return Monsters.Roomkeeper
	end)
end

Monsters.Config = Config
return Monsters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Rig</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Builds the three monster rigs from parts and Motor6D joints (no external assets).
-- Joint names (RootJoint, Neck, LShoulder, RShoulder, LHip, RHip) are animated
-- procedurally on every client by client/MonsterAnimator via Motor6D.Transform.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Sounds = require(ReplicatedStorage.Shared.Sounds)

local Rig = {}
local C = Config.Palette
local M = Enum.Material

local function part(model: Model, name: string, size: Vector3, color: Color3, material: Enum.Material?, cf: CFrame?)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.Massless = true
	p.CFrame = cf or CFrame.new()
	p.CollisionGroup = "Monsters"
	p.Parent = model
	return p
end

local function motor(name: string, part0: BasePart, part1: BasePart, c0: CFrame, c1: CFrame)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = c0
	m.C1 = c1
	m.Parent = part0
	return m
end

-- Welds a decoration to a body part at an offset relative to that part.
local function deco(model: Model, base: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?)
	local p = part(model, name, size, color, material, base.CFrame * offset)
	if shape then
		p.Shape = shape
	end
	p.CanQuery = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = p
	weld.Parent = p
	return p
end

-- spec: hip (root bottom height), torso {size, y}, head {size, y}, arm {size, shoulderX, shoulderY},
-- leg {size, hipX, hipY}, colors
local function build(name: string, spec)
	local model = Instance.new("Model")
	model.Name = name
	local rootY = spec.hip + 1
	local root = part(model, "HumanoidRootPart", Vector3.new(2, 2, 1), Color3.new(), M.SmoothPlastic, CFrame.new(0, rootY, 0))
	root.Transparency = 1
	root.CanCollide = true
	root.Massless = false
	model.PrimaryPart = root

	local torso = part(model, "Torso", spec.torso.size, spec.body, spec.material, CFrame.new(0, spec.torso.y, 0))
	motor("RootJoint", root, torso, CFrame.new(0, spec.torso.y - rootY, 0), CFrame.new())

	local head = part(model, "Head", spec.head.size, spec.headColor or spec.body, spec.headMaterial or spec.material, CFrame.new(0, spec.head.y, 0))
	local neckY = spec.torso.y + spec.torso.size.Y / 2
	motor("Neck", torso, head, CFrame.new(0, neckY - spec.torso.y, 0), CFrame.new(0, neckY - spec.head.y, 0))

	for _, side in { "L", "R" } do
		local sx = side == "L" and -1 or 1
		local armLen = spec.arm.size.Y
		local shoulder = Vector3.new(sx * spec.arm.x, spec.arm.y, 0)
		local arm = part(model, side .. "Arm", spec.arm.size, spec.armColor or spec.body, spec.material, CFrame.new(shoulder - Vector3.new(0, armLen / 2, 0)))
		motor(side .. "Shoulder", torso, arm, CFrame.new(shoulder - Vector3.new(0, spec.torso.y, 0)), CFrame.new(0, armLen / 2, 0))
		local legLen = spec.leg.size.Y
		local hip = Vector3.new(sx * spec.leg.x, spec.leg.y, 0)
		local leg = part(model, side .. "Leg", spec.leg.size, spec.legColor or spec.body, spec.material, CFrame.new(hip - Vector3.new(0, legLen / 2, 0)))
		motor(side .. "Hip", torso, leg, CFrame.new(hip - Vector3.new(0, spec.torso.y, 0)), CFrame.new(0, legLen / 2, 0))
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = spec.hip
	humanoid.MaxHealth = math.huge
	humanoid.Health = math.huge
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.AutomaticScalingEnabled = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.WalkSpeed = 8
	humanoid.Parent = model
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)

	model:SetAttribute("Style", spec.style)
	model:SetAttribute("Anim", "idle")
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	CollectionService:AddTag(model, "MonsterRig")
	return model, root, torso, head, humanoid
end

function Rig.Shadow()
	local black = Color3.fromRGB(8, 8, 10)
	local model, root, torso, head, humanoid = build("TheShadow", {
		style = "shadow",
		hip = 3.6,
		body = black,
		material = M.SmoothPlastic,
		torso = { size = Vector3.new(2.2, 3.4, 1.1), y = 5.6 },
		head = { size = Vector3.new(1.4, 1.9, 1.4), y = 8.3 },
		arm = { size = Vector3.new(0.55, 4.8, 0.55), x = 1.4, y = 7.0 },
		leg = { size = Vector3.new(0.7, 3.9, 0.7), x = 0.6, y = 3.9 },
	})
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p ~= root then
			p.Transparency = 0.04
			p.Reflectance = 0
		end
	end
	-- elongated fingers
	for _, side in { "LArm", "RArm" } do
		local arm = model:FindFirstChild(side)
		for i = -1, 1 do
			deco(model, arm, "Finger", Vector3.new(0.12, 1.4, 0.12), CFrame.new(i * 0.16, -3, 0) * CFrame.Angles(0, 0, math.rad(i * 8)), black)
		end
	end
	for _, x in { -0.32, 0.32 } do
		local eye = deco(model, head, "Eye", Vector3.new(0.28, 0.14, 0.1), CFrame.new(x, 0.2, -0.72), Color3.fromRGB(255, 40, 30), M.Neon)
		eye.Name = "Eye"
	end
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 40, 30)
	glow.Range = 9
	glow.Brightness = 1.2
	glow.Parent = head
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(5, 5, 6))
	smoke.Rate = 14
	smoke.Lifetime = NumberRange.new(1, 2)
	smoke.Speed = NumberRange.new(0.5, 1.5)
	smoke.SpreadAngle = Vector2.new(180, 180)
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 4) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	smoke.LightInfluence = 0
	smoke.Parent = torso
	local breathing = Sounds.Make("Breathing", head)
	if breathing then
		breathing.Name = "Breathing"
	end
	return model, root, head, humanoid
end

function Rig.Concierge()
	local jacket = C.Burgundy
	local model, root, torso, head, humanoid = build("TheConcierge", {
		style = "concierge",
		hip = 2.1,
		body = jacket,
		material = M.Fabric,
		headColor = Color3.fromRGB(214, 206, 196),
		headMaterial = M.SmoothPlastic,
		legColor = C.Black,
		torso = { size = Vector3.new(2, 2.6, 1), y = 4.4 },
		head = { size = Vector3.new(1.2, 1.4, 1.2), y = 6.45 },
		arm = { size = Vector3.new(0.55, 2.6, 0.55), x = 1.28, y = 5.5 },
		leg = { size = Vector3.new(0.8, 3.1, 0.8), x = 0.5, y = 3.1 },
	})
	for i = 0, 2 do
		deco(model, torso, "Button", Vector3.new(0.2, 0.2, 0.1), CFrame.new(0, 0.7 - i * 0.6, -0.52), C.Gold, M.Metal)
	end
	deco(model, torso, "Collar", Vector3.new(1, 0.5, 0.1), CFrame.new(0, 1.05, -0.52), C.Bone, M.Fabric)
	deco(model, torso, "Bowtie", Vector3.new(0.6, 0.25, 0.12), CFrame.new(0, 1.1, -0.58), C.Black, M.Fabric)
	deco(model, head, "Hat", Vector3.new(0.6, 1.3, 1.3), CFrame.new(0, 0.95, 0) * CFrame.Angles(0, 0, math.rad(90)), jacket, M.Fabric, Enum.PartType.Cylinder)
	deco(model, head, "HatBand", Vector3.new(0.15, 1.32, 1.32), CFrame.new(0, 0.75, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Gold, M.Metal, Enum.PartType.Cylinder)
	for _, x in { -0.25, 0.25 } do
		deco(model, head, "EyeHole", Vector3.new(0.25, 0.18, 0.05), CFrame.new(x, 0.15, -0.6), Color3.fromRGB(4, 4, 4))
	end
	deco(model, head, "Smile", Vector3.new(0.6, 0.06, 0.05), CFrame.new(0, -0.35, -0.6), Color3.fromRGB(60, 10, 10))
	for _, side in { "LArm", "RArm" } do
		local arm = model:FindFirstChild(side)
		deco(model, arm, "Glove", Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, -1.3, 0), Color3.fromRGB(235, 232, 225), M.Fabric)
	end
	return model, root, head, humanoid
end

function Rig.Roomkeeper()
	local dress = Color3.fromRGB(205, 198, 182)
	local model, root, torso, head, humanoid = build("TheRoomkeeper", {
		style = "roomkeeper",
		hip = 2.4,
		body = dress,
		material = M.Fabric,
		headColor = Color3.fromRGB(232, 226, 214),
		headMaterial = M.SmoothPlastic,
		armColor = Color3.fromRGB(190, 182, 170),
		legColor = Color3.fromRGB(150, 140, 130),
		torso = { size = Vector3.new(1.8, 2.8, 1), y = 4.6 },
		head = { size = Vector3.new(1.2, 1.5, 1.2), y = 6.75 },
		arm = { size = Vector3.new(0.4, 4.6, 0.4), x = 1.1, y = 5.7 },
		leg = { size = Vector3.new(0.5, 3.4, 0.5), x = 0.4, y = 3.4 },
	})
	deco(model, torso, "Skirt", Vector3.new(3.4, 3, 3), CFrame.new(0, -2.6, 0) * CFrame.Angles(0, 0, math.rad(90)), dress, M.Fabric, Enum.PartType.Cylinder)
	deco(model, head, "Hair", Vector3.new(1.35, 2.6, 1.0), CFrame.new(0, -0.5, 0.25), Color3.fromRGB(10, 8, 8), M.Fabric)
	deco(model, head, "HairTop", Vector3.new(1.35, 0.4, 1.35), CFrame.new(0, 0.75, 0), Color3.fromRGB(10, 8, 8), M.Fabric)
	for _, x in { -0.25, 0.25 } do
		deco(model, head, "EyeHole", Vector3.new(0.28, 0.32, 0.05), CFrame.new(x, 0.1, -0.61), Color3.fromRGB(2, 2, 2))
	end
	deco(model, head, "Crack", Vector3.new(0.05, 0.8, 0.05), CFrame.new(0.15, 0.2, -0.62) * CFrame.Angles(0, 0, 0.4), Color3.fromRGB(30, 20, 20))
	deco(model, head, "Mouth", Vector3.new(0.35, 0.5, 0.05), CFrame.new(0, -0.45, -0.61), Color3.fromRGB(20, 4, 4))
	for _, side in { "LArm", "RArm" } do
		local arm = model:FindFirstChild(side)
		for i = -1, 1 do
			deco(model, arm, "Finger", Vector3.new(0.08, 1, 0.08), CFrame.new(i * 0.12, -2.7, 0), Color3.fromRGB(190, 182, 170))
		end
	end
	return model, root, head, humanoid
end

return Rig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Roomkeeper</string>
            <string name="Source"><![CDATA[--!nonstrict
-- THE ROOMKEEPER: guards specific rooms (Suite 203's bedroom, Room 307's nursery and
-- the ballroom stage). Entering one makes her appear and whisper a warning; stay past
-- the warning and she closes in with jerky, unnatural "skips" and attacks. She never
-- leaves her room, so stepping out is always the answer.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)

local Services = script.Parent.Parent.Services
local Run = require(Services.Run)
local Power = require(Services.Power)
local Survival = require(Services.Survival)

local Rig = require(script.Parent.Rig)

local Roomkeeper = {}
Roomkeeper.__index = Roomkeeper

local cfg = Config.Roomkeeper
local ROOT_HEIGHT = 3.4

function Roomkeeper.new()
	local self = setmetatable({}, Roomkeeper)
	local model, root, head = Rig.Roomkeeper()
	self.model = model
	self.root = root
	self.head = head
	root.Anchored = true
	self.zone = nil
	self.state = "Idle"
	self.warnUntil = 0
	self.nextStep = 0
	self.cooldowns = {}
	return self
end

local function inside(zone, pos: Vector3): boolean
	return pos.X > zone.min.X and pos.X < zone.max.X and pos.Z > zone.min.Z and pos.Z < zone.max.Z and pos.Y > zone.min.Y and pos.Y < zone.max.Y
end

local function occupants(zone)
	local list = {}
	for _, entry in Run.Characters(false) do
		if not entry.character:GetAttribute("Hidden") and inside(zone, entry.root.Position) then
			table.insert(list, entry)
		end
	end
	return list
end

function Roomkeeper:Appear(zone, near: Vector3)
	self.zone = zone
	self.state = "Warn"
	self.warnUntil = os.clock() + Run.Diff().warning
	-- appear in the lair corner, facing the intruder
	local lair = zone.lair.Position
	self.model:PivotTo(CFrame.lookAt(lair + Vector3.new(0, ROOT_HEIGHT, 0), Vector3.new(near.X, lair.Y + ROOT_HEIGHT, near.Z)))
	self.model:SetAttribute("Anim", "idle")
	self.model.Parent = Run.Map and Run.Map:FindFirstChild("Monsters") or workspace
	Power.Flicker(lair, 20, 1.2)
	Sounds.Play("Whisper", self.head, { Volume = 1 })
	local players = {}
	for _, entry in occupants(zone) do
		table.insert(players, entry.player)
	end
	Run.Cinematic(players, "Whisper", { text = zone.warning or "اخرج... هذه الغرفة ليست لك." })
end

function Roomkeeper:Vanish(cooldown: number)
	if self.zone then
		self.cooldowns[self.zone.name] = os.clock() + cooldown
	end
	self.zone = nil
	self.state = "Idle"
	self.model.Parent = nil
end

function Roomkeeper:Step(_dt: number)
	local now = os.clock()
	if not Run.IsPlaying() then
		if self.zone then
			self:Vanish(0)
		end
		return
	end
	if not self.zone then
		for name, zone in Run.Zones do
			zone.name = name
			if (self.cooldowns[name] or 0) < now and (zone.enabled == nil or zone.enabled()) then
				local list = occupants(zone)
				if #list > 0 then
					self:Appear(zone, list[1].root.Position)
					return
				end
			end
		end
		return
	end
	local zone = self.zone
	if self.state == "Gone" then
		return
	end
	local list = occupants(zone)
	if #list == 0 then
		if self.state ~= "Leaving" then
			self.state = "Leaving"
			self.leaveAt = now + 0.6
			self.model:SetAttribute("Anim", "idle")
			Sounds.Play("Shriek", self.head)
		elseif now >= self.leaveAt then
			self:Vanish(3)
		end
		return
	end
	if self.state == "Leaving" then
		self.state = "Hunt"
	end
	if self.state == "Warn" and now >= self.warnUntil then
		self.state = "Hunt"
		Sounds.Play("Shriek", self.head)
	end
	if self.state ~= "Hunt" or now < self.nextStep then
		return
	end
	self.nextStep = now + cfg.StepInterval / Run.Diff().monsterSpeed
	-- nearest intruder
	local pos = self.root.Position
	local target, td = nil, math.huge
	for _, entry in list do
		local d = (entry.root.Position - pos).Magnitude
		if d < td then
			target, td = entry, d
		end
	end
	if not target then
		return
	end
	if td <= cfg.AttackRange then
		self.model:SetAttribute("Anim", "attack")
		Sounds.Play("Scream", self.head)
		Survival.Damage(target.player, cfg.Damage, "Roomkeeper")
		self.state = "Gone"
		task.delay(0.5, function()
			self:Vanish(6)
		end)
		return
	end
	-- skip toward the target, staying inside her room
	local goal = Vector3.new(target.root.Position.X, pos.Y, target.root.Position.Z)
	local dir = (goal - pos).Unit
	local stepLen = math.min(cfg.StepDistance, td - 2)
	local nextPos = pos + dir * stepLen
	nextPos = Vector3.new(
		math.clamp(nextPos.X, zone.min.X + 1.5, zone.max.X - 1.5),
		pos.Y,
		math.clamp(nextPos.Z, zone.min.Z + 1.5, zone.max.Z - 1.5)
	)
	self.model:PivotTo(CFrame.lookAt(nextPos, nextPos + dir))
	self.model:SetAttribute("Anim", "skip")
	Sounds.Play("Creak", self.root, { PlaybackSpeed = 0.5 + math.random() * 0.4 })
end

return Roomkeeper
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Senses</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Perception shared by all monsters: line of sight, vision ranges (flashlight makes you
-- visible from far away, crouching in the dark keeps you hidden), and hearing.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Run = require(script.Parent.Parent.Services.Run)

local Senses = {}

local function characterList(): { Instance }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	return list
end

-- True when nothing solid blocks the line between `from` and the target character.
function Senses.LineOfSight(from: Vector3, character: Model, ignore: Instance): boolean
	local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	if not head then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = characterList()
	table.insert(filter, ignore)
	params.FilterDescendantsInstances = filter
	params.RespectCanCollide = true
	local target = (head :: BasePart).Position
	local result = workspace:Raycast(from, target - from, params)
	return result == nil
end

function Senses.SightRange(character: Model): number
	local diff = Run.Diff()
	local cfg = Config.Shadow
	local range
	if character:GetAttribute("Lit") then
		range = cfg.SightRange
	elseif character:GetAttribute("Noise") ~= nil and (character:GetAttribute("Noise") :: number) <= Config.Movement.Noise.crouch then
		range = cfg.CrouchSightRange
	else
		range = cfg.DarkSightRange
	end
	return range * diff.sight
end

-- Best visible target (closest). `omni` ignores the field-of-view cone (used mid-chase).
function Senses.FindTarget(monster: Model, eye: Vector3, look: Vector3, omni: boolean?)
	local best, bestDist = nil, math.huge
	for _, entry in Run.Characters(false) do
		local character = entry.character
		if not character:GetAttribute("Hidden") then
			local offset = entry.root.Position - eye
			local dist = offset.Magnitude
			local range = Senses.SightRange(character)
			if omni then
				range = math.max(range, Config.Shadow.DarkSightRange * 1.6)
			end
			if dist <= range and dist < bestDist then
				local inCone = omni or dist < 8 or look:Dot(offset.Unit) >= Config.Shadow.FieldOfView
				if inCone and math.abs(offset.Y) < 12 and Senses.LineOfSight(eye, character, monster) then
					best, bestDist = entry, dist
				end
			end
		end
	end
	return best, bestDist
end

-- Loudest audible player within hearing range.
function Senses.Hear(position: Vector3)
	local best, bestScore = nil, 0
	local diff = Run.Diff()
	for _, entry in Run.Characters(true) do
		local noise = entry.character:GetAttribute("Noise") or 0
		if noise > 0 and not entry.character:GetAttribute("Hidden") then
			local dist = (entry.root.Position - position).Magnitude
			local radius = Config.Shadow.HearRange * noise * diff.sight
			if dist < radius and math.abs(entry.root.Position.Y - position.Y) < 12 then
				local score = 1 - dist / radius
				if score > bestScore then
					best, bestScore = entry, score
				end
			end
		end
	end
	return best
end

return Senses
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Shadow</string>
            <string name="Source"><![CDATA[--!nonstrict
-- THE SHADOW: the hunter. States: Patrol -> Investigate (noise) -> Chase (sight) ->
-- Search (lost sight) -> Patrol. Uses direct steering when it has a clear line and
-- PathfindingService otherwise. Phases through doors. Relocates between floors when no
-- players are around. Fair rules: crouching in the dark keeps you nearly invisible,
-- flashlights are visible from far away, hiding works unless it SAW you hide.

local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)

local Services = script.Parent.Parent.Services
local Run = require(Services.Run)
local Power = require(Services.Power)
local Survival = require(Services.Survival)
local Hiding = require(Services.Hiding)
local Data = require(Services.Data)

local Rig = require(script.Parent.Rig)
local Senses = require(script.Parent.Senses)

local Shadow = {}
Shadow.__index = Shadow

local MODES = {
	upper = { "F3", "F2" },
	roam = { "G", "F1", "F2", "F3" },
	basement = { "B" },
	escape = { "B" },
}
local ROOT_HEIGHT = 4.6
local cfg = Config.Shadow

function Shadow.new()
	local self = setmetatable({}, Shadow)
	local model, root, head, humanoid = Rig.Shadow()
	self.model = model
	self.root = root
	self.head = head
	self.humanoid = humanoid
	self.breathing = head:FindFirstChild("Breathing")
	self.mode = "off"
	self.state = "Inactive"
	self.active = false
	self.floor = nil
	self.path = PathfindingService:CreatePath({
		AgentRadius = 1.6,
		AgentHeight = 8,
		AgentCanJump = false,
		AgentCanClimb = false,
		WaypointSpacing = 4,
		Costs = { Door = 2 },
	})
	self.waypoints = nil
	self.wpIndex = 1
	self.pathGoal = nil
	self.pathTime = 0
	self.computing = false
	self.lastPos = Vector3.zero
	self.stuckTime = 0
	self.target = nil
	self.lastSeen = 0
	self.lastSeenPos = nil
	self.investigatePos = nil
	self.searchPoint = nil
	self.searchUntil = 0
	self.attackReady = 0
	self.pauseUntil = 0
	self.patrolGoal = nil
	self.lonelySince = os.clock()
	self.stepSound = 0
	self.flickerAt = 0
	self.pendingNoise = nil
	self.dragTarget = nil
	return self
end

----------------------------------------------------------------------------------------
-- Spawning
----------------------------------------------------------------------------------------

function Shadow:Spawn(ground: Vector3)
	local container = Run.Map and Run.Map:FindFirstChild("Monsters") or workspace
	self.model:PivotTo(CFrame.new(ground + Vector3.new(0, ROOT_HEIGHT, 0)))
	self.model.Parent = container
	pcall(function()
		self.root:SetNetworkOwner(nil)
	end)
	self.active = true
	self.state = "Patrol"
	self.floor = Config.FloorAt(ground.Y + 1)
	self.waypoints = nil
	self.patrolGoal = nil
	self.lonelySince = os.clock()
	self.model:SetAttribute("Chasing", false)
	self.model:SetAttribute("TargetId", 0)
	if self.breathing then
		self.breathing:Play()
	end
end

function Shadow:Despawn()
	self.active = false
	self.state = "Inactive"
	self.target = nil
	self.model:SetAttribute("Chasing", false)
	self.model:SetAttribute("TargetId", 0)
	if self.breathing then
		self.breathing:Stop()
	end
	self.model.Parent = nil
end

local function nearestPlayerDistance(pos: Vector3): number
	local best = math.huge
	for _, entry in Run.Characters(true) do
		best = math.min(best, (entry.root.Position - pos).Magnitude)
	end
	return best
end

-- Moves to a floor allowed by the current mode, preferring floors with players but
-- always appearing out of sight (far from everyone).
function Shadow:Relocate(minDistance: number?)
	local floors = MODES[self.mode]
	if not floors then
		return
	end
	local occupied = Run.FloorsWithPlayers()
	local candidates = {}
	for _, floor in floors do
		if occupied[floor] and Run.Waypoints[floor] then
			table.insert(candidates, floor)
		end
	end
	if #candidates == 0 then
		for _, floor in floors do
			if Run.Waypoints[floor] then
				table.insert(candidates, floor)
			end
		end
	end
	if #candidates == 0 then
		return
	end
	local floor = candidates[math.random(1, #candidates)]
	local nodes = Run.Waypoints[floor]
	local far, farthest, farthestDist = {}, nil, -1
	for _, node in nodes do
		local d = nearestPlayerDistance(node)
		if d >= (minDistance or 45) then
			table.insert(far, node)
		end
		if d > farthestDist then
			farthest, farthestDist = node, d
		end
	end
	local point = #far > 0 and far[math.random(1, #far)] or farthest
	if not point then
		return
	end
	if self.active then
		Power.Flicker(self.root.Position, 25, 0.8)
	end
	self:Despawn()
	self:Spawn(point)
end

function Shadow:SetMode(mode: string)
	self.mode = mode
	if mode == "off" then
		if self.active then
			self:Despawn()
		end
		return
	end
	local floors = MODES[mode]
	if not self.active or not table.find(floors, self.floor) then
		self:Relocate(mode == "escape" and 0 or 45)
	end
end

----------------------------------------------------------------------------------------
-- Navigation
----------------------------------------------------------------------------------------

local function clearLine(self, from: Vector3, to: Vector3): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = { self.model }
	for _, entry in Run.Characters(true) do
		table.insert(filter, entry.character)
	end
	params.FilterDescendantsInstances = filter
	params.CollisionGroup = "Monsters" -- doors don't block the Shadow
	params.RespectCanCollide = true
	for _, h in { -3.4, 0 } do
		local a = from + Vector3.new(0, h, 0)
		local b = Vector3.new(to.X, a.Y, to.Z)
		if workspace:Raycast(a, b - a, params) then
			return false
		end
	end
	return true
end

function Shadow:ComputePath(goal: Vector3)
	if self.computing then
		return
	end
	self.computing = true
	task.spawn(function()
		local start = self.root.Position - Vector3.new(0, ROOT_HEIGHT - 1, 0)
		local ok = pcall(function()
			self.path:ComputeAsync(start, goal)
		end)
		self.computing = false
		self.pathGoal = goal
		self.pathTime = os.clock()
		if ok and self.path.Status == Enum.PathStatus.Success then
			self.waypoints = self.path:GetWaypoints()
			self.wpIndex = math.min(2, #self.waypoints)
		else
			self.waypoints = nil
		end
	end)
end

function Shadow:MoveTowards(goal: Vector3, speed: number)
	self.humanoid.WalkSpeed = speed * Run.Diff().monsterSpeed
	local pos = self.root.Position
	local flat = Vector3.new(goal.X - pos.X, 0, goal.Z - pos.Z)
	if math.abs(goal.Y - (pos.Y - ROOT_HEIGHT)) < 6 and flat.Magnitude < 70 and clearLine(self, pos, goal) then
		self.waypoints = nil
		self.humanoid:MoveTo(goal)
		return
	end
	local stale = not self.pathGoal or (self.pathGoal - goal).Magnitude > 6 or os.clock() - self.pathTime > 2.5
	if (stale or not self.waypoints) and not self.computing then
		self:ComputePath(goal)
	end
	if self.waypoints then
		local wp = self.waypoints[self.wpIndex]
		if wp then
			local wpFlat = Vector3.new(wp.Position.X - pos.X, 0, wp.Position.Z - pos.Z)
			if wpFlat.Magnitude < 3 then
				self.wpIndex += 1
				wp = self.waypoints[self.wpIndex]
			end
		end
		if wp then
			self.humanoid:MoveTo(wp.Position)
		end
	end
end

local function reached(self, point: Vector3?, radius: number): boolean
	if not point then
		return true
	end
	local pos = self.root.Position
	return Vector3.new(point.X - pos.X, 0, point.Z - pos.Z).Magnitude < radius and math.abs(point.Y - (pos.Y - ROOT_HEIGHT)) < 6
end

----------------------------------------------------------------------------------------
-- Behaviour
----------------------------------------------------------------------------------------

function Shadow:StartChase(entry)
	self.state = "Chase"
	self.target = entry.player
	self.dragTarget = nil
	self.model:SetAttribute("Chasing", true)
	self.model:SetAttribute("TargetId", entry.player.UserId)
	Sounds.Play("Growl", self.head)
	Run.Cinematic(entry.player, "Spotted", nil)
end

function Shadow:EndChase(nextState: string)
	self.state = nextState
	self.model:SetAttribute("Chasing", false)
	self.model:SetAttribute("TargetId", 0)
	self.target = nil
	self.dragTarget = nil
	if nextState == "Search" then
		self.searchUntil = os.clock() + cfg.SearchTime
		self.searchPoint = self.lastSeenPos
	end
end

function Shadow:Attack(player: Player)
	local now = os.clock()
	self.attackReady = now + cfg.AttackCooldown
	self.pauseUntil = now + 1.1
	self.model:SetAttribute("Anim", "attack")
	Sounds.Play("Scream", self.head)
	Survival.Damage(player, cfg.Damage, "Shadow")
	task.delay(0.7, function()
		if self.model:GetAttribute("Anim") == "attack" then
			self.model:SetAttribute("Anim", "run")
		end
	end)
end

function Shadow:HearWorld(position: Vector3, loudness: number)
	if not self.active or loudness <= 0 or self.state == "Chase" then
		return
	end
	local dist = (position - self.root.Position).Magnitude
	if dist < 140 * loudness and math.abs(position.Y - self.root.Position.Y) < 14 then
		self.pendingNoise = position
	end
end

function Shadow:Step(dt: number)
	if not self.active then
		return
	end
	local now = os.clock()
	local pos = self.root.Position
	if pos.Y < -80 then
		self:Relocate(30)
		return
	end
	self.floor = Config.FloorAt(pos.Y - ROOT_HEIGHT + 1)
	local look = self.root.CFrame.LookVector
	local eye = self.head.Position

	-- PERCEPTION
	local seen = nil
	if self.mode == "escape" then
		local best, bestDist = nil, math.huge
		for _, entry in Run.Characters(false) do
			local d = (entry.root.Position - pos).Magnitude
			if d < bestDist and not entry.character:GetAttribute("Escaped") then
				best, bestDist = entry, d
			end
		end
		seen = best
	else
		seen = Senses.FindTarget(self.model, eye, look, self.state == "Chase")
	end
	if seen then
		if self.state ~= "Chase" then
			self:StartChase(seen)
		end
		self.target = seen.player
		self.lastSeen = now
		self.lastSeenPos = seen.root.Position
	end

	-- BEHAVIOUR
	local moveGoal, moveSpeed = nil, cfg.PatrolSpeed
	if self.state == "Chase" then
		local player = self.target
		local character = player and player.Character
		local troot = character and character:FindFirstChild("HumanoidRootPart")
		local thum = character and character:FindFirstChildOfClass("Humanoid")
		if not troot or not thum or thum.Health <= 0 or character:GetAttribute("Downed") then
			self:EndChase("Search")
		elseif character:GetAttribute("Hidden") then
			local hiddenFor = Hiding.HiddenFor(player)
			local sawIt = hiddenFor ~= nil and self.lastSeen >= (now - hiddenFor) - 0.35 and (self.lastSeenPos - pos).Magnitude < 32
			if sawIt or self.dragTarget == player then
				self.dragTarget = player
				local spot = Hiding.SpotOf(player)
				if spot then
					moveGoal, moveSpeed = spot.exit.Position, cfg.ChaseSpeed
					if reached(self, spot.exit.Position, 5) then
						Hiding.Exit(player, true)
						self:Attack(player)
						self.dragTarget = nil
						self.lastSeen = now
					end
				else
					self.dragTarget = nil
				end
			else
				Data.Award(player, "hide_seek")
				self:EndChase("Search")
			end
		elseif self.mode ~= "escape" and now - self.lastSeen > cfg.LoseTime then
			self:EndChase("Search")
		else
			moveGoal = seen and seen.root.Position or self.lastSeenPos
			moveSpeed = self.mode == "escape" and cfg.EscapeChaseSpeed or cfg.ChaseSpeed
			local dist = (troot.Position - pos).Magnitude
			if seen and dist <= cfg.AttackRange and now >= self.attackReady then
				self:Attack(player)
			end
		end
	end

	if self.state ~= "Chase" then
		local heard = Senses.Hear(pos)
		if heard then
			self.investigatePos = heard.root.Position
			self.state = "Investigate"
		elseif self.pendingNoise then
			self.investigatePos = self.pendingNoise
			self.state = "Investigate"
		end
		self.pendingNoise = nil
	end

	if self.state == "Investigate" then
		moveGoal, moveSpeed = self.investigatePos, cfg.InvestigateSpeed
		if reached(self, self.investigatePos, 4) then
			self.lastSeenPos = self.investigatePos
			self.state = "Search"
			self.searchUntil = now + cfg.SearchTime * 0.6
			self.searchPoint = self.investigatePos
		end
	elseif self.state == "Search" then
		if now > self.searchUntil then
			self.state = "Patrol"
			self.patrolGoal = nil
		else
			if not self.searchPoint or reached(self, self.searchPoint, 4) then
				local base = self.lastSeenPos or pos
				self.searchPoint = base + Vector3.new(math.random(-12, 12), 0, math.random(-12, 12))
				self.searchPoint = Vector3.new(self.searchPoint.X, base.Y, self.searchPoint.Z)
			end
			moveGoal, moveSpeed = self.searchPoint, cfg.InvestigateSpeed * 0.8
		end
	elseif self.state == "Patrol" then
		local nodes = Run.Waypoints[self.floor]
		if nodes and #nodes > 0 then
			if not self.patrolGoal or reached(self, self.patrolGoal, 4) then
				if self.patrolGoal then
					self.pauseUntil = now + math.random(10, 30) / 10
				end
				-- drift toward players sometimes so encounters keep happening
				local pick = nodes[math.random(1, #nodes)]
				if math.random() < 0.35 then
					local best, bestD = pick, math.huge
					for _, node in nodes do
						local d = nearestPlayerDistance(node)
						if d < bestD and d > 18 then
							best, bestD = node, d
						end
					end
					pick = best
				end
				self.patrolGoal = pick
			end
			moveGoal, moveSpeed = self.patrolGoal, cfg.PatrolSpeed
		end
		-- relocate if nobody is on this floor
		local occupied = Run.FloorsWithPlayers()
		if occupied[self.floor] then
			self.lonelySince = now
		elseif now - self.lonelySince > cfg.RelocateTime then
			self.lonelySince = now
			self:Relocate(45)
			return
		end
	end

	-- MOVEMENT
	if now < self.pauseUntil or not moveGoal then
		self.humanoid:MoveTo(pos)
	else
		self:MoveTowards(moveGoal, moveSpeed)
	end

	-- stuck detection: phase forward along the path (it is a shadow after all)
	local moved = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(self.lastPos.X, 0, self.lastPos.Z)).Magnitude
	if moveGoal and now >= self.pauseUntil and moved < 0.15 then
		self.stuckTime += dt
		if self.stuckTime > 2.2 then
			self.stuckTime = 0
			local nextWp = self.waypoints and self.waypoints[self.wpIndex + 1]
			if nextWp then
				self.model:PivotTo(CFrame.new(nextWp.Position + Vector3.new(0, ROOT_HEIGHT, 0)))
				self.wpIndex += 1
			else
				self.patrolGoal = nil
				self.waypoints = nil
				self.pathGoal = nil
			end
		end
	else
		self.stuckTime = 0
	end
	self.lastPos = pos

	-- ANIMATION + EFFECTS
	local speed = Vector3.new(self.root.AssemblyLinearVelocity.X, 0, self.root.AssemblyLinearVelocity.Z).Magnitude
	if self.model:GetAttribute("Anim") ~= "attack" then
		self.model:SetAttribute("Anim", speed > 12 and "run" or (speed > 1 and "walk" or "idle"))
	end
	if speed > 1 and now > self.stepSound then
		self.stepSound = now + (speed > 12 and 0.33 or 0.6)
		Sounds.Play("HeavyStep", self.root)
	end
	if self.state == "Chase" and now > self.flickerAt then
		self.flickerAt = now + 1.4
		Power.Flicker(pos, 26, 0.9)
	end
end

return Shadow
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Persistent player profiles (DataStoreService): coins, achievements, lifetime documents,
-- endings, flashlight skins, settings, stats and the host's saved run (checkpoint save).
-- Works offline in Studio when API access is disabled (session-only data + warning).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Progression = require(Shared.Progression)
local Documents = require(Shared.Documents)
local Net = require(Shared.Net)

local Data = {}
local profiles: { [Player]: any } = {}
local loaded: { [Player]: boolean } = {}
local store: DataStore? = nil
local storeAvailable = false

local function defaultProfile()
	return {
		v = 1,
		coins = 0,
		achievements = {},
		docs = {},
		endings = {},
		skins = { classic = true },
		skin = "classic",
		settings = table.clone(Config.DefaultSettings),
		stats = { runs = 0, deaths = 0, escapes = 0, wins = 0 },
		run = nil,
	}
end

local function reconcile(profile)
	local template = defaultProfile()
	for key, value in template do
		if profile[key] == nil then
			profile[key] = value
		end
	end
	for key, value in Config.DefaultSettings do
		if profile.settings[key] == nil then
			profile.settings[key] = value
		end
	end
	for key, value in template.stats do
		if profile.stats[key] == nil then
			profile.stats[key] = value
		end
	end
	profile.skins.classic = true
	return profile
end

function Data.Get(player: Player)
	return profiles[player]
end

function Data.IsLoaded(player: Player): boolean
	return loaded[player] == true
end

function Data.Sync(player: Player)
	local profile = profiles[player]
	if not profile or not player.Parent then
		return
	end
	Net.Event("Profile"):FireClient(player, {
		coins = profile.coins,
		achievements = profile.achievements,
		docs = profile.docs,
		endings = profile.endings,
		skins = profile.skins,
		skin = profile.skin,
		settings = profile.settings,
		stats = profile.stats,
		hasSave = profile.run ~= nil,
		saveMission = profile.run and profile.run.mission or nil,
		online = storeAvailable,
	})
end

function Data.Load(player: Player)
	local profile = nil
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync("player_" .. player.UserId)
			end)
			if ok then
				profile = result
				break
			end
			warn(string.format("[Data] load attempt %d failed for %s: %s", attempt, player.Name, tostring(result)))
			task.wait(attempt)
		end
	end
	if typeof(profile) ~= "table" then
		profile = defaultProfile()
	end
	profiles[player] = reconcile(profile)
	loaded[player] = true
	Data.Sync(player)
end

function Data.Save(player: Player)
	local profile = profiles[player]
	if not profile or not store or not loaded[player] then
		return
	end
	local ok, err = pcall(function()
		store:UpdateAsync("player_" .. player.UserId, function()
			return profile
		end)
	end)
	if not ok then
		warn("[Data] save failed for", player.Name, err)
	end
end

function Data.Award(player: Player, id: string)
	local profile = profiles[player]
	local def = Progression.Achievements[id]
	if not profile or not def or profile.achievements[id] then
		return
	end
	profile.achievements[id] = os.time()
	profile.coins += def.coins or 0
	for skinId, skin in Progression.Skins do
		if skin.unlock == id then
			profile.skins[skinId] = true
		end
	end
	Net.Event("Achievement"):FireClient(player, id)
	Data.Sync(player)
end

function Data.MarkDoc(player: Player, docId: string)
	local profile = profiles[player]
	if not profile or not Documents[docId] or profile.docs[docId] then
		return
	end
	profile.docs[docId] = true
	local count = 0
	for _ in profile.docs do
		count += 1
	end
	if count >= Config.TotalDocuments then
		Data.Award(player, "archivist")
	end
	Data.Sync(player)
end

function Data.Stat(player: Player, name: string, delta: number)
	local profile = profiles[player]
	if profile then
		profile.stats[name] = (profile.stats[name] or 0) + delta
	end
end

function Data.AddCoins(player: Player, amount: number)
	local profile = profiles[player]
	if profile then
		profile.coins += math.floor(amount)
		Data.Sync(player)
	end
end

function Data.MarkEnding(player: Player, endingId: string)
	local profile = profiles[player]
	if profile then
		profile.endings[endingId] = true
	end
end

function Data.SaveRun(player: Player, snapshot)
	local profile = profiles[player]
	if profile then
		profile.run = snapshot
	end
end

function Data.ClearRun(player: Player)
	local profile = profiles[player]
	if profile then
		profile.run = nil
	end
end

local function sanitizeSettings(incoming)
	local clean = {}
	if typeof(incoming) ~= "table" then
		return clean
	end
	for key, default in Config.DefaultSettings do
		local value = incoming[key]
		if value ~= nil and typeof(value) == typeof(default) then
			if typeof(value) == "number" then
				if value ~= value then
					continue -- NaN
				end
				local range = Config.SettingRanges[key]
				if range then
					value = math.clamp(value, range[1], range[2])
				end
			elseif typeof(value) == "string" then
				if key == "cameraMode" and value ~= "first" and value ~= "third" then
					continue
				end
			end
			clean[key] = value
		end
	end
	return clean
end

function Data.Init(onSkinChanged: ((Player) -> ())?)
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		-- probe once so Studio without API access degrades gracefully
		local probeOk = pcall(function()
			store:GetAsync("probe")
		end)
		storeAvailable = probeOk
		if not probeOk then
			store = nil
			warn("[Data] DataStore unavailable (enable 'Studio Access to API Services' to test saving). Using session-only data.")
		end
	else
		warn("[Data] DataStore unavailable:", result)
	end

	Players.PlayerAdded:Connect(Data.Load)
	for _, player in Players:GetPlayers() do
		task.spawn(Data.Load, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		Data.Save(player)
		profiles[player] = nil
		loaded[player] = nil
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not storeAvailable then
			return
		end
		local threads = {}
		for _, player in Players:GetPlayers() do
			table.insert(threads, task.spawn(Data.Save, player))
		end
		task.wait(2)
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				task.spawn(Data.Save, player)
			end
		end
	end)

	Net.Event("Settings").OnServerEvent:Connect(function(player, incoming)
		if not Net.Allow(player, "settings", 0.5) then
			return
		end
		local profile = profiles[player]
		if not profile then
			return
		end
		for key, value in sanitizeSettings(incoming) do
			profile.settings[key] = value
		end
	end)

	Net.Event("EquipSkin").OnServerEvent:Connect(function(player, skinId)
		if typeof(skinId) ~= "string" or not Net.Allow(player, "skin", 0.5) then
			return
		end
		local profile = profiles[player]
		if profile and profile.skins[skinId] and Progression.Skins[skinId] then
			profile.skin = skinId
			Data.Sync(player)
			if onSkinChanged then
				onSkinChanged(player)
			end
		end
	end)
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Doors</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Hinged doors: locks, keys, barricades, slams. Door leaves belong to the "Doors"
-- collision group so monsters phase through them (and pathfinding treats them as open).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Sounds = require(Shared.Sounds)
local Signal = require(Shared.Signal)

local Build = require(script.Parent.Parent.Map.Build)
local Run = require(script.Parent.Run)
local Interact = require(script.Parent.Interact)
local Inventory = require(script.Parent.Inventory)

local Doors = {}
Doors.Registry = {} :: { [string]: any }
Doors.Changed = Signal.new() -- (id, isOpen, player?)
Doors.Unlocked = Signal.new() -- (id, player?)

local C = Config.Palette
local M = Enum.Material

local STYLES = {
	wood = { color = C.Walnut, material = M.Wood, panel = C.DarkBrown, frame = C.DarkBrown, knob = C.Gold },
	room = { color = Color3.fromRGB(70, 30, 30), material = M.Wood, panel = C.DeepBurgundy, frame = C.DimGold, knob = C.Gold },
	grand = { color = C.DarkBrown, material = M.Wood, panel = C.DarkBrown, frame = C.Gold, knob = C.Gold, glass = true },
	rotten = { color = Color3.fromRGB(70, 62, 56), material = M.WoodPlanks, panel = Color3.fromRGB(56, 50, 46), frame = Color3.fromRGB(60, 56, 52), knob = Color3.fromRGB(120, 110, 90) },
	metal = { color = Color3.fromRGB(70, 74, 76), material = M.DiamondPlate, panel = Color3.fromRGB(60, 62, 64), frame = Color3.fromRGB(40, 40, 42), knob = Color3.fromRGB(150, 150, 150) },
	steel = { color = Color3.fromRGB(60, 58, 56), material = M.CorrodedMetal, panel = Color3.fromRGB(80, 50, 36), frame = C.Charcoal, knob = Color3.fromRGB(150, 150, 150) },
	lab = { color = Color3.fromRGB(150, 155, 160), material = M.Metal, panel = Color3.fromRGB(120, 125, 130), frame = C.Charcoal, knob = Color3.fromRGB(40, 40, 40) },
}

local function promptText(door)
	if door.barricaded then
		return "ادفع"
	elseif door.locked then
		return "جرّب"
	elseif door.isOpen then
		return "أغلق"
	end
	return "افتح"
end

local function refresh(door)
	if door.prompt then
		door.prompt.ActionText = promptText(door)
		door.prompt.ObjectText = door.label or ""
	end
end

local function buildLeaf(door, parent, hingeCF: CFrame, width: number, height: number, side: number, style)
	-- side = 1: hinge on the left, leaf extends to +X. side = -1: hinge on the right.
	local leaf = Instance.new("Model")
	leaf.Name = "Leaf"
	local hinge = Build.P(leaf, Vector3.new(0.2, 0.2, 0.2), hingeCF, Color3.new(), M.SmoothPlastic, { transparency = 1, decor = true, name = "Hinge" })
	leaf.PrimaryPart = hinge
	local centre = hingeCF * CFrame.new(side * width / 2, height / 2, 0)
	local main = Build.P(leaf, Vector3.new(width, height, 0.35), centre, style.color, style.material, { name = "Panel" })
	main.CollisionGroup = "Doors"
	local modifier = Instance.new("PathfindingModifier")
	modifier.Label = "Door"
	modifier.PassThrough = true
	modifier.Parent = main
	if style.glass then
		Build.D(leaf, Vector3.new(width - 1, height * 0.45, 0.4), centre * CFrame.new(0, height * 0.15, 0), Color3.fromRGB(70, 90, 110), M.Glass, { transparency = 0.5 })
		Build.D(leaf, Vector3.new(width - 0.6, 0.25, 0.42), centre * CFrame.new(0, -height * 0.1, 0), C.Gold, M.Metal)
	else
		for _, face in { -1, 1 } do
			Build.D(leaf, Vector3.new(width - 1, height * 0.35, 0.1), centre * CFrame.new(0, height * 0.2, face * 0.2), style.panel, style.material)
			Build.D(leaf, Vector3.new(width - 1, height * 0.3, 0.1), centre * CFrame.new(0, -height * 0.22, face * 0.2), style.panel, style.material)
		end
	end
	for _, face in { -1, 1 } do
		Build.Ball(leaf, 0.35, (centre * CFrame.new(side * (width / 2 - 0.45), -0.4, face * 0.3)).Position, style.knob, M.Metal, { decor = true })
	end
	if door.number and side == 1 then
		Build.Text(leaf, Vector3.new(1.4, 0.7, 0.05), centre * CFrame.new(0, height * 0.42 - 0.6, -0.2), door.number, {
			bg = C.Gold,
			color = C.Black,
			font = Enum.Font.Bodoni,
			material = M.Metal,
		})
	end
	leaf.Parent = parent
	return { model = leaf, hingeCF = hingeCF, side = side }
end

-- opts: id, cf, w, h, style, locked, key, lockedText, double, number, label, open, barricaded, noPrompt, swing
function Doors.Add(parent: Instance, opts)
	local style = STYLES[opts.style or "wood"] or STYLES.wood
	local w, h = opts.w or 4.5, opts.h or 9
	local model = Build.Model(parent, "Door_" .. (opts.id or "anon"))
	local cf: CFrame = opts.cf
	local door = {
		id = opts.id,
		cf = cf,
		w = w,
		h = h,
		model = model,
		locked = opts.locked == true,
		key = opts.key,
		lockedText = opts.lockedText,
		barricaded = opts.barricaded == true,
		label = opts.label or (opts.number and ("الغرفة " .. opts.number)) or "باب",
		number = opts.number,
		isOpen = false,
		leaves = {},
		swing = opts.swing or 100,
		busy = false,
	}
	-- frame
	Build.D(model, Vector3.new(0.35, h + 0.3, 1.2), cf * CFrame.new(-w / 2 + 0.17, h / 2, 0), style.frame, M.Wood)
	Build.D(model, Vector3.new(0.35, h + 0.3, 1.2), cf * CFrame.new(w / 2 - 0.17, h / 2, 0), style.frame, M.Wood)
	Build.D(model, Vector3.new(w, 0.4, 1.2), cf * CFrame.new(0, h + 0.05, 0), style.frame, M.Wood)
	local clear = w - 0.4
	if opts.double then
		local half = clear / 2
		table.insert(door.leaves, buildLeaf(door, model, cf * CFrame.new(-clear / 2, 0, 0), half, h - 0.1, 1, style))
		table.insert(door.leaves, buildLeaf(door, model, cf * CFrame.new(clear / 2, 0, 0), half, h - 0.1, -1, style))
	else
		table.insert(door.leaves, buildLeaf(door, model, cf * CFrame.new(-clear / 2, 0, 0), clear, h - 0.1, 1, style))
	end
	if door.barricaded then
		local planks = Build.Model(model, "Barricade")
		for i, y in { 2.2, 4.4, 6.6 } do
			Build.P(planks, Vector3.new(w + 0.6, 0.6, 0.25), cf * CFrame.new(0, y, 0.6) * CFrame.Angles(0, 0, math.rad(i % 2 == 0 and 8 or -8)), Color3.fromRGB(90, 70, 50), M.WoodPlanks)
		end
		door.barricade = planks
	end
	if not opts.noPrompt then
		local anchor = Interact.Anchor(model, (cf * CFrame.new(0, 4.5, 0)).Position, "PromptAnchor")
		door.anchor = anchor
		door.prompt = Interact.Add(anchor, {
			text = promptText(door),
			object = door.label,
			dist = 9,
			los = false,
		}, function(player)
			Doors.Use(door.id, player)
		end)
	end
	if door.id then
		Doors.Registry[door.id] = door
	end
	if opts.open then
		Doors.SetOpen(door, true, nil, { silent = true, instant = true })
	end
	return door
end

local function resolve(idOrDoor)
	if typeof(idOrDoor) == "string" then
		return Doors.Registry[idOrDoor]
	end
	return idOrDoor
end

function Doors.Get(id: string)
	return Doors.Registry[id]
end

function Doors.SetOpen(idOrDoor, open: boolean, player: Player?, opts)
	local door = resolve(idOrDoor)
	if not door or door.isOpen == open then
		return
	end
	opts = opts or {}
	door.isOpen = open
	local duration = opts.instant and 0 or (opts.slam and 0.18 or 0.7)
	for _, leaf in door.leaves do
		local target = open and math.rad(-leaf.side * door.swing) or 0
		-- cancel a swing that is still in progress and continue from where it is
		local current = leaf.current or 0
		if leaf.tween then
			leaf.tween:Cancel()
			leaf.tween = nil
		end
		if leaf.value then
			current = leaf.value.Value
			leaf.value:Destroy()
			leaf.value = nil
		end
		local value = Instance.new("NumberValue")
		value.Value = current
		local function apply()
			leaf.current = value.Value
			if leaf.model.Parent then
				leaf.model:PivotTo(leaf.hingeCF * CFrame.Angles(0, value.Value, 0))
			end
		end
		if duration <= 0 then
			value.Value = target
			apply()
			value:Destroy()
		else
			leaf.value = value
			value.Changed:Connect(apply)
			local tween = TweenService:Create(value, TweenInfo.new(duration, opts.slam and Enum.EasingStyle.Quad or Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Value = target })
			leaf.tween = tween
			tween.Completed:Connect(function(state)
				if state == Enum.PlaybackState.Completed and leaf.value == value then
					leaf.value = nil
					leaf.tween = nil
					value:Destroy()
				end
			end)
			tween:Play()
		end
	end
	if not opts.silent and door.anchor then
		local name = opts.slam and "DoorSlam" or (open and "DoorOpen" or "DoorClose")
		Sounds.Play(name, door.anchor)
	end
	refresh(door)
	Doors.Changed:Fire(door.id, open, player)
end

function Doors.Unlock(idOrDoor, player: Player?)
	local door = resolve(idOrDoor)
	if not door or not door.locked then
		return
	end
	door.locked = false
	refresh(door)
	if door.anchor then
		Sounds.Play("Unlock", door.anchor)
	end
	Doors.Unlocked:Fire(door.id, player)
end

function Doors.Lock(idOrDoor, text: string?)
	local door = resolve(idOrDoor)
	if not door then
		return
	end
	door.locked = true
	if text then
		door.lockedText = text
	end
	refresh(door)
end

function Doors.RemoveBarricade(idOrDoor)
	local door = resolve(idOrDoor)
	if not door or not door.barricaded then
		return
	end
	door.barricaded = false
	if door.barricade then
		for _, plank in door.barricade:GetChildren() do
			if plank:IsA("BasePart") then
				plank.Anchored = false
				plank.CanCollide = true
				plank.CollisionGroup = "Debris"
			end
		end
		task.delay(8, function()
			if door.barricade then
				door.barricade:Destroy()
			end
		end)
	end
	if door.anchor then
		Sounds.Play("Crash", door.anchor)
	end
	refresh(door)
end

function Doors.Use(id: string, player: Player)
	local door = Doors.Registry[id]
	if not door then
		return
	end
	if door.barricaded then
		Run.Notify(player, "إنه مسمّر من الجهة الأخرى.", "warn")
		Sounds.Play("Locked", door.anchor)
		return
	end
	if door.locked then
		if door.key and Inventory.Has(player, door.key) then
			Doors.Unlock(door, player)
			Run.Notify(player, "فُتح القفل باستخدام: " .. Items[door.key].name .. ".", "item")
		else
			Run.Notify(player, door.lockedText or "إنه مقفل.", "warn")
			Sounds.Play("Locked", door.anchor)
			return
		end
	end
	Doors.SetOpen(door, not door.isOpen, player)
end

function Doors.Slam(id: string)
	local door = Doors.Registry[id]
	if door then
		Doors.SetOpen(door, false, nil, { slam = true })
	end
end

function Doors.Reset()
	Doors.Registry = {}
end

return Doors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Elevator</string>
            <string name="Source"><![CDATA[--!nonstrict
-- The main elevator. The car is moved between floors while its doors are shut and the
-- riders are carried with it (offset preserved), which is robust for any player count and
-- never desyncs physics. Needs power + the access card (inserted once for the whole team).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Sounds = require(Shared.Sounds)
local Signal = require(Shared.Signal)

local Build = require(script.Parent.Parent.Map.Build)
local Run = require(script.Parent.Run)
local Interact = require(script.Parent.Interact)
local Inventory = require(script.Parent.Inventory)

local Elevator = {}
Elevator.Current = "G"
Elevator.Busy = false
Elevator.Arrived = Signal.new() -- (floor, riders)
Elevator.Landings = {} :: { [string]: any }
Elevator.Car = nil :: Model?

local C = Config.Palette
local M = Enum.Material
local SHAFT = { x1 = -5, x2 = 5, z1 = 36, z2 = 46 }
local DOOR_Z = 35.75

local function floorY(floor: string): number
	return Config.Floors[floor]
end

local function setLandingDoors(floor: string, open: boolean, instant: boolean?)
	local landing = Elevator.Landings[floor]
	if not landing then
		return
	end
	landing.open = open
	for i, leaf in landing.leaves do
		local closedX = i == 1 and -1.5 or 1.5
		local openX = i == 1 and -4.3 or 4.3
		local target = CFrame.new(open and openX or closedX, floorY(floor) + 4.5, DOOR_Z)
		if instant then
			leaf.CFrame = target
		else
			TweenService:Create(leaf, TweenInfo.new(1, Enum.EasingStyle.Sine), { CFrame = target }):Play()
		end
	end
end
Elevator.SetDoors = setLandingDoors

local function updateIndicators(text: string)
	for _, landing in Elevator.Landings do
		landing.indicator.Text = text
	end
	if Elevator.CarIndicator then
		Elevator.CarIndicator.Text = text
	end
end

local function riders(): { { player: Player, character: Model } }
	local y = floorY(Elevator.Current)
	local list = {}
	for _, entry in Run.Characters(true) do
		local p = entry.root.Position
		if p.X > SHAFT.x1 - 0.2 and p.X < SHAFT.x2 + 0.2 and p.Z > DOOR_Z + 0.1 and p.Z < SHAFT.z2 and p.Y > y - 1 and p.Y < y + 12 then
			table.insert(list, { player = entry.player, character = entry.character })
		end
	end
	return list
end

function Elevator.Travel(target: string, ghost: boolean?)
	if Elevator.Busy or not Elevator.Car then
		return
	end
	if target == Elevator.Current then
		setLandingDoors(target, true)
		return
	end
	Elevator.Busy = true
	local from = Elevator.Current
	setLandingDoors(from, false)
	task.wait(1.2)
	local carried = riders()
	local delta = Vector3.new(0, floorY(target) - floorY(from), 0)
	local floors = math.abs(table.find(Config.ElevatorFloors, target) - table.find(Config.ElevatorFloors, from))
	local duration = math.max(2.6, floors * 1.4)
	local players = {}
	for _, r in carried do
		table.insert(players, r.player)
	end
	if #players > 0 then
		Run.Cinematic(players, "ElevatorRide", { duration = duration })
	end
	Elevator.Car:PivotTo(Elevator.Car:GetPivot() + delta)
	for _, r in carried do
		r.character:PivotTo(r.character:GetPivot() + delta)
	end
	local hum = Sounds.Make("ElevatorRun", Elevator.Car.PrimaryPart)
	if hum then
		hum:Play()
	end
	updateIndicators("...")
	task.wait(duration)
	if hum then
		hum:Destroy()
	end
	Elevator.Current = target
	updateIndicators(Config.ElevatorLabels[target])
	Sounds.Play("Ding", Elevator.Landings[target].indicatorPart)
	setLandingDoors(target, true)
	Elevator.Busy = false
	Elevator.Arrived:Fire(target, players, ghost == true)
end

function Elevator.Request(floor: string, player: Player?)
	if not Run.Flag("power") then
		if player then
			Run.Notify(player, "لا شيء يحدث. المصعد بلا كهرباء.", "warn")
		end
		return
	end
	if not Run.Flag("elevator") then
		if player then
			Run.Notify(player, "اللوحة تومض: مطلوب بطاقة دخول الموظفين.", "warn")
		end
		return
	end
	if Elevator.Busy then
		if player then
			Run.Notify(player, "المصعد يتحرك...", "info")
		end
		return
	end
	task.spawn(Elevator.Travel, floor)
end

local function buildLanding(parent: Instance, floor: string)
	local y = floorY(floor)
	local wallStyle = { color = C.Marble, material = M.Marble, thickness = 0.8 }
	Build.Wall(parent, SHAFT.x1, SHAFT.z1, SHAFT.x1, SHAFT.z2, y, 15, wallStyle)
	Build.Wall(parent, SHAFT.x2, SHAFT.z1, SHAFT.x2, SHAFT.z2, y, 15, wallStyle)
	Build.Wall(parent, SHAFT.x1, SHAFT.z2, SHAFT.x2, SHAFT.z2, y, 15, wallStyle)
	Build.Wall(parent, SHAFT.x1 - 0.4, SHAFT.z1, SHAFT.x2 + 0.4, SHAFT.z1, y, 15, { color = C.Gold, material = M.Metal, thickness = 0.9 }, {
		{ c = 0, w = 6, h = 9 },
	})
	-- decorative surround
	Build.D(parent, Vector3.new(7.4, 0.6, 0.4), CFrame.new(0, y + 9.3, DOOR_Z - 0.5), C.DimGold, M.Metal)
	for _, x in { -3.4, 3.4 } do
		Build.D(parent, Vector3.new(0.6, 9, 0.4), CFrame.new(x, y + 4.5, DOOR_Z - 0.5), C.DimGold, M.Metal)
	end
	local leaves = {}
	for i = 1, 2 do
		local leaf = Build.P(parent, Vector3.new(3.05, 9, 0.3), CFrame.new(i == 1 and -1.5 or 1.5, y + 4.5, DOOR_Z), C.Gold, M.Metal, { name = "LiftDoor" })
		leaf.Reflectance = 0.1
		table.insert(leaves, leaf)
	end
	local indicatorPart, indicator = Build.Text(parent, Vector3.new(1.6, 1.2, 0.1), Build.At(0, y + 10.6, DOOR_Z - 0.55, "S"), Config.ElevatorLabels[Elevator.Current], {
		bg = Color3.fromRGB(20, 10, 8),
		color = Color3.fromRGB(255, 120, 60),
		font = Enum.Font.Arcade,
		brightness = 2,
		lightInfluence = 0,
	})
	local button = Build.D(parent, Vector3.new(0.6, 1, 0.2), CFrame.new(4.3, y + 4.5, DOOR_Z - 0.6), C.Gold, M.Metal, { name = "CallButton" })
	Build.Ball(parent, 0.3, button.Position + Vector3.new(0, 0, -0.15), Color3.fromRGB(255, 150, 80), M.Neon, { decor = true })
	Interact.Add(button, { text = "استدعِ", object = "المصعد", dist = 7 }, function(player)
		Sounds.Play("Click", button)
		Elevator.Request(floor, player)
	end)
	Elevator.Landings[floor] = { leaves = leaves, indicator = indicator, indicatorPart = indicatorPart, open = false }
end

local function buildCar(parent: Instance)
	local y = floorY("G")
	local car = Build.Model(parent, "ElevatorCar")
	local root = Build.P(car, Vector3.new(1, 1, 1), CFrame.new(0, y, 41), Color3.new(), M.SmoothPlastic, { transparency = 1, decor = true, name = "CarRoot" })
	car.PrimaryPart = root
	Build.P(car, Vector3.new(9.2, 0.3, 9.4), CFrame.new(0, y + 0.15, 41), C.DeepBurgundy, M.Carpet)
	Build.D(car, Vector3.new(9.4, 0.1, 9.6), CFrame.new(0, y + 0.31, 41), C.Gold, M.Metal, { transparency = 0.9 })
	-- walls
	Build.P(car, Vector3.new(9.2, 10, 0.3), CFrame.new(0, y + 5, 45.65), C.Walnut, M.Wood)
	for _, x in { -4.65, 4.65 } do
		Build.P(car, Vector3.new(0.3, 10, 9.6), CFrame.new(x, y + 5, 41), C.Walnut, M.Wood)
		Build.D(car, Vector3.new(0.3, 0.3, 9.2), CFrame.new(x * 0.96, y + 3.4, 41), C.Gold, M.Metal)
	end
	Build.D(car, Vector3.new(9.2, 0.4, 9.6), CFrame.new(0, y + 10, 41), C.Charcoal, M.Metal)
	local _, mirrorGlass = nil, nil
	do
		local m = require(script.Parent.Parent.Map.Props)
		_, mirrorGlass = m.Mirror(car, Build.At(0, y + 5.5, 45.5, "S"), 5, 5, { broken = true, seed = 4 })
	end
	local lamp = Build.D(car, Vector3.new(3, 0.2, 3), CFrame.new(0, y + 9.75, 41), C.Bone, M.Neon, { name = "Bulb" })
	Build.Light(lamp, "PointLight", { Range = 14, Brightness = 1.2, Color = C.Warm, Shadows = false }, "Lift")
	-- control panel on the right wall (facing into the car)
	local panelCF = Build.At(4.45, y + 4.5, 38.5, "W")
	Build.D(car, Vector3.new(1.4, 3.2, 0.15), panelCF * CFrame.new(0, 0, -0.05), C.Gold, M.Metal)
	for i, floor in Config.ElevatorFloors do
		Build.Text(car, Vector3.new(0.5, 0.5, 0.05), panelCF * CFrame.new(0, -1.1 + (i - 1) * 0.65, -0.14), Config.ElevatorLabels[floor], {
			bg = Color3.fromRGB(240, 220, 170),
			color = C.Black,
			font = Enum.Font.Bodoni,
		})
	end
	local _, carIndicator = Build.Text(car, Vector3.new(1.2, 0.6, 0.05), panelCF * CFrame.new(0, 1.3, -0.14), "G", {
		bg = Color3.fromRGB(20, 10, 8),
		color = Color3.fromRGB(255, 120, 60),
		font = Enum.Font.Arcade,
		brightness = 2,
		lightInfluence = 0,
	})
	Elevator.CarIndicator = carIndicator
	local panelAnchor = Interact.Anchor(car, (panelCF * CFrame.new(0, 0, -0.8)).Position, "PanelAnchor")
	Interact.Add(panelAnchor, { text = "اختر الطابق", object = "لوحة المصعد", dist = 6, los = false }, function(player)
		if not Run.Flag("elevator") then
			if Inventory.Has(player, "ElevatorCard") then
				Run.SetFlag("elevator", true)
				Sounds.Play("Unlock", panelAnchor)
				Run.Notify(nil, player.DisplayName .. " أدخل بطاقة الدخول. استيقظ المصعد بطنين خافت.", "item")
			else
				Run.Notify(player, "مطلوب بطاقة دخول الموظفين.", "warn")
				Sounds.Play("Locked", panelAnchor)
				return
			end
		end
		if not Run.Flag("power") then
			Run.Notify(player, "اللوحة مظلمة. لا كهرباء.", "warn")
			return
		end
		Net.Event("Choice"):FireClient(player, "elevator", {
			current = Elevator.Current,
			floors = Config.ElevatorFloors,
			labels = Config.ElevatorLabels,
			names = Config.FloorNames,
		})
	end)
	Elevator.Car = car
	Elevator.MirrorGlass = mirrorGlass
	return car
end

function Elevator.Build(parent: Instance)
	Elevator.Current = "G"
	Elevator.Busy = false
	Elevator.Landings = {}
	local folder = Build.Folder(parent, "Elevator")
	for _, floor in Config.ElevatorFloors do
		buildLanding(folder, floor)
	end
	buildCar(folder)
	for _, floor in Config.ElevatorFloors do
		setLandingDoors(floor, false, true)
	end
end

-- The elevator moves by itself (random horror event).
function Elevator.Ghost(): boolean
	if Elevator.Busy or not Run.Flag("power") or #riders() > 0 then
		return false
	end
	local options = {}
	for _, floor in Config.ElevatorFloors do
		if floor ~= Elevator.Current then
			table.insert(options, floor)
		end
	end
	task.spawn(Elevator.Travel, options[math.random(1, #options)], true)
	return true
end

function Elevator.Init()
	Net.Event("Choice").OnServerEvent:Connect(function(player, context, choice)
		if context ~= "elevator" or typeof(choice) ~= "string" then
			return
		end
		if not Net.Allow(player, "elevator", 0.5) or not table.find(Config.ElevatorFloors, choice) then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local car = Elevator.Car
		if not root or not car then
			return
		end
		if (root.Position - car:GetPivot().Position).Magnitude > 9 then
			return
		end
		Elevator.Request(choice, player)
	end)
end

return Elevator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Horror director: zone triggers, randomized horror events (paced by difficulty) and the
-- scripted cinematic sequences of the story.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local Net = require(Shared.Net)

local Run = require(script.Parent.Run)
local Power = require(script.Parent.Power)
local Doors = require(script.Parent.Doors)
local Elevator = require(script.Parent.Elevator)
local Interact = require(script.Parent.Interact)
local Pickups = require(script.Parent.Pickups)

local Map = script.Parent.Parent.Map
local Monsters = script.Parent.Parent.Monsters

local Events = {}
local triggers = {}

local function hotelRefs()
	return require(Map.Hotel).Refs
end

local function monsters()
	return require(Monsters.Monsters)
end

----------------------------------------------------------------------------------------
-- Zone triggers
----------------------------------------------------------------------------------------

local function inside(zone, pos: Vector3): boolean
	return pos.X >= zone.min.X and pos.X <= zone.max.X and pos.Y >= zone.min.Y and pos.Y <= zone.max.Y and pos.Z >= zone.min.Z and pos.Z <= zone.max.Z
end
Events.Inside = inside

-- callback(player); opts.once (default true), opts.condition()
function Events.AddZone(name: string, zone, callback, opts)
	opts = opts or {}
	triggers[name] = { zone = zone, callback = callback, once = opts.once ~= false, condition = opts.condition, fired = {} }
end

function Events.RemoveZone(name: string)
	triggers[name] = nil
end

local function pollTriggers()
	if not Run.IsPlaying() then
		return
	end
	for name, trig in triggers do
		if trig.condition == nil or trig.condition() then
			for _, entry in Run.Characters(true) do
				if inside(trig.zone, entry.root.Position) and not trig.fired[entry.player] then
					if trig.once then
						triggers[name] = nil
					else
						trig.fired[entry.player] = true
					end
					task.spawn(trig.callback, entry.player)
					break
				end
			end
		end
	end
end

----------------------------------------------------------------------------------------
-- Random events
----------------------------------------------------------------------------------------

local WHISPERS = {
	"...ابقَ معنا...",
	"...سجّل وصولك... ولا تغادر أبدًا...",
	"...إنها في 307...",
	"...أطفئ النور...",
	"...إنه يسمع أنفاسك...",
	"...الفندق لا ينسى...",
}

local function randomParticipant()
	local list = Run.Characters(false)
	if #list == 0 then
		return nil
	end
	return list[math.random(1, #list)]
end

local function offsetAround(pos: Vector3, minR: number, maxR: number): Vector3
	local a = math.random() * math.pi * 2
	local r = minR + math.random() * (maxR - minR)
	return pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
end

local randomEvents = {
	{
		weight = 4,
		run = function(entry)
			Power.Flicker(entry.root.Position, 34, 2 + math.random() * 2)
			Sounds.PlayAt("Static", entry.root.Position + Vector3.new(0, 8, 0), { Looped = false })
			return true
		end,
	},
	{
		weight = 3,
		run = function(entry) -- footsteps circling closer, then nothing
			local start = offsetAround(entry.root.Position, 26, 34)
			task.spawn(function()
				for i = 1, 7 do
					local p = start:Lerp(entry.root.Position, i / 12)
					Sounds.PlayAt("HeavyStep", p, { Volume = 0.6 + i * 0.08 })
					task.wait(0.55)
				end
			end)
			return true
		end,
	},
	{
		weight = 3,
		run = function(entry) -- a door nearby slams or creaks open
			local best = nil
			for _, door in Doors.Registry do
				if door.anchor and not door.locked and not door.barricaded and door.id ~= "FrontDoor" then
					local d = (door.anchor.Position - entry.root.Position).Magnitude
					if d > 7 and d < 40 then
						best = door
						if door.isOpen then
							break
						end
					end
				end
			end
			if not best then
				return false
			end
			if best.isOpen then
				Doors.SetOpen(best, false, nil, { slam = true })
			else
				Doors.SetOpen(best, true, nil, {})
				Sounds.Play("Creak", best.anchor)
			end
			return true
		end,
	},
	{
		weight = 2,
		run = function()
			return Elevator.Ghost()
		end,
	},
	{
		weight = 3,
		run = function(entry)
			Sounds.PlayAt("Whisper", offsetAround(entry.root.Position, 3, 6) + Vector3.new(0, 4, 0))
			Run.Cinematic(entry.player, "Whisper", { text = WHISPERS[math.random(1, #WHISPERS)], quiet = true })
			return true
		end,
	},
	{
		weight = 2,
		run = function(entry) -- a painting falls off the wall
			for _, painting in CollectionService:GetTagged("Painting") do
				if painting:IsA("Model") and not painting:GetAttribute("Fallen") and painting:IsDescendantOf(workspace) then
					local pivot = painting:GetPivot()
					if (pivot.Position - entry.root.Position).Magnitude < 28 then
						painting:SetAttribute("Fallen", true)
						local value = Instance.new("CFrameValue")
						value.Value = pivot
						value.Changed:Connect(function(cf)
							painting:PivotTo(cf)
						end)
						local floorY = Config.Floors[Config.FloorAt(pivot.Position.Y)]
						local target = CFrame.new(pivot.Position.X, floorY + 0.6, pivot.Position.Z) * (pivot - pivot.Position) * CFrame.new(0, 0, -0.8) * CFrame.Angles(math.rad(-75), 0, 0)
						local tween = TweenService:Create(value, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = target })
						tween.Completed:Connect(function()
							value:Destroy()
							Sounds.PlayAt("Crash", target.Position)
						end)
						tween:Play()
						return true
					end
				end
			end
			return false
		end,
	},
	{
		weight = 2,
		run = function(entry) -- a phone rings somewhere
			for _, phone in CollectionService:GetTagged("Phone") do
				local base = phone:FindFirstChild("Base")
				if base and (base.Position - entry.root.Position).Magnitude < 70 and not Events.PhoneBusy then
					task.spawn(function()
						for _ = 1, 4 do
							Sounds.Play("PhoneRing", base)
							task.wait(1.4)
						end
					end)
					return true
				end
			end
			return false
		end,
	},
	{
		weight = 1,
		run = function(entry)
			Sounds.PlayAt("Scream", offsetAround(entry.root.Position, 60, 80), { Volume = 0.8 })
			return true
		end,
	},
	{
		weight = 1,
		run = function()
			for _, chandelier in CollectionService:GetTagged("Chandelier") do
				if chandelier:IsDescendantOf(workspace) and math.random() < 0.5 then
					local pivot = chandelier:GetPivot()
					local value = Instance.new("CFrameValue")
					value.Value = pivot
					value.Changed:Connect(function(cf)
						chandelier:PivotTo(cf)
					end)
					local tween = TweenService:Create(value, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 2, true), {
						Value = pivot * CFrame.Angles(math.rad(6), 0, math.rad(4)),
					})
					tween.Completed:Connect(function()
						value:Destroy()
					end)
					tween:Play()
					return true
				end
			end
			return false
		end,
	},
}

local function randomEvent()
	local entry = randomParticipant()
	if not entry or not Run.Flag("entered") then
		return
	end
	local total = 0
	for _, e in randomEvents do
		total += e.weight
	end
	for _ = 1, 4 do
		local r = math.random() * total
		for _, e in randomEvents do
			r -= e.weight
			if r <= 0 then
				local ok, result = pcall(e.run, entry)
				if ok and result then
					return
				end
				break
			end
		end
	end
end

----------------------------------------------------------------------------------------
-- Scripted sequences
----------------------------------------------------------------------------------------

function Events.EntranceSlam()
	local door = Doors.Get("FrontDoor")
	if not door then
		return
	end
	task.wait(1.2)
	Run.Cinematic(nil, "LookAt", { position = door.cf.Position + Vector3.new(0, 5, 0), duration = 2.4 })
	task.wait(0.6)
	Doors.SetOpen(door, false, nil, { slam = true })
	Doors.Lock(door, "انصفقت الأبواب خلفك. لن تُفتح مرة أخرى.")
	Run.Cinematic(nil, "Shake", { intensity = 0.6, duration = 0.6 })
	Power.Flicker(nil, nil, 1.2, "Ext")
	task.wait(1.5)
	Run.Cinematic(nil, "Subtitle", { text = "انصفقت الأبواب. لا طريق للعودة.", duration = 4 })
end

function Events.PowerOn(instant: boolean?)
	Run.Flags.power = true
	if instant then
		for _, zone in { "G", "F1", "F2", "F3", "Lift" } do
			Power.SetZone(zone, true)
		end
		return
	end
	Run.Cinematic(nil, "Shake", { intensity = 0.25, duration = 0.8 })
	Power.SetZone("G", true, true)
	task.wait(1.2)
	Power.SetZone("F1", true)
	Power.SetZone("F2", true)
	Power.SetZone("F3", true)
	Power.SetZone("Lift", true)
	Run.Cinematic(nil, "Subtitle", { text = "في مكان ما فوقك، يعود الفندق كله إلى الحياة بطنين خافت.", duration = 4 })
	-- the elevator opens by itself in the hall
	task.wait(7)
	if not Elevator.Busy then
		Sounds.Play("Ding", Elevator.Landings.G and Elevator.Landings.G.indicatorPart)
		Elevator.SetDoors("G", true)
		for _, entry in Run.Characters(false) do
			if (entry.root.Position - Vector3.new(0, 0, 30)).Magnitude < 45 then
				Run.Cinematic(entry.player, "LookAt", { position = Vector3.new(0, 5, 36), duration = 2 })
			end
		end
		Run.Notify(nil, "انفتحت أبواب المصعد... ولم يضغط أحد الزر.", "info")
	end
end

-- First arrival on the third floor: a shadow stands at the end of the corridor.
function Events.ShadowCorridor()
	local refs = hotelRefs()
	local Rig = require(Monsters.Rig)
	local apparition = Rig.Shadow()
	for _, d in apparition:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	local far = refs.F3FarEnd
	apparition:PivotTo(CFrame.lookAt(far + Vector3.new(0, 4.6, 0), far + Vector3.new(10, 4.6, 0)))
	apparition.Parent = Run.Map and Run.Map:FindFirstChild("Monsters") or workspace
	local viewers = {}
	for _, entry in Run.Characters(true) do
		if entry.root.Position.Y > Config.Floors.F3 - 2 then
			table.insert(viewers, entry.player)
		end
	end
	task.wait(1.5)
	Run.Cinematic(viewers, "LookAt", { position = far + Vector3.new(0, 6, 0), duration = 3 })
	Sounds.Play("Growl", apparition:FindFirstChild("Head"))
	task.wait(2)
	-- lights die one by one toward the players
	Power.SetZone("F3", false, true)
	task.wait(1.2)
	apparition:Destroy()
	task.wait(2.5)
	Power.SetZone("F3", true, true)
	Run.Cinematic(viewers, "Subtitle", { text = "لقد رآك. أبقِ ضوءك منخفضًا... وخطواتك هادئة.", duration = 5 })
	task.wait(6)
	if monsters().ShadowMode() == "off" then
		monsters().SetShadowMode("upper")
	end
end

-- The Roomkeeper's face in the mirror of Room 307.
function Events.MirrorScare()
	local refs = hotelRefs()
	local glass, backing = refs.MirrorGlass, refs.MirrorBacking
	if not glass or not backing then
		return
	end
	local viewers = {}
	for _, entry in Run.Characters(true) do
		if (entry.root.Position - glass.Position).Magnitude < 30 then
			table.insert(viewers, entry.player)
		end
	end
	Run.Cinematic(viewers, "Focus", { cf = refs.MirrorViewCF, duration = 3.4 })
	task.wait(1.2)
	local Rig = require(Monsters.Rig)
	local figure = Rig.Roomkeeper()
	for _, d in figure:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	figure:PivotTo(refs.MirrorFigure + Vector3.new(0, 3.4, 0))
	figure.Parent = Run.Map and Run.Map:FindFirstChild("Monsters") or workspace
	backing.Transparency = 1
	backing.CanCollide = false
	local oldT = glass.Transparency
	glass.Transparency = 0.75
	Sounds.Play("Scream", glass)
	Run.Cinematic(viewers, "Scare", { color = Color3.fromRGB(255, 255, 255) })
	task.wait(0.9)
	figure:Destroy()
	backing.Transparency = 0
	backing.CanCollide = true
	glass.Transparency = oldT
	Power.Flicker(glass.Position, 30, 1.5)
	Run.Cinematic(viewers, "Subtitle", { text = "غرفة لينا. لا بد أن مذكراتها هنا في مكان ما.", duration = 4 })
end

-- Mission "Unlock the basement": the reception phone rings until somebody answers.
function Events.PhoneCall()
	local refs = hotelRefs()
	local phone = refs.ReceptionPhone
	if not phone or Events.PhoneBusy then
		return
	end
	Events.PhoneBusy = true
	local answered = false
	local prompt
	prompt = Interact.Add(phone, { text = "أجب", object = "هاتف الاستقبال", dist = 8, los = false }, function(player)
		if answered then
			return
		end
		answered = true
		prompt:Destroy()
		Run.Cinematic(player, "Focus", { cf = CFrame.lookAt(Vector3.new(0, 5.4, -4), Vector3.new(0, 5, 6.5)), duration = 9 })
		local m = monsters()
		if m.Concierge then
			m.Concierge:Show(refs.ConciergeDesk, 9, true)
		end
		local lines = {
			"«مساء الخير. فندق غراند أوريليا يشكرك على صبرك.»",
			"«المفتاح الذي تبحث عنه ينتظرك عند المكتب.»",
			"«انتبه للدرج. شيء ما يعيش هناك في الأسفل... وهو جائع جدًا.»",
		}
		for _, line in lines do
			Run.Cinematic(nil, "Subtitle", { text = line, duration = 3, voice = true })
			task.wait(3)
		end
		Pickups.Add(Run.Map, refs.DeskKeyCF, "BasementKey")
		Power.Flicker(nil, nil, 2.5, "G")
		Events.PhoneBusy = false
	end)
	task.spawn(function()
		local rings = 0
		while not answered and Run.IsPlaying() and phone.Parent do
			Sounds.Play("PhoneRing", phone)
			rings += 1
			if rings % 8 == 1 then
				Run.Notify(nil, "الهاتف في الاستقبال يرنّ...", "info")
			end
			task.wait(2.2)
		end
	end)
end

function Events.Room308Opens()
	Doors.Unlock("Room308")
	task.wait(0.8)
	Doors.SetOpen("Room308", true, nil, {})
	local door = Doors.Get("Room308")
	if door and door.anchor then
		Sounds.Play("Creak", door.anchor)
		Sounds.Play("Whisper", door.anchor)
	end
end

function Events.BasementDark(players)
	Run.Cinematic(players, "Subtitle", { text = "الظلام هنا يتنفّس. ابحث عن المولّد.", duration = 5 })
end

function Events.HeartReveal(players)
	local refs = hotelRefs()
	if refs.HeartCore then
		Run.Cinematic(players, "LookAt", { position = refs.HeartCore.Position, duration = 2.5 })
		Run.Cinematic(players, "Subtitle", { text = "قلب الفندق. ينبض وكأنه كائن حي.", duration = 5 })
	end
end

function Events.Reset()
	triggers = {}
	Events.PhoneBusy = false
end

----------------------------------------------------------------------------------------
-- Loops
----------------------------------------------------------------------------------------

function Events.Init()
	task.spawn(function()
		while true do
			task.wait(0.25)
			local ok, err = pcall(pollTriggers)
			if not ok then
				warn("[Events] trigger error:", err)
			end
		end
	end)
	-- randomized horror events
	task.spawn(function()
		while true do
			local rate = Run.Diff().eventRate
			task.wait(math.random(22, 48) / rate)
			if Run.IsPlaying() then
				randomEvent()
			end
		end
	end)
	-- lightning (synced for every client, lobby included)
	task.spawn(function()
		while true do
			task.wait(math.random(14, 38))
			Net.Event("Cinematic"):FireAllClients("Lightning", { seed = math.random(1, 1000) })
		end
	end)
	-- the Heart pulses; the facade sign sputters
	task.spawn(function()
		while true do
			task.wait(1.15)
			local refs = hotelRefs()
			local core = refs.HeartCore
			if core and core.Parent and not refs.HeartDead then
				local base = refs.HeartBase or core.Size
				refs.HeartBase = base
				TweenService:Create(core, TweenInfo.new(0.12), { Size = base * 1.12 }):Play()
				task.delay(0.15, function()
					TweenService:Create(core, TweenInfo.new(0.5), { Size = base }):Play()
				end)
				if refs.HeartLight then
					refs.HeartLight.Brightness = 3
					task.delay(0.2, function()
						refs.HeartLight.Brightness = 1.6
					end)
				end
				if #Players:GetPlayers() > 0 then
					Sounds.Play("Heart", core)
				end
			end
			local sign = refs.FacadeSign
			if sign and math.random() < 0.12 then
				sign.Text = ({ "غراند أو  ليا", "غرا د أوريليا", "غراند أوريليا", "   ند أوري  ا" })[math.random(1, 4)]
				task.delay(0.3, function()
					sign.Text = "غراند أوريليا"
				end)
			end
		end
	end)
end

return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Hiding</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Hiding in wardrobes, lockers and under beds. While hidden the character is anchored
-- inside the spot and made invisible; monsters ignore hidden players unless they SAW the
-- player hide (within a short window), in which case they drag them out.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Sounds = require(Shared.Sounds)
local Signal = require(Shared.Signal)

local Run = require(script.Parent.Run)
local Interact = require(script.Parent.Interact)

local Hiding = {}
Hiding.Spots = {} :: { any }
Hiding.Entered = Signal.new() -- (player, spot)
Hiding.Exited = Signal.new() -- (player, spot, forced)

local occupant: { [any]: Player } = {}
local spotOf: { [Player]: any } = {}
local hiddenAt: { [Player]: number } = {}

local function swingDoors(spot, open: boolean)
	for _, name in { "DoorL", "DoorR" } do
		local door = spot.model:FindFirstChild(name)
		if door then
			local closed = door:GetAttribute("ClosedCF")
			local sign = name == "DoorL" and 1 or -1
			local hingeX = (name == "DoorL" and -door.Size.X / 2 or door.Size.X / 2)
			local target = closed
			if open then
				target = closed * CFrame.new(hingeX, 0, 0) * CFrame.Angles(0, sign * math.rad(70), 0) * CFrame.new(-hingeX, 0, 0)
			end
			TweenService:Create(door, TweenInfo.new(0.25), { CFrame = target }):Play()
			-- decorative children follow (panel + knob)
			for _, d in spot.model:GetChildren() do
				if d:GetAttribute("Door") == name and d:IsA("BasePart") then
					local rel = d:GetAttribute("Rel")
					if not rel then
						rel = closed:ToObjectSpace(d.CFrame)
						d:SetAttribute("Rel", rel)
					end
					TweenService:Create(d, TweenInfo.new(0.25), { CFrame = target * rel }):Play()
				end
			end
		end
	end
end

local function setVisible(character: Model, visible: boolean)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			if visible then
				local original = d:GetAttribute("HideOriginalT")
				if original ~= nil then
					d.Transparency = original
					d:SetAttribute("HideOriginalT", nil)
				end
			else
				if d:GetAttribute("HideOriginalT") == nil then
					d:SetAttribute("HideOriginalT", d.Transparency)
				end
				d.Transparency = 1
			end
		elseif d:IsA("Decal") then
			d.Transparency = visible and 0 or 1
		end
	end
end

function Hiding.Enter(player: Player, spot)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not root or occupant[spot] or spotOf[player] then
		return
	end
	occupant[spot] = player
	spotOf[player] = spot
	hiddenAt[player] = os.clock()
	root.Anchored = true
	character:PivotTo(spot.hide.CFrame)
	character:SetAttribute("Hidden", true)
	character:SetAttribute("HiddenSince", workspace:GetServerTimeNow())
	setVisible(character, false)
	if spot.kind == "wardrobe" then
		swingDoors(spot, true)
		task.delay(0.35, function()
			swingDoors(spot, false)
		end)
		Sounds.Play("Creak", spot.hide)
	else
		Sounds.Play("Footstep", spot.hide)
	end
	spot.prompt.ActionText = "اخرج"
	Net.Event("Cinematic"):FireClient(player, "HideView", { cf = spot.view.CFrame, kind = spot.kind })
	Hiding.Entered:Fire(player, spot)
end

function Hiding.Exit(player: Player, forced: boolean?)
	local spot = spotOf[player]
	if not spot then
		return
	end
	occupant[spot] = nil
	spotOf[player] = nil
	hiddenAt[player] = nil
	spot.prompt.ActionText = "اختبئ"
	local character = player.Character
	if character then
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		character:SetAttribute("Hidden", false)
		setVisible(character, true)
		character:PivotTo(spot.exit.CFrame)
		if root then
			root.Anchored = false
		end
	end
	if spot.kind == "wardrobe" then
		swingDoors(spot, true)
		task.delay(0.6, function()
			swingDoors(spot, false)
		end)
		Sounds.Play(forced and "DoorSlam" or "Creak", spot.hide)
	end
	Net.Event("Cinematic"):FireClient(player, "Unhide", { forced = forced })
	Hiding.Exited:Fire(player, spot, forced)
end

function Hiding.IsHidden(player: Player): boolean
	return spotOf[player] ~= nil
end

function Hiding.SpotOf(player: Player)
	return spotOf[player]
end

-- Seconds since the player hid (nil if not hidden).
function Hiding.HiddenFor(player: Player): number?
	local t = hiddenAt[player]
	return t and os.clock() - t or nil
end

function Hiding.Add(model: Model)
	local hide = model:FindFirstChild("HideSpot")
	local exit = model:FindFirstChild("ExitPoint")
	local view = model:FindFirstChild("ViewPoint")
	if not hide or not exit or not view then
		warn("[Hiding] model missing hide markers", model:GetFullName())
		return
	end
	local kind = model:GetAttribute("HideKind") or "wardrobe"
	local spot = { model = model, hide = hide, exit = exit, view = view, kind = kind }
	-- prompt sits in front of the furniture
	local anchor = Interact.Anchor(model, exit.Position + Vector3.new(0, kind == "bed" and -1.5 or 1, 0) + (hide.Position - exit.Position) * 0.45, "HidePrompt")
	spot.prompt = Interact.Add(anchor, {
		text = "اختبئ",
		object = kind == "bed" and "تحت السرير" or (model.Name == "Locker" and "خزانة معدنية" or "خزانة ملابس"),
		dist = 7,
		los = false,
		allowHidden = true,
		hold = 0,
	}, function(player)
		if spotOf[player] == spot then
			Hiding.Exit(player, false)
		elseif not spotOf[player] then
			if occupant[spot] then
				Run.Notify(player, "هناك من يختبئ هنا بالفعل.", "info")
				return
			end
			Hiding.Enter(player, spot)
		end
	end)
	table.insert(Hiding.Spots, spot)
	return spot
end

function Hiding.Init()
	Net.Event("Hide").OnServerEvent:Connect(function(player)
		if Net.Allow(player, "hide", 0.4) then
			Hiding.Exit(player, false)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		local spot = spotOf[player]
		if spot then
			occupant[spot] = nil
			spotOf[player] = nil
		end
	end)
end

-- Called when a character dies/respawns so stale state never blocks a spot.
function Hiding.Clear(player: Player)
	local spot = spotOf[player]
	if spot then
		occupant[spot] = nil
		spotOf[player] = nil
		spot.prompt.ActionText = "اختبئ"
	end
	hiddenAt[player] = nil
end

function Hiding.Reset()
	Hiding.Spots = {}
	occupant = {}
	spotOf = {}
	hiddenAt = {}
end

return Hiding
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Interact</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Server-authoritative interaction layer built on ProximityPrompts (works on PC, mobile,
-- tablet and gamepad). Clients draw the prompts with a custom style (see client/Prompts).
-- Every trigger is re-validated here: alive, not downed, not hidden, in range, rate limited.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)
local Run = require(script.Parent.Run)

local Interact = {}

local function positionOf(parent: Instance): Vector3
	if parent:IsA("Attachment") then
		return parent.WorldPosition
	elseif parent:IsA("BasePart") then
		return parent.Position
	elseif parent:IsA("Model") then
		return parent:GetPivot().Position
	end
	return Vector3.zero
end

function Interact.CanAct(player: Player, def): boolean
	local character = player.Character
	if not character then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	if character:GetAttribute("Downed") and not def.allowDowned then
		return false
	end
	if character:GetAttribute("Hidden") and not def.allowHidden then
		return false
	end
	if not def.anyState and not Run.IsPlaying() then
		return false
	end
	return true
end

-- def: text, object, hold, dist, los, allowHidden, allowDowned, anyState, name
function Interact.Add(parent: Instance, def, callback: (Player, ProximityPrompt) -> ()): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = def.name or "Interact"
	prompt.ActionText = def.text or "تفاعل"
	prompt.ObjectText = def.object or ""
	prompt.HoldDuration = def.hold or 0
	prompt.MaxActivationDistance = def.dist or 8
	prompt.RequiresLineOfSight = def.los ~= false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.OneGlobally
	prompt.Parent = parent
	prompt.Triggered:Connect(function(player: Player)
		if not Interact.CanAct(player, def) then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		if (root.Position - positionOf(parent)).Magnitude > prompt.MaxActivationDistance + 7 then
			return
		end
		if not Net.Allow(player, "interact", 0.2) then
			return
		end
		local ok, err = pcall(callback, player, prompt)
		if not ok then
			warn("[Interact] handler error:", err)
		end
	end)
	return prompt
end

-- Convenience: an invisible anchor part to hold a prompt at an exact position.
function Interact.Anchor(parent: Instance, position: Vector3, name: string?): BasePart
	local part = Instance.new("Part")
	part.Name = name or "PromptAnchor"
	part.Size = Vector3.new(0.6, 0.6, 0.6)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Position = position
	part.Parent = parent
	return part
end

return Interact
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Inventory</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Individual, server-owned inventories. Clients only ever receive read-only snapshots.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local Inventory = {}
Inventory.Data = {} :: { [Player]: { [string]: number } }
Inventory.Added = Signal.new() -- (player, itemId, count)

local function bag(player: Player)
	local data = Inventory.Data[player]
	if not data then
		data = {}
		Inventory.Data[player] = data
	end
	return data
end

function Inventory.Sync(player: Player)
	local list = {}
	for _, id in Items.Order do
		local count = bag(player)[id]
		if count and count > 0 then
			table.insert(list, { id = id, count = count })
		end
	end
	Net.Event("Inventory"):FireClient(player, list)
end

function Inventory.Count(player: Player, id: string): number
	return bag(player)[id] or 0
end

function Inventory.Has(player: Player, id: string): boolean
	return Inventory.Count(player, id) > 0
end

function Inventory.Add(player: Player, id: string, count: number?)
	if not Items[id] then
		warn("[Inventory] unknown item", id)
		return
	end
	local data = bag(player)
	local n = count or 1
	if not Items[id].stack then
		data[id] = 1
	else
		data[id] = (data[id] or 0) + n
	end
	Inventory.Sync(player)
	Inventory.Added:Fire(player, id, n)
end

function Inventory.Remove(player: Player, id: string, count: number?): boolean
	local data = bag(player)
	local have = data[id] or 0
	local n = count or 1
	if have < n then
		return false
	end
	data[id] = have - n
	if data[id] <= 0 then
		data[id] = nil
	end
	Inventory.Sync(player)
	return true
end

-- Returns the first participant holding the item (team-wide checks).
function Inventory.Holder(id: string): Player?
	for player, data in Inventory.Data do
		if player.Parent and (data[id] or 0) > 0 then
			return player
		end
	end
	return nil
end

function Inventory.Snapshot(player: Player): { [string]: number }
	return table.clone(bag(player))
end

function Inventory.Load(player: Player, snapshot: { [string]: number }?)
	local data = {}
	if snapshot then
		for id, count in snapshot do
			if Items[id] and typeof(count) == "number" and count > 0 then
				data[id] = math.floor(count)
			end
		end
	end
	Inventory.Data[player] = data
	Inventory.Sync(player)
end

function Inventory.Clear(player: Player)
	Inventory.Data[player] = {}
	if player.Parent then
		Inventory.Sync(player)
	end
end

function Inventory.Forget(player: Player)
	Inventory.Data[player] = nil
end

return Inventory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Missions</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Story progression. Missions are completed by story flags, item pickups and documents.
-- Conditions met early (out of order) are remembered and complete instantly when their
-- mission becomes active, so co-op players can split up freely.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local MissionDefs = require(Shared.Missions)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local Run = require(script.Parent.Run)
local Inventory = require(script.Parent.Inventory)

local Missions = {}
Missions.Index = 0
Missions.DoneIndex = 0
Missions.Satisfied = {} :: { [string]: boolean }
Missions.Completed = Signal.new() -- (id, index)
Missions.Started = Signal.new() -- (id, index)

local startHooks: { [string]: { (boolean) -> () } } = {}
local completeHooks: { [string]: { () -> () } } = {}
local restoreHooks: { [string]: { () -> () } } = {}

local FLAG_TO_MISSION = {
	entered = "enter",
	power = "power",
	mirror = "room307",
	basementOpen = "basement",
	generator = "generator",
	labEntered = "lab",
	escaped = "exit",
}
local ITEM_TO_MISSION = {
	ReceptionKey = "reception_key",
	ElevatorCard = "elevator_card",
}

function Missions.OnStart(id: string, fn: (boolean) -> ())
	startHooks[id] = startHooks[id] or {}
	table.insert(startHooks[id], fn)
end

function Missions.OnComplete(id: string, fn: () -> ())
	completeHooks[id] = completeHooks[id] or {}
	table.insert(completeHooks[id], fn)
end

-- Effects to re-apply when a saved run is continued past this mission.
function Missions.OnRestore(id: string, fn: () -> ())
	restoreHooks[id] = restoreHooks[id] or {}
	table.insert(restoreHooks[id], fn)
end

function Missions.Current()
	return MissionDefs[Missions.Index]
end

function Missions.IsDone(id: string): boolean
	for i, def in MissionDefs do
		if def.id == id then
			return i < Missions.Index or (i == Missions.Index and Missions.Satisfied[id] == true)
		end
	end
	return false
end

local function progressText(def): string?
	if not def then
		return nil
	end
	if def.id == "documents" then
		return string.format("المذكرات التي وُجدت: %d/3", Run.JournalCount())
	end
	return nil
end

function Missions.Broadcast(player: Player?)
	local def = Missions.Current()
	local remote = Net.Event("Objective")
	local id = def and def.id or ""
	local progress = progressText(def)
	if player then
		remote:FireClient(player, Missions.Index, id, progress)
	else
		for p in Run.Participants do
			if p.Parent then
				remote:FireClient(p, Missions.Index, id, progress)
			end
		end
	end
end

local function runHooks(list, ...)
	for _, fn in list or {} do
		local ok, err = pcall(fn, ...)
		if not ok then
			warn("[Missions] hook error:", err)
		end
	end
end

function Missions.Start(index: number, restoring: boolean?)
	if not Run.IsPlaying() then
		return
	end
	Missions.Index = index
	local def = MissionDefs[index]
	if not def then
		return
	end
	Missions.Broadcast()
	Missions.Started:Fire(def.id, index)
	runHooks(startHooks[def.id], restoring == true)
	if Missions.Satisfied[def.id] then
		task.delay(1.5, Missions.Complete, def.id)
	end
end

function Missions.Complete(id: string)
	local def = Missions.Current()
	if not def or def.id ~= id or not Run.IsPlaying() then
		Missions.Satisfied[id] = true
		return
	end
	if Missions.DoneIndex == Missions.Index then
		return
	end
	Missions.DoneIndex = Missions.Index
	Missions.Satisfied[id] = true
	local index = Missions.Index
	Run.Notify(nil, "اكتملت المهمة: " .. def.title, "objective")
	runHooks(completeHooks[id])
	Missions.Completed:Fire(id, index)
	if index < #MissionDefs then
		task.delay(3, function()
			if Missions.Index == index and Run.IsPlaying() then
				Missions.Start(index + 1)
			end
		end)
	end
end

-- Re-applies effects of missions 1..index-1, then starts mission `index`.
function Missions.Restore(index: number)
	for i = 1, index - 1 do
		local def = MissionDefs[i]
		Missions.Satisfied[def.id] = true
		runHooks(restoreHooks[def.id])
	end
	Missions.Start(index, true)
end

function Missions.Reset()
	Missions.Index = 0
	Missions.DoneIndex = 0
	Missions.Satisfied = {}
end

function Missions.Init()
	Run.FlagChanged:Connect(function(name, value)
		local id = FLAG_TO_MISSION[name]
		if id and value then
			Missions.Complete(id)
		end
	end)
	Inventory.Added:Connect(function(_, itemId)
		local id = ITEM_TO_MISSION[itemId]
		if id then
			Missions.Complete(id)
		end
	end)
	Run.DocFound:Connect(function()
		local def = Missions.Current()
		if def and def.id == "documents" then
			Missions.Broadcast()
		end
		if Run.JournalCount() >= 3 then
			Missions.Complete("documents")
		end
	end)
end

return Missions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Pickups</string>
            <string name="Source"><![CDATA[--!nonstrict
-- World pickups (keys, cards, batteries...) and readable documents.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Items = require(Shared.Items)
local Documents = require(Shared.Documents)
local Sounds = require(Shared.Sounds)
local Net = require(Shared.Net)

local Build = require(script.Parent.Parent.Map.Build)
local Run = require(script.Parent.Run)
local Interact = require(script.Parent.Interact)
local Inventory = require(script.Parent.Inventory)

local Pickups = {}
Pickups.Active = {} :: { [string]: { Model } }
Pickups.OnDocument = nil :: ((Player, string) -> ())?

local C = Config.Palette
local M = Enum.Material
local D, Cyl, Ball = Build.D, Build.Cyl, Build.Ball

local function keyModel(m: Model, cf: CFrame, color: Color3)
	Cyl(m, 0.55, 0.12, cf * CFrame.new(-0.5, 0.06, 0), color, M.Metal, { decor = true })
	D(m, Vector3.new(0.9, 0.1, 0.14), cf * CFrame.new(0.15, 0.06, 0), color, M.Metal)
	D(m, Vector3.new(0.12, 0.1, 0.3), cf * CFrame.new(0.45, 0.06, 0.15), color, M.Metal)
	D(m, Vector3.new(0.12, 0.1, 0.22), cf * CFrame.new(0.3, 0.06, 0.12), color, M.Metal)
	D(m, Vector3.new(0.5, 0.04, 0.32), cf * CFrame.new(-0.95, 0.03, 0.1), C.Burgundy, M.Fabric)
end

local Visuals = {
	ReceptionKey = function(m, cf)
		keyModel(m, cf, C.Gold)
	end,
	Key307 = function(m, cf)
		keyModel(m, cf, Color3.fromRGB(150, 130, 100))
	end,
	BasementKey = function(m, cf)
		keyModel(m, cf, Color3.fromRGB(90, 90, 96))
	end,
	ElevatorCard = function(m, cf)
		D(m, Vector3.new(0.9, 0.04, 0.6), cf * CFrame.new(0, 0.03, 0), C.Gold, M.Foil)
		D(m, Vector3.new(0.9, 0.05, 0.12), cf * CFrame.new(0, 0.04, -0.18), C.Black, M.SmoothPlastic)
	end,
	Fuse = function(m, cf)
		Cyl(m, 0.45, 1, cf * CFrame.new(0, 0.25, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Bone, M.SmoothPlastic, { decor = true })
		for _, x in { -0.55, 0.55 } do
			Cyl(m, 0.5, 0.15, cf * CFrame.new(x, 0.25, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(170, 120, 70), M.Metal, { decor = true })
		end
	end,
	FuelCan = function(m, cf)
		D(m, Vector3.new(1.2, 1.6, 0.7), cf * CFrame.new(0, 0.8, 0), Color3.fromRGB(150, 24, 20), M.Metal)
		D(m, Vector3.new(0.8, 0.2, 0.2), cf * CFrame.new(0, 1.75, 0), C.Charcoal, M.Metal)
		D(m, Vector3.new(0.2, 0.4, 0.2), cf * CFrame.new(0.4, 1.8, 0) * CFrame.Angles(0, 0, -0.4), Color3.fromRGB(150, 24, 20), M.Metal)
	end,
	Locket = function(m, cf)
		Ball(m, 0.35, (cf * CFrame.new(0, 0.18, 0)).Position, Color3.fromRGB(200, 205, 215), M.Metal, { decor = true })
		D(m, Vector3.new(0.9, 0.03, 0.05), cf * CFrame.new(0.5, 0.03, 0.1) * CFrame.Angles(0, 0.6, 0), Color3.fromRGB(200, 205, 215), M.Metal)
	end,
	Battery = function(m, cf)
		Cyl(m, 0.4, 0.9, cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(30, 30, 32), M.SmoothPlastic, { decor = true })
		Cyl(m, 0.42, 0.25, cf * CFrame.new(0.35, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(200, 140, 60), M.Metal, { decor = true })
	end,
	Bandage = function(m, cf)
		D(m, Vector3.new(0.9, 0.35, 0.6), cf * CFrame.new(0, 0.18, 0), C.Bone, M.Fabric)
		D(m, Vector3.new(0.5, 0.37, 0.12), cf * CFrame.new(0, 0.18, 0), Color3.fromRGB(170, 20, 20), M.SmoothPlastic)
		D(m, Vector3.new(0.12, 0.37, 0.4), cf * CFrame.new(0, 0.18, 0), Color3.fromRGB(170, 20, 20), M.SmoothPlastic)
	end,
}

-- `cf` sits on the surface the item lies on.
function Pickups.Add(parent: Instance, cf: CFrame, itemId: string, opts)
	opts = opts or {}
	local def = Items[itemId]
	local m = Build.Model(parent, "Pickup_" .. itemId)
	m:SetAttribute("Item", itemId)
	local builder = Visuals[itemId]
	if builder then
		builder(m, cf)
	end
	local anchor = Interact.Anchor(m, (cf * CFrame.new(0, 0.4, 0)).Position, "Anchor")
	local glint = Instance.new("PointLight")
	glint.Range = 5
	glint.Brightness = 0.5
	glint.Color = Color3.fromRGB(255, 220, 160)
	glint.Shadows = false
	glint.Parent = anchor

	local list = Pickups.Active[itemId] or {}
	Pickups.Active[itemId] = list
	table.insert(list, m)

	Interact.Add(anchor, {
		text = "خذ",
		object = def.name,
		hold = opts.hold or 0.3,
		dist = opts.dist or 7,
	}, function(player)
		if not m.Parent then
			return
		end
		if not def.stack and Inventory.Has(player, itemId) then
			Run.Notify(player, "أنت تحمل " .. def.name .. " بالفعل.", "info")
			return
		end
		m:Destroy()
		local i = table.find(list, m)
		if i then
			table.remove(list, i)
		end
		Inventory.Add(player, itemId, opts.count or 1)
		Sounds.PlayAt("Pickup", anchor.Position)
		Run.Notify(player, "التقطت: " .. def.name, "item")
		if opts.onTaken then
			opts.onTaken(player)
		end
	end)
	return m
end

function Pickups.RemoveAll(itemId: string)
	for _, m in Pickups.Active[itemId] or {} do
		m:Destroy()
	end
	Pickups.Active[itemId] = {}
end

-- Drops a disconnected player's critical items where they stood.
function Pickups.DropCritical(player: Player, position: Vector3)
	local map = Run.Map
	if not map then
		return
	end
	local offset = 0
	for id, count in Inventory.Snapshot(player) do
		local teammateHas = false
		for other, data in Inventory.Data do
			if other ~= player and other.Parent and (data[id] or 0) > 0 then
				teammateHas = true
			end
		end
		if Items[id] and Items[id].critical and count > 0 and not teammateHas then
			-- only drop if no teammate already carries the same key
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { player.Character }
			local origin = position + Vector3.new(offset, 2, 0)
			local hit = workspace:Raycast(origin, Vector3.new(0, -20, 0), params)
			local ground = hit and hit.Position or (position - Vector3.new(0, 3, 0))
			Pickups.Add(map, CFrame.new(ground), id)
			offset += 1.2
		end
	end
end

----------------------------------------------------------------------------------------
-- Documents
----------------------------------------------------------------------------------------

function Pickups.Document(parent: Instance, cf: CFrame, docId: string)
	local doc = Documents[docId]
	assert(doc, "unknown document " .. docId)
	local m = Build.Model(parent, "Document_" .. docId)
	if doc.journal then
		D(m, Vector3.new(1.4, 0.35, 1.9), cf * CFrame.new(0, 0.18, 0), Color3.fromRGB(60, 22, 24), M.Leather)
		D(m, Vector3.new(1.3, 0.3, 1.8), cf * CFrame.new(0.06, 0.18, 0), C.Paper, M.SmoothPlastic)
		D(m, Vector3.new(0.3, 0.37, 1.92), cf * CFrame.new(-0.55, 0.18, 0), C.Gold, M.Metal)
	else
		D(m, Vector3.new(1.1, 0.04, 1.5), cf * CFrame.new(0, 0.03, 0) * CFrame.Angles(0, math.rad(8), 0), C.Paper, M.SmoothPlastic)
		D(m, Vector3.new(0.8, 0.045, 0.06), cf * CFrame.new(0, 0.05, -0.4) * CFrame.Angles(0, math.rad(8), 0), Color3.fromRGB(60, 50, 40), M.SmoothPlastic)
	end
	local anchor = Interact.Anchor(m, (cf * CFrame.new(0, 0.4, 0)).Position, "Anchor")
	local glint = Instance.new("PointLight")
	glint.Range = 4
	glint.Brightness = 0.35
	glint.Color = Color3.fromRGB(255, 236, 200)
	glint.Shadows = false
	glint.Parent = anchor
	Interact.Add(anchor, {
		text = "اقرأ",
		object = doc.title,
		dist = 7,
	}, function(player)
		Sounds.PlayAt("Paper", anchor.Position)
		Net.Event("Document"):FireClient(player, docId)
		local isNew = not Run.Docs[docId]
		if isNew then
			Run.Docs[docId] = true
			Run.Notify(nil, string.format("وُجدت وثيقة: %s (%d/%d)", doc.title, Run.DocCount(), Config.TotalDocuments), "doc")
			Run.DocFound:Fire(docId, player)
		end
		if Pickups.OnDocument then
			Pickups.OnDocument(player, docId)
		end
		glint.Enabled = false
	end)
	return m
end

function Pickups.Reset()
	Pickups.Active = {}
end

return Pickups
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Power</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Hotel electricity. Every light tagged "HotelLight" belongs to a zone (G, F1, F2, F3, B,
-- Escape). Zones are switched by story progress; lights can flicker, be faulty
-- (flicker forever) or switch to emergency red.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Power = {}
Power.Zones = {} :: { [string]: boolean }
Power.Lights = {} :: { Light }

local bulbs: { [Light]: { BasePart } } = {}
local flickering: { [Light]: boolean } = {}
local originalColor: { [Light]: Color3 } = {}

local function findBulbs(light: Light)
	local list = {}
	local parent = light.Parent
	if parent and parent:IsA("BasePart") and parent.Material == Enum.Material.Neon then
		table.insert(list, parent)
	end
	local model = parent and parent:FindFirstAncestorOfClass("Model")
	if model and model.Name ~= "Hotel" then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and d.Name == "Bulb" and not table.find(list, d) then
				table.insert(list, d)
			end
		end
	end
	return list
end

local function setVisual(light: Light, on: boolean)
	light.Enabled = on
	for _, bulb in bulbs[light] or {} do
		bulb.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
		bulb.Transparency = on and 0 or 0.2
	end
end

local function register(light: Instance)
	if not light:IsA("Light") or bulbs[light] then
		return
	end
	bulbs[light] = findBulbs(light)
	originalColor[light] = light.Color
	table.insert(Power.Lights, light)
	local zone = light:GetAttribute("Zone")
	setVisual(light, zone ~= nil and Power.Zones[zone] == true)
end

function Power.Init()
	CollectionService:GetInstanceAddedSignal("HotelLight"):Connect(register)
	CollectionService:GetInstanceRemovedSignal("HotelLight"):Connect(function(light)
		bulbs[light] = nil
		flickering[light] = nil
		originalColor[light] = nil
		local i = table.find(Power.Lights, light)
		if i then
			table.remove(Power.Lights, i)
		end
	end)
	-- faulty lights flicker on their own forever
	task.spawn(function()
		while true do
			task.wait(0.12)
			for _, light in Power.Lights do
				if light:GetAttribute("Faulty") and not flickering[light] and Power.Zones[light:GetAttribute("Zone")] then
					if math.random() < 0.18 then
						setVisual(light, not light.Enabled)
					elseif not light.Enabled and math.random() < 0.5 then
						setVisual(light, true)
					end
				end
			end
		end
	end)
end

-- Registers lights that already exist (call after the map is built).
function Power.Scan()
	for _, light in CollectionService:GetTagged("HotelLight") do
		register(light)
	end
end

function Power.IsOn(zone: string): boolean
	return Power.Zones[zone] == true
end

function Power.SetZone(zone: string, on: boolean, sweep: boolean?)
	Power.Zones[zone] = on
	local list = {}
	for _, light in Power.Lights do
		if light:GetAttribute("Zone") == zone then
			table.insert(list, light)
		end
	end
	if sweep then
		-- lights come on (or die) one after another, which reads beautifully in corridors
		table.sort(list, function(a, b)
			local pa = a.Parent and a.Parent:IsA("BasePart") and a.Parent.Position or Vector3.zero
			local pb = b.Parent and b.Parent:IsA("BasePart") and b.Parent.Position or Vector3.zero
			return pa.X < pb.X
		end)
		task.spawn(function()
			for _, light in list do
				if Power.Zones[zone] == on then
					setVisual(light, on)
					task.wait(0.06)
				end
			end
		end)
	else
		for _, light in list do
			setVisual(light, on)
		end
	end
end

-- Flickers powered lights within `radius` of `center` (or in `zone`) for `duration` seconds.
function Power.Flicker(center: Vector3?, radius: number?, duration: number, zone: string?)
	local targets = {}
	for _, light in Power.Lights do
		local z = light:GetAttribute("Zone")
		if Power.Zones[z] and not flickering[light] and (zone == nil or z == zone) then
			local parent = light.Parent
			local pos = parent and parent:IsA("BasePart") and parent.Position
			if center == nil or (pos and (pos - center).Magnitude <= (radius or 30)) then
				table.insert(targets, light)
			end
		end
	end
	for _, light in targets do
		flickering[light] = true
	end
	task.spawn(function()
		local t = 0
		while t < duration do
			for _, light in targets do
				if light.Parent then
					setVisual(light, math.random() < 0.45)
				end
			end
			local step = 0.05 + math.random() * 0.12
			task.wait(step)
			t += step
		end
		for _, light in targets do
			flickering[light] = nil
			if light.Parent then
				setVisual(light, Power.Zones[light:GetAttribute("Zone")] == true)
			end
		end
	end)
end

-- Kills all lights in a radius briefly (used when the Shadow passes by).
function Power.Blackout(center: Vector3, radius: number, duration: number)
	local targets = {}
	for _, light in Power.Lights do
		local parent = light.Parent
		if not flickering[light] and parent and parent:IsA("BasePart") and (parent.Position - center).Magnitude <= radius and light.Enabled then
			table.insert(targets, light)
			flickering[light] = true
			setVisual(light, false)
		end
	end
	task.delay(duration, function()
		for _, light in targets do
			flickering[light] = nil
			if light.Parent then
				setVisual(light, Power.Zones[light:GetAttribute("Zone")] == true)
			end
		end
	end)
end

function Power.Emergency(zone: string, on: boolean)
	for _, light in Power.Lights do
		if light:GetAttribute("Zone") == zone then
			light.Color = on and Config.Palette.Emergency or (originalColor[light] or light.Color)
		end
	end
end

function Power.Reset()
	Power.Zones = { Ext = true }
	Power.Lights = {}
	bulbs = {}
	flickering = {}
	originalColor = {}
end

Power.Reset()

return Power
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Puzzles</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Interactive puzzle objects: keypads/safes, breaker, library books, generator,
-- secret bookcase, loose wall panel. Puzzles only set story flags on Run; the Missions
-- service reacts to those flags.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Sounds = require(Shared.Sounds)

local Build = require(script.Parent.Parent.Map.Build)
local Run = require(script.Parent.Run)
local Interact = require(script.Parent.Interact)
local Inventory = require(script.Parent.Inventory)
local Power = require(script.Parent.Power)

local Puzzles = {}
Puzzles.Keypads = {} :: { [string]: any }

local C = Config.Palette
local M = Enum.Material

----------------------------------------------------------------------------------------
-- Keypads (also used for safes)
----------------------------------------------------------------------------------------

-- `cf` on the wall surface, facing out. opts: id, code, title, zone (power zone needed), onSolved
function Puzzles.Keypad(parent: Instance, cf: CFrame, opts)
	local m = Build.Model(parent, "Keypad_" .. opts.id)
	Build.D(m, Vector3.new(1.3, 1.9, 0.2), cf * CFrame.new(0, 0, -0.1), Color3.fromRGB(46, 46, 48), M.Metal)
	local screen = Build.D(m, Vector3.new(1, 0.35, 0.05), cf * CFrame.new(0, 0.6, -0.22), Color3.fromRGB(40, 10, 10), M.Neon, { name = "Screen" })
	for row = 0, 3 do
		for col = 0, 2 do
			Build.D(m, Vector3.new(0.24, 0.2, 0.08), cf * CFrame.new(-0.3 + col * 0.3, 0.15 - row * 0.27, -0.22), Color3.fromRGB(150, 150, 150), M.Metal)
		end
	end
	local keypad = { id = opts.id, code = opts.code, title = opts.title or "لوحة الأرقام", zone = opts.zone, solved = false, model = m, screen = screen, onSolved = opts.onSolved, cf = cf }
	Puzzles.Keypads[opts.id] = keypad
	local anchor = Interact.Anchor(m, (cf * CFrame.new(0, 0, -0.6)).Position, "Anchor")
	keypad.anchor = anchor
	keypad.prompt = Interact.Add(anchor, { text = "أدخل الرمز", object = keypad.title, dist = 6 }, function(player)
		if keypad.solved then
			Run.Notify(player, "إنه مفتوح بالفعل.", "info")
			return
		end
		if keypad.zone and not Power.IsOn(keypad.zone) then
			Run.Notify(player, "لوحة الأرقام ميتة. لا توجد كهرباء.", "warn")
			Sounds.Play("Locked", anchor)
			return
		end
		Net.Event("Keypad"):FireClient(player, keypad.id, keypad.title, #keypad.code)
	end)
	return keypad
end

function Puzzles.SolveKeypad(id: string, player: Player?)
	local keypad = Puzzles.Keypads[id]
	if not keypad or keypad.solved then
		return
	end
	keypad.solved = true
	keypad.screen.Color = Color3.fromRGB(40, 200, 90)
	keypad.prompt.Enabled = false
	Sounds.Play("Unlock", keypad.anchor)
	if keypad.onSolved then
		keypad.onSolved(player)
	end
end

----------------------------------------------------------------------------------------
-- Breaker panel (mission: restore electricity)
----------------------------------------------------------------------------------------

function Puzzles.Breaker(parent: Instance, cf: CFrame)
	local m = Build.Model(parent, "Breaker")
	Build.P(m, Vector3.new(4, 5, 1), cf * CFrame.new(0, 5, -0.5), Color3.fromRGB(70, 74, 72), M.Metal)
	Build.D(m, Vector3.new(3.4, 4.4, 0.1), cf * CFrame.new(0, 5, -1.02), Color3.fromRGB(40, 42, 40), M.Metal)
	for i = 0, 5 do
		Build.D(m, Vector3.new(0.4, 0.6, 0.15), cf * CFrame.new(-1.2 + (i % 3) * 0.6, 6.2 - math.floor(i / 3) * 0.9, -1.1), C.Bone, M.SmoothPlastic)
	end
	local slot = Build.D(m, Vector3.new(0.6, 1, 0.15), cf * CFrame.new(0.9, 4, -1.1), Color3.fromRGB(10, 10, 10), M.SmoothPlastic, { name = "FuseSlot" })
	local lever = Build.D(m, Vector3.new(0.3, 1.6, 0.3), cf * CFrame.new(2.4, 5.6, -0.8) * CFrame.Angles(math.rad(-40), 0, 0), C.Emergency, M.Metal, { name = "Lever" })
	Build.Text(m, Vector3.new(3, 0.5, 0.05), cf * CFrame.new(0, 7.8, -1.05), "القاطع الرئيسي", { bg = Color3.fromRGB(200, 170, 40), color = C.Black, font = Enum.Font.GothamBold })
	local fused = false
	local anchor = Interact.Anchor(m, (cf * CFrame.new(0.9, 4.6, -1.6)).Position, "Anchor")
	local prompt
	prompt = Interact.Add(anchor, { text = "افحص", object = "القاطع الرئيسي", dist = 7, hold = 0.4 }, function(player)
		if Run.Flag("power") then
			return
		end
		if not fused then
			if Inventory.Remove(player, "Fuse", 1) then
				fused = true
				Build.D(m, Vector3.new(0.4, 0.9, 0.2), slot.CFrame * CFrame.new(0, 0, -0.05), C.Bone, M.SmoothPlastic)
				Sounds.Play("Click", anchor)
				prompt.ActionText = "اسحب الذراع"
				prompt.HoldDuration = 1.2
				Run.Notify(player, "استقر الفيوز في مكانه. الآن الذراع.", "item")
			else
				Run.Notify(player, "الفيوز مفقود من مكانه.", "warn")
				Sounds.Play("Locked", anchor)
			end
			return
		end
		TweenService:Create(lever, TweenInfo.new(0.3), { CFrame = cf * CFrame.new(2.4, 5, -0.8) * CFrame.Angles(math.rad(40), 0, 0) }):Play()
		Sounds.Play("Lever", anchor)
		prompt.Enabled = false
		Run.SetFlag("power", true)
	end)
	return m
end

----------------------------------------------------------------------------------------
-- Library books (housekeeping rhyme: Red, Gold, Blue, Black)
----------------------------------------------------------------------------------------

function Puzzles.Books(parent: Instance, shelfCF: CFrame, onSolved: (Player) -> ())
	local m = Build.Model(parent, "BookPuzzle")
	local colors = {
		Gold = C.Gold,
		Black = Color3.fromRGB(16, 16, 18),
		Red = Color3.fromRGB(150, 20, 24),
		Blue = Color3.fromRGB(40, 70, 150),
	}
	local layout = { "Gold", "Black", "Red", "Blue" } -- physical order on the shelf
	local progress = {}
	local solved = false
	local books = {}
	for i, name in layout do
		local home = shelfCF * CFrame.new(-1.2 + (i - 1) * 0.8, 0, 0)
		local book = Build.P(m, Vector3.new(0.5, 1.9, 1.3), home, colors[name], M.Leather, { collide = false, name = name .. "Book" })
		Build.D(m, Vector3.new(0.52, 0.12, 1.32), home * CFrame.new(0, 0.6, 0), C.Gold, M.Metal)
		books[name] = { part = book, home = home }
		Interact.Add(book, { text = "اسحب", object = "الكتاب " .. ({ Red = "الأحمر", Gold = "الذهبي", Blue = "الأزرق", Black = "الأسود" })[name], dist = 6, los = false }, function(player)
			if solved or table.find(progress, name) then
				return
			end
			table.insert(progress, name)
			TweenService:Create(book, TweenInfo.new(0.25), { CFrame = home * CFrame.new(0, 0, -0.7) * CFrame.Angles(math.rad(-15), 0, 0) }):Play()
			Sounds.Play("Click", book)
			for index, pulled in progress do
				if Config.BookOrder[index] ~= pulled then
					task.wait(0.6)
					Sounds.Play("Locked", book)
					Run.Notify(player, "تنزلق الكتب عائدة إلى مكانها. ترتيب خاطئ.", "warn")
					for _, data in books do
						TweenService:Create(data.part, TweenInfo.new(0.3), { CFrame = data.home }):Play()
					end
					progress = {}
					return
				end
			end
			if #progress == #Config.BookOrder then
				solved = true
				Sounds.Play("Unlock", book)
				onSolved(player)
			end
		end)
	end
	return m
end

----------------------------------------------------------------------------------------
-- Basement generator: pour fuel, then pull the (loud) starter three times.
----------------------------------------------------------------------------------------

function Puzzles.Generator(model: Model, statusLight: BasePart, anchorPos: Vector3)
	local fuelled = false
	local pulls = 0
	local running = false
	local anchor = Interact.Anchor(model, anchorPos, "Anchor")
	local hum
	local prompt
	prompt = Interact.Add(anchor, { text = "افحص", object = "المولّد", dist = 8, hold = 0.5 }, function(player)
		if running then
			return
		end
		if not fuelled then
			if Inventory.Remove(player, "FuelCan", 1) then
				fuelled = true
				prompt.ActionText = "اسحب الحبل"
				prompt.HoldDuration = 1.5
				Run.Notify(player, "يتدفق الوقود في الخزان. اسحب حبل التشغيل.", "item")
				Sounds.Play("Paper", anchor, { PlaybackSpeed = 0.5 })
			else
				Run.Notify(player, "الخزان فارغ. ابحث عن وقود في المخزن السفلي.", "warn")
			end
			return
		end
		pulls += 1
		Sounds.Play("GeneratorStart", anchor)
		Run.Noise:Fire(anchor.Position, 2.5)
		if pulls < 3 then
			statusLight.Color = Color3.fromRGB(220, 160, 30)
			task.delay(0.4, function()
				statusLight.Color = Color3.fromRGB(120, 10, 10)
			end)
			Run.Notify(player, pulls == 1 and "يسعل ثم يموت. مرة أخرى!" or "تقريبًا... مرة أخرى!", "warn")
			return
		end
		running = true
		prompt.Enabled = false
		statusLight.Color = Color3.fromRGB(40, 220, 90)
		hum = Sounds.Make("Generator", anchor)
		if hum then
			hum:Play()
		end
		Run.SetFlag("generator", true)
	end)
end

----------------------------------------------------------------------------------------
-- Secret bookcase that slides aside (manager's office -> secret room)
----------------------------------------------------------------------------------------

function Puzzles.SlidingBookcase(bookcase: Model, offset: Vector3, flag: string)
	local start = bookcase:GetPivot()
	local value = Instance.new("CFrameValue")
	value.Value = start
	value.Changed:Connect(function(cf)
		bookcase:PivotTo(cf)
	end)
	value.Parent = bookcase
	local function open()
		Sounds.Play("Creak", bookcase.PrimaryPart or bookcase:FindFirstChildWhichIsA("BasePart"))
		TweenService:Create(value, TweenInfo.new(2.5, Enum.EasingStyle.Sine), { Value = start + offset }):Play()
	end
	local conn = Run.FlagChanged:Connect(function(name, v)
		if name == flag and v then
			open()
		end
	end)
	bookcase.Destroying:Connect(function()
		conn.Disconnect()
	end)
	if Run.Flag(flag) then
		bookcase:PivotTo(start + offset)
	end
end

-- Crooked painting that acts as a hidden switch.
function Puzzles.Switch(part: BasePart, text: string, object: string, flag: string, message: string?)
	local prompt
	prompt = Interact.Add(part, { text = text, object = object, dist = 7, hold = 0.6, los = false }, function(player)
		if Run.Flag(flag) then
			return
		end
		prompt.Enabled = false
		Sounds.Play("Lever", part)
		if message then
			Run.Notify(player, message, "info")
		end
		Run.SetFlag(flag, true)
	end)
	return prompt
end

function Puzzles.Init()
	Net.Event("Keypad").OnServerEvent:Connect(function(player, id, code)
		if typeof(id) ~= "string" or typeof(code) ~= "string" or #code > 8 then
			return
		end
		if not Net.Allow(player, "keypad", 0.6) then
			return
		end
		local keypad = Puzzles.Keypads[id]
		if not keypad or keypad.solved or not Run.IsPlaying() then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or (root.Position - keypad.anchor.Position).Magnitude > 14 then
			return
		end
		if keypad.zone and not Power.IsOn(keypad.zone) then
			return
		end
		if code == keypad.code then
			Run.Notify(player, "تم السماح بالدخول.", "item")
			Puzzles.SolveKeypad(id, player)
		else
			Sounds.Play("Locked", keypad.anchor)
			keypad.screen.Color = Color3.fromRGB(200, 20, 20)
			task.delay(0.5, function()
				if not keypad.solved then
					keypad.screen.Color = Color3.fromRGB(40, 10, 10)
				end
			end)
			Run.Notify(player, "رمز خاطئ.", "warn")
		end
	end)
end

function Puzzles.Reset()
	Puzzles.Keypads = {}
end

return Puzzles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Run</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Shared run state: session state, difficulty, story flags, team documents, checkpoints
-- and named map points. Has no dependencies on other server services.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)
local Net = require(Shared.Net)

local Run = {}

Run.State = "Lobby" -- "Lobby" | "Playing" | "Ending"
Run.Difficulty = "Normal"
Run.Flags = {} :: { [string]: any }
Run.Docs = {} :: { [string]: boolean }
Run.Participants = {} :: { [Player]: boolean }
Run.Points = {} :: { [string]: CFrame }
Run.Checkpoint = CFrame.new(0, 3, -100)
Run.StartTime = 0
Run.Map = nil :: Model?
Run.DownedThisRun = {} :: { [Player]: boolean }
-- Map data registered by the hotel builder (rebuilt with the map)
Run.Waypoints = {} :: { [string]: { Vector3 } } -- monster patrol nodes per floor
Run.ConciergeSpots = {} :: { { cf: CFrame, floor: string } }
Run.Zones = {} :: { [string]: any } -- Roomkeeper restricted rooms

Run.FlagChanged = Signal.new() -- (name, value)
Run.StateChanged = Signal.new() -- (state)
Run.DocFound = Signal.new() -- (docId, player)
Run.Noise = Signal.new() -- (position, loudness) loud world events monsters can hear

function Run.Diff()
	return Config.Difficulty[Run.Difficulty] or Config.Difficulty.Normal
end

function Run.SetFlag(name: string, value: any)
	if Run.Flags[name] == value then
		return
	end
	Run.Flags[name] = value
	Run.FlagChanged:Fire(name, value)
end

function Run.Flag(name: string): any
	return Run.Flags[name]
end

function Run.SetState(state: string)
	Run.State = state
	Run.StateChanged:Fire(state)
end

function Run.IsPlaying(): boolean
	return Run.State == "Playing"
end

function Run.SetPoint(name: string, cf: CFrame)
	Run.Points[name] = cf
end

function Run.Point(name: string): CFrame
	return Run.Points[name] or Run.Checkpoint
end

function Run.SetCheckpoint(name: string)
	local cf = Run.Points[name]
	if cf then
		Run.Checkpoint = cf
		Run.Flags.checkpoint = name
	end
end

function Run.DocCount(): number
	local n = 0
	for _ in Run.Docs do
		n += 1
	end
	return n
end

function Run.JournalCount(): number
	local n = 0
	for _, id in { "journal_1", "journal_2", "journal_3" } do
		if Run.Docs[id] then
			n += 1
		end
	end
	return n
end

-- Characters of participants that are alive (downed included unless excluded).
function Run.Characters(includeDowned: boolean?): { { player: Player, character: Model, root: BasePart, humanoid: Humanoid } }
	local list = {}
	for _, player in Players:GetPlayers() do
		if Run.Participants[player] then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if humanoid and root and humanoid.Health > 0 then
				if includeDowned or not character:GetAttribute("Downed") then
					table.insert(list, { player = player, character = character, root = root, humanoid = humanoid })
				end
			end
		end
	end
	return list
end

function Run.FloorsWithPlayers(): { [string]: number }
	local floors = {}
	for _, entry in Run.Characters(false) do
		local floor = Config.FloorAt(entry.root.Position.Y)
		floors[floor] = (floors[floor] or 0) + 1
	end
	return floors
end

function Run.Notify(target: Player?, text: string, kind: string?)
	local remote = Net.Event("Notify")
	if target then
		remote:FireClient(target, text, kind or "info")
	else
		remote:FireAllClients(text, kind or "info")
	end
end

function Run.Cinematic(target: Player? | { Player }, name: string, data: any?)
	local remote = Net.Event("Cinematic")
	if target == nil then
		for player in Run.Participants do
			if player.Parent then
				remote:FireClient(player, name, data)
			end
		end
	elseif typeof(target) == "table" then
		for _, player in target :: { Player } do
			remote:FireClient(player, name, data)
		end
	else
		remote:FireClient(target :: Player, name, data)
	end
end

function Run.ResetMapData()
	Run.Points = {}
	Run.Waypoints = {}
	Run.ConciergeSpots = {}
	Run.Zones = {}
end

function Run.AddWaypoint(floor: string, position: Vector3)
	Run.Waypoints[floor] = Run.Waypoints[floor] or {}
	table.insert(Run.Waypoints[floor], position)
end

function Run.ResetState()
	Run.Flags = {}
	Run.Docs = {}
	Run.Participants = {}
	Run.DownedThisRun = {}
	Run.StartTime = 0
end

return Run
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Session</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Session flow: lobby (host, ready-up, difficulty, continue, private runs), run start,
-- drop-in joining, story hooks for every mission, the final choice, escape, endings,
-- rewards, run saving and resetting the world for the next run.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Sounds = require(Shared.Sounds)

local Run = require(script.Parent.Run)
local Data = require(script.Parent.Data)
local Inventory = require(script.Parent.Inventory)
local Pickups = require(script.Parent.Pickups)
local Doors = require(script.Parent.Doors)
local Power = require(script.Parent.Power)
local Hiding = require(script.Parent.Hiding)
local Puzzles = require(script.Parent.Puzzles)
local Survival = require(script.Parent.Survival)
local Missions = require(script.Parent.Missions)
local Elevator = require(script.Parent.Elevator)
local Interact = require(script.Parent.Interact)
local Events = require(script.Parent.Events)

local Hotel = require(script.Parent.Parent.Map.Hotel)
local Monsters = require(script.Parent.Parent.Monsters.Monsters)

local Session = {}
Session.Host = nil :: Player?
Session.Ready = {} :: { [Player]: boolean }
Session.FinalChosen = false
Session.EndingStarted = false
local lastPositions: { [Player]: Vector3 } = {}

----------------------------------------------------------------------------------------
-- Lobby state broadcast
----------------------------------------------------------------------------------------

function Session.Broadcast()
	local list = {}
	for _, player in Players:GetPlayers() do
		table.insert(list, {
			userId = player.UserId,
			name = player.DisplayName,
			ready = Session.Ready[player] == true,
			inRun = Run.Participants[player] == true,
		})
	end
	local host = Session.Host
	local hostProfile = host and Data.Get(host)
	Net.Event("RunState"):FireAllClients({
		state = Run.State,
		host = host and host.UserId or 0,
		difficulty = Run.Difficulty,
		players = list,
		mission = Missions.Index,
		canContinue = hostProfile ~= nil and hostProfile.run ~= nil,
		continueMission = hostProfile and hostProfile.run and hostProfile.run.mission or nil,
		privateServer = game.PrivateServerId ~= "",
	})
end

local function pickHost()
	if Session.Host and Session.Host.Parent then
		return
	end
	Session.Host = Players:GetPlayers()[1]
end

----------------------------------------------------------------------------------------
-- World
----------------------------------------------------------------------------------------

local function applyLighting()
	Lighting.ClockTime = 0.4
	Lighting.Brightness = 0.6
	Lighting.Ambient = Color3.fromRGB(16, 14, 20)
	Lighting.OutdoorAmbient = Color3.fromRGB(36, 40, 54)
	Lighting.EnvironmentDiffuseScale = 0.2
	Lighting.EnvironmentSpecularScale = 0.35
	Lighting.GlobalShadows = true
	Lighting.ExposureCompensation = 0
	Lighting.GeographicLatitude = 30
	local function ensure(className: string, name: string)
		local obj = Lighting:FindFirstChild(name)
		if not obj then
			obj = Instance.new(className)
			obj.Name = name
			obj.Parent = Lighting
		end
		return obj
	end
	local atmosphere = ensure("Atmosphere", "Atmosphere")
	atmosphere.Density = 0.42
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(70, 80, 100)
	atmosphere.Decay = Color3.fromRGB(30, 26, 36)
	atmosphere.Glare = 0
	atmosphere.Haze = 2.2
	local cc = ensure("ColorCorrectionEffect", "Grade")
	cc.Saturation = -0.28
	cc.Contrast = 0.14
	cc.Brightness = 0.02
	cc.TintColor = Color3.fromRGB(232, 236, 255)
	local bloom = ensure("BloomEffect", "Bloom")
	bloom.Intensity = 0.55
	bloom.Size = 28
	bloom.Threshold = 1.6
	local sky = Lighting:FindFirstChildOfClass("Sky") or ensure("Sky", "NightSky")
	sky.StarCount = 400
	sky.MoonAngularSize = 14
	sky.CelestialBodiesShown = true
end
Session.ApplyLighting = applyLighting

function Session.BuildWorld()
	Doors.Reset()
	Pickups.Reset()
	Hiding.Reset()
	Puzzles.Reset()
	Power.Reset()
	Missions.Reset()
	Events.Reset()
	Hotel.Build()
	Power.Scan()
	Monsters.Reset()
	applyLighting()
	Session.RegisterTriggers()
end

----------------------------------------------------------------------------------------
-- Run lifecycle
----------------------------------------------------------------------------------------

local function enroll(player: Player)
	Run.Participants[player] = true
	if not Inventory.Data[player] then
		Inventory.Clear(player)
	end
	Survival.ResetPlayer(player)
	Hiding.Clear(player)
end

function Session.StartRun(save)
	if Run.State ~= "Lobby" then
		return
	end
	Run.ResetState()
	if save and Config.Difficulty[save.difficulty] then
		Run.Difficulty = save.difficulty
	end
	Run.SetState("Playing")
	Run.StartTime = os.clock()
	Run.Checkpoint = Run.Point("Courtyard")
	Session.FinalChosen = false
	Session.EndingStarted = false
	for _, player in Players:GetPlayers() do
		Inventory.Clear(player)
		enroll(player)
		Data.Stat(player, "runs", 1)
		Survival.SendToCheckpoint(player)
	end
	Doors.Unlock("FrontDoor")
	Doors.SetOpen("FrontDoor", true, nil, {})
	Monsters.SetConcierge(true)
	Monsters.SetShadowMode("off")
	if save then
		for id in save.docs or {} do
			Run.Docs[id] = true
		end
		if Session.Host then
			Inventory.Load(Session.Host, save.items)
		end
		Run.Notify(nil, "استُعيدت الجولة من آخر نقطة حفظ.", "info")
		Missions.Restore(math.clamp(save.mission or 1, 1, 10))
		for _, player in Players:GetPlayers() do
			Survival.SendToCheckpoint(player)
		end
	else
		Missions.Start(1)
	end
	Session.Ready = {}
	Session.Broadcast()
end

function Session.JoinRun(player: Player)
	if Run.State ~= "Playing" or Run.Participants[player] then
		return
	end
	enroll(player)
	Data.Stat(player, "runs", 1)
	Survival.SendToCheckpoint(player)
	Missions.Broadcast(player)
	Run.Notify(nil, player.DisplayName .. " سجّل وصوله.", "info")
	Session.Broadcast()
end

local function saveRunFor(player: Player, missionIndex: number)
	Data.SaveRun(player, {
		mission = missionIndex,
		difficulty = Run.Difficulty,
		items = Inventory.Snapshot(player),
		docs = table.clone(Run.Docs),
		savedAt = os.time(),
	})
end

function Session.Reset()
	Run.SetState("Lobby")
	Run.ResetState()
	Session.Ready = {}
	Session.FinalChosen = false
	Session.EndingStarted = false
	for _, player in Players:GetPlayers() do
		Inventory.Clear(player)
	end
	Session.BuildWorld()
	for _, player in Players:GetPlayers() do
		task.spawn(function()
			player:LoadCharacter()
		end)
	end
	Session.Broadcast()
end

function Session.EndRun(endingId: string)
	if Session.EndingStarted then
		return
	end
	Session.EndingStarted = true
	Run.SetState("Ending")
	Monsters.SetShadowMode("off")
	Monsters.SetConcierge(false)
	local diff = Run.Diff()
	local elapsed = os.clock() - Run.StartTime
	local docs = Run.DocCount()
	for player in Run.Participants do
		if player.Parent then
			local coins = math.floor((Config.Rewards[endingId] or 0) * diff.reward + docs * Config.Rewards.perDocument)
			local untouched = not Run.DownedThisRun[player]
			Data.AddCoins(player, coins)
			Data.Award(player, endingId)
			Data.MarkEnding(player, endingId)
			Data.Stat(player, "wins", 1)
			local character = player.Character
			if character and character:GetAttribute("Escaped") then
				Data.Stat(player, "escapes", 1)
			end
			if Run.Difficulty == "Nightmare" then
				Data.Award(player, "insomniac")
			end
			if untouched then
				Data.Award(player, "untouchable")
			end
			Data.ClearRun(player)
			Net.Event("Ending"):FireClient(player, endingId, {
				coins = coins,
				documents = docs,
				time = math.floor(elapsed),
				difficulty = Run.Difficulty,
				untouched = untouched,
				escaped = character ~= nil and character:GetAttribute("Escaped") == true,
			})
			task.spawn(Data.Save, player)
		end
	end
	Session.Broadcast()
	task.delay(30, Session.Reset)
end

----------------------------------------------------------------------------------------
-- Final choice + escape
----------------------------------------------------------------------------------------

local ENDING_FOR = { seal = "escape", destroy = "liberation", wake = "secret" }

local function finalOptions()
	local hasLocket = Inventory.Holder("Locket") ~= nil
	local options = {
		{ id = "seal", title = "اختم القلب", desc = "اختم القلب واهرب عبر نفق الخدمة." },
		{
			id = "destroy",
			title = "دمّر القلب",
			desc = hasLocket and "أعطِ القلب قلادة لينا - الشيء الذي أخذه وأحبّه." or "يتطلب قلادة لينا (غرفة الأطفال في 307).",
			disabled = not hasLocket,
		},
		{ id = "keep", title = "خذ المفتاح الرئيسي", desc = "كن حارس الفندق. إلى الأبد." },
	}
	if hasLocket and Run.DocCount() >= Config.TotalDocuments then
		table.insert(options, 3, { id = "wake", title = "اقرأ لها القصة", desc = "وُجدت كل الصفحات. ضعها أمام القلب.", secret = true })
	end
	return options
end

function Session.StartEscape(choice: string, player: Player)
	local refs = Hotel.Refs
	Run.SetFlag("finalChoice", choice)
	if refs.Console then
		refs.Console.Text = choice == "seal" and "تم ختم القلب\nأخلوا المكان" or "!!! انهيار النواة !!!\nأخلوا المكان"
	end
	if choice == "destroy" or choice == "wake" then
		Inventory.Remove(Inventory.Holder("Locket") or player, "Locket", 1)
		refs.HeartDead = true
		if refs.HeartCore then
			refs.HeartCore.Color = Color3.fromRGB(255, 240, 230)
			Sounds.Play("Shriek", refs.HeartCore, { Volume = 2 })
		end
		Run.Cinematic(nil, "Scare", { color = Color3.fromRGB(255, 250, 240) })
	else
		refs.HeartDead = true
		if refs.HeartCore then
			refs.HeartCore.Color = Color3.fromRGB(40, 10, 12)
		end
	end
	Run.Cinematic(nil, "Shake", { intensity = 0.8, duration = 2 })
	Power.Emergency("B", true)
	Power.SetZone("Escape", true)
	Doors.Unlock("ExitGate")
	Doors.SetOpen("ExitGate", true, nil, {})
	task.spawn(function()
		while Run.IsPlaying() and Run.Flag("finalChoice") do
			if refs.HeartCore and refs.HeartCore.Parent then
				Sounds.Play("Alarm", refs.HeartCore)
			end
			task.wait(1.6)
		end
	end)
	Run.SetCheckpoint("Lab")
	Run.Notify(nil, "اركض! عبر نفق الخدمة - الجدار الغربي للمختبر!", "danger")
	Run.Cinematic(nil, "Subtitle", { text = "شيء ما يمزّق نفسه ليتحرر من القلب...", duration = 4 })
	task.wait(2.5)
	Monsters.PlaceShadow("escape", refs.EscapeShadowSpawn)
	local escapedCount = 0
	Events.AddZone("Exit", refs.ExitZone, function(escaper)
		local character = escaper.Character
		if not character or character:GetAttribute("Escaped") then
			return
		end
		character:SetAttribute("Escaped", true)
		escapedCount += 1
		Run.Notify(nil, escaper.DisplayName .. " هرب!", "objective")
		if escapedCount == 1 then
			Run.SetFlag("escaped", true)
			task.spawn(function()
				for t = 12, 1, -1 do
					local remaining = 0
					for _, entry in Run.Characters(false) do
						if not entry.character:GetAttribute("Escaped") then
							remaining += 1
						end
					end
					if remaining == 0 then
						break
					end
					if t % 3 == 0 then
						Run.Notify(nil, string.format("النفق ينهار! %d ثانية!", t), "danger")
					end
					task.wait(1)
				end
				Session.EndRun(ENDING_FOR[choice] or "escape")
			end)
		end
	end, { once = false })
end

function Session.FinalChoice(choice: string, player: Player)
	if Session.FinalChosen then
		return
	end
	local valid = false
	for _, option in finalOptions() do
		if option.id == choice and not option.disabled then
			valid = true
		end
	end
	if not valid then
		return
	end
	Session.FinalChosen = true
	Run.Notify(nil, player.DisplayName .. " اتّخذ القرار.", "info")
	if choice == "keep" then
		local refs = Hotel.Refs
		Run.Cinematic(nil, "Subtitle", { text = "«أهلًا بك بين الموظفين»، يقول صوت خلفك مباشرة.", duration = 4, voice = true })
		if Monsters.Concierge and refs.HeartCore then
			local pos = refs.HeartCore.Position
			Monsters.Concierge:Show(CFrame.lookAt(Vector3.new(pos.X + 6, Config.Floors.B, pos.Z + 8), Vector3.new(pos.X, Config.Floors.B, pos.Z + 12)), 6, true)
		end
		task.wait(4)
		Session.EndRun("concierge")
	else
		Session.StartEscape(choice, player)
	end
end

----------------------------------------------------------------------------------------
-- Story hooks
----------------------------------------------------------------------------------------

local function award(id: string)
	for player in Run.Participants do
		if player.Parent then
			Data.Award(player, id)
		end
	end
end

local function participantsWhere(predicate)
	local list = {}
	for _, entry in Run.Characters(true) do
		if predicate(entry.root.Position) then
			table.insert(list, entry.player)
		end
	end
	return list
end

local function registerMissionHooks()
	-- 1. Enter
	Missions.OnComplete("enter", function()
		Run.SetCheckpoint("Lobby")
		award("checked_in")
		task.spawn(Events.EntranceSlam)
	end)
	Missions.OnRestore("enter", function()
		Doors.SetOpen("FrontDoor", false, nil, { instant = true, silent = true })
		Doors.Lock("FrontDoor", "انصفقت الأبواب خلفك. لن تُفتح مرة أخرى.")
		Run.Flags.entered = true
		Run.SetCheckpoint("Lobby")
	end)
	-- 3. Power
	Missions.OnComplete("power", function()
		Run.SetCheckpoint("Lobby")
		award("lights_on")
		task.spawn(Events.PowerOn)
	end)
	Missions.OnRestore("power", function()
		Doors.Unlock("ReceptionOfficeDoor")
		Pickups.RemoveAll("ReceptionKey")
		Pickups.RemoveAll("Fuse")
		Events.PowerOn(true)
	end)
	-- 4. Elevator card
	Missions.OnComplete("elevator_card", function()
		Run.SetCheckpoint("Spur")
		Run.Notify(nil, "أدخل البطاقة في اللوحة داخل المصعد.", "info")
	end)
	Missions.OnRestore("elevator_card", function()
		Puzzles.SolveKeypad("Security")
		Pickups.RemoveAll("ElevatorCard")
		Run.Flags.elevator = true
		Run.SetCheckpoint("Spur")
	end)
	-- 5. Room 307
	Missions.OnStart("room307", function()
		Run.Notify(nil, "فتّش الطابق الثاني. باب المكتبة مسدود... لكن الخادمات عرفن طريقًا آخر.", "info")
	end)
	Missions.OnComplete("room307", function()
		Run.SetCheckpoint("F3Hall")
		task.spawn(Events.MirrorScare)
		task.delay(6, function()
			Monsters.SetShadowMode("roam")
		end)
	end)
	Missions.OnRestore("room307", function()
		Run.Flags.f3Visited = true
		Run.Flags.mirror = true
		Run.Flags.secretRoom = true
		Run.Flags.passage = true
		Doors.RemoveBarricade("LibraryDoor")
		Puzzles.SolveKeypad("ManagerSafe")
		Pickups.RemoveAll("Key307")
		Doors.Unlock("Room307")
		Run.SetCheckpoint("F3Hall")
		Monsters.SetShadowMode("roam")
	end)
	-- 6. Journals
	Missions.OnStart("documents", function()
		Missions.Broadcast()
	end)
	-- 7. Basement
	Missions.OnStart("basement", function()
		task.delay(2, Events.PhoneCall)
	end)
	Missions.OnComplete("basement", function()
		Run.SetCheckpoint("Cloakroom")
	end)
	Missions.OnRestore("basement", function()
		Doors.Unlock("BasementDoor")
		Run.Flags.basementOpen = true
		Run.SetCheckpoint("Cloakroom")
	end)
	-- 8. Generator
	Missions.OnStart("generator", function()
		Monsters.SetShadowMode("basement")
		Events.BasementDark(participantsWhere(function(p)
			return p.Y < -2
		end))
	end)
	Missions.OnComplete("generator", function()
		Power.SetZone("B", true, true)
		Run.SetCheckpoint("Generator")
		task.delay(4, function()
			Monsters.SetShadowMode("roam")
			Run.Cinematic(nil, "Subtitle", { text = "الأضواء تطرده إلى الطوابق العليا... مؤقتًا.", duration = 4 })
		end)
	end)
	Missions.OnRestore("generator", function()
		Run.Flags.generator = true
		Power.SetZone("B", true)
		Run.SetCheckpoint("Generator")
		Monsters.SetShadowMode("roam")
	end)
	-- 9. Laboratory
	Missions.OnComplete("lab", function()
		Run.SetCheckpoint("Lab")
		Events.HeartReveal(participantsWhere(function(p)
			return p.X < -30 and p.Y < -2
		end))
	end)
	Missions.OnRestore("lab", function()
		Puzzles.SolveKeypad("Laboratory")
		Run.Flags.labEntered = true
		Run.SetCheckpoint("Lab")
	end)
	-- 10. Exit: the console offers the final choice
	Missions.OnStart("exit", function()
		Run.Notify(nil, "استخدم لوحة التحكم أمام القلب.", "info")
	end)

	-- save progress for everyone whenever a mission completes
	Missions.Completed:Connect(function(_, index)
		for player in Run.Participants do
			if player.Parent then
				saveRunFor(player, index + 1)
			end
		end
	end)
end

function Session.RegisterTriggers()
	local refs = Hotel.Refs
	Events.AddZone("Lobby", refs.LobbyZone, function()
		Run.SetFlag("entered", true)
	end)
	Events.AddZone("ThirdFloor", refs.F3Zone, function()
		if Run.Flags.f3Visited then
			return
		end
		Run.Flags.f3Visited = true
		task.spawn(Events.ShadowCorridor)
	end)
	Events.AddZone("Laboratory", refs.LabZone, function()
		Run.SetFlag("labEntered", true)
	end, {
		condition = function()
			return Run.Flag("generator") == true
		end,
	})
	Events.AddZone("Room308", refs.Room308Zone, function()
		task.spawn(Events.Room308Opens)
	end, {
		condition = function()
			return Run.Flag("f3Visited") == true
		end,
	})
	-- console prompt
	local console = refs.Console
	if console then
		Interact.Add(console, { text = "استخدم", object = "لوحة تحكم القلب", dist = 9, los = false, hold = 0.6 }, function(player)
			local current = Missions.Current()
			if not current or current.id ~= "exit" then
				Run.Notify(player, "الدخول مرفوض. اللوحة تومض: «أطعمني».", "warn")
				return
			end
			if Session.FinalChosen then
				return
			end
			Net.Event("Choice"):FireClient(player, "final", { options = finalOptions() })
		end)
	end
	-- roomkeeper zones only matter while playing; Suite 203 / nursery are always guarded
end

----------------------------------------------------------------------------------------
-- Init
----------------------------------------------------------------------------------------

local function onLobbyAction(player: Player, action, arg)
	if typeof(action) ~= "string" or not Net.Allow(player, "lobby", 0.3) then
		return
	end
	pickHost()
	local isHost = player == Session.Host
	if action == "Play" then
		if Run.State == "Playing" then
			Session.JoinRun(player)
		elseif Run.State == "Lobby" then
			if #Players:GetPlayers() == 1 then
				Session.StartRun(nil)
			else
				Session.Ready[player] = true
				local all = true
				for _, p in Players:GetPlayers() do
					if not Session.Ready[p] then
						all = false
					end
				end
				if all then
					Session.StartRun(nil)
				end
			end
		end
	elseif action == "Ready" and Run.State == "Lobby" then
		Session.Ready[player] = not Session.Ready[player]
	elseif action == "Difficulty" and isHost and Run.State == "Lobby" then
		if typeof(arg) == "string" and Config.Difficulty[arg] then
			Run.Difficulty = arg
		end
	elseif action == "Start" and isHost and Run.State == "Lobby" then
		Session.StartRun(nil)
		return
	elseif action == "Continue" and isHost and Run.State == "Lobby" then
		local profile = Data.Get(player)
		if profile and profile.run then
			Session.StartRun(profile.run)
			return
		end
	elseif action == "Private" and isHost and Run.State == "Lobby" then
		task.spawn(function()
			local ok, err = pcall(function()
				local code = TeleportService:ReserveServer(game.PlaceId)
				local options = Instance.new("TeleportOptions")
				options.ReservedServerAccessCode = code
				local party = {}
				for _, p in Players:GetPlayers() do
					if p == player or Session.Ready[p] then
						table.insert(party, p)
					end
				end
				TeleportService:TeleportAsync(game.PlaceId, party, options)
			end)
			if not ok then
				Run.Notify(player, "الجولات الخاصة تتطلب نشر اللعبة (" .. tostring(err) .. ").", "warn")
			end
		end)
	end
	Session.Broadcast()
end

function Session.Init()
	registerMissionHooks()

	Net.Event("Lobby").OnServerEvent:Connect(onLobbyAction)
	Net.Event("Choice").OnServerEvent:Connect(function(player, context, choice)
		if context ~= "final" or typeof(choice) ~= "string" or not Net.Allow(player, "final", 0.5) then
			return
		end
		if not Run.IsPlaying() or not Run.Participants[player] then
			return
		end
		local current = Missions.Current()
		if not current or current.id ~= "exit" then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local console = Hotel.Refs.Console
		if not root or not console or (root.Position - console.Position).Magnitude > 14 then
			return
		end
		task.spawn(Session.FinalChoice, choice, player)
	end)

	Pickups.OnDocument = function(player, docId)
		Data.MarkDoc(player, docId)
	end
	Elevator.Arrived:Connect(function(_, riders)
		for _, player in riders do
			Data.Award(player, "going_up")
		end
	end)
	Doors.Unlocked:Connect(function(id)
		if id == "BasementDoor" then
			Run.SetFlag("basementOpen", true)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		pickHost()
		player.CharacterAdded:Connect(function(character)
			Hiding.Clear(player)
			local root = character:WaitForChild("HumanoidRootPart", 10)
			if root then
				task.spawn(function()
					while character.Parent and root.Parent do
						lastPositions[player] = root.Position
						task.wait(1)
					end
				end)
			end
		end)
		task.delay(1, Session.Broadcast)
		if Run.State == "Playing" then
			-- drop-in: they join from the main menu "Play" button
			task.delay(1, function()
				Run.Notify(player, "هناك جولة جارية. اضغط «العب» للانضمام إلى أصدقائك.", "info")
			end)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		if Run.IsPlaying() and Run.Participants[player] then
			local pos = lastPositions[player]
			if pos then
				Pickups.DropCritical(player, pos)
			end
		end
		Run.Participants[player] = nil
		Session.Ready[player] = nil
		Inventory.Forget(player)
		Hiding.Clear(player)
		Net.Forget(player)
		lastPositions[player] = nil
		if Session.Host == player then
			Session.Host = nil
			task.defer(function()
				pickHost()
				Session.Broadcast()
			end)
		end
		task.defer(Session.Broadcast)
		-- if the last participant left mid-run, return to the lobby
		task.delay(2, function()
			if Run.IsPlaying() then
				local any = false
				for p in Run.Participants do
					if p.Parent then
						any = true
					end
				end
				if not any then
					Session.Reset()
				end
			end
		end)
	end)
	for _, player in Players:GetPlayers() do
		pickHost()
		task.delay(1, Session.Broadcast)
		local _ = player
	end
end

return Session
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Survival</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Health, downed/revive, death & checkpoints, stamina, server-authoritative movement speed,
-- flashlight battery and noise (which the monsters listen to).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Sounds = require(Shared.Sounds)
local Progression = require(Shared.Progression)

local Run = require(script.Parent.Run)
local Interact = require(script.Parent.Interact)
local Inventory = require(script.Parent.Inventory)
local Data = require(script.Parent.Data)

local Survival = {}

type State = {
	mode: string,
	stamina: number,
	exhausted: boolean,
	battery: number,
	flashlight: boolean,
	downedUntil: number?,
	revivePrompt: ProximityPrompt?,
}

local states: { [Player]: State } = {}
local MOVE = Config.Movement

local function state(player: Player): State
	local s = states[player]
	if not s then
		s = {
			mode = "walk",
			stamina = MOVE.StaminaMax,
			exhausted = false,
			battery = Config.Flashlight.BatteryMax,
			flashlight = false,
			downedUntil = nil,
			revivePrompt = nil,
		}
		states[player] = s
	end
	return s
end

local function getHumanoid(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	return character, character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

----------------------------------------------------------------------------------------
-- Flashlight
----------------------------------------------------------------------------------------

local function skinOf(player: Player)
	local profile = Data.Get(player)
	local skinId = profile and profile.skin or "classic"
	return Progression.Skins[skinId] or Progression.Skins.classic
end

function Survival.ApplySkin(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local skin = skinOf(player)
	local head = character:FindFirstChild("Head")
	local light = head and head:FindFirstChild("Flashlight")
	if light then
		light.Color = skin.beam
	end
	local body = character:FindFirstChild("FlashlightBody")
	if body then
		body.Color = skin.body
	end
end

local function setupFlashlight(player: Player, character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head then
		return
	end
	local light = Instance.new("SpotLight")
	light.Name = "Flashlight"
	light.Face = Enum.NormalId.Front
	light.Range = Config.Flashlight.Range
	light.Angle = Config.Flashlight.Angle
	light.Brightness = Config.Flashlight.Brightness
	light.Shadows = false
	light.Enabled = false
	light.Parent = head

	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if hand and hand:IsA("BasePart") then
		local body = Instance.new("Part")
		body.Name = "FlashlightBody"
		body.Shape = Enum.PartType.Cylinder
		body.Size = Vector3.new(1.1, 0.35, 0.35)
		body.Material = Enum.Material.Metal
		body.CanCollide = false
		body.CanQuery = false
		body.CanTouch = false
		body.Massless = true
		local offset = hand.Name == "RightHand" and CFrame.new(0, -0.25, -0.4) or CFrame.new(0, -0.9, -0.4)
		body.CFrame = hand.CFrame * offset * CFrame.Angles(0, math.rad(90), 0)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hand
		weld.Part1 = body
		weld.Parent = body
		body.Parent = character
	end
	Survival.ApplySkin(player)
end

local function setFlashlight(player: Player, on: boolean)
	local s = state(player)
	if on and s.battery <= 0 then
		Run.Notify(player, "بطارية مصباحك فارغة. ابحث عن بطارية (R للاستخدام).", "warn")
		on = false
	end
	s.flashlight = on
	player:SetAttribute("FlashlightOn", on)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local light = head and head:FindFirstChild("Flashlight")
	if light then
		light.Enabled = on
	end
	if character then
		character:SetAttribute("Lit", on)
	end
end
Survival.SetFlashlight = setFlashlight

----------------------------------------------------------------------------------------
-- Damage / downed / revive
----------------------------------------------------------------------------------------

local function othersStanding(except: Player): number
	local n = 0
	for _, entry in Run.Characters(false) do
		if entry.player ~= except then
			n += 1
		end
	end
	return n
end

function Survival.IsDowned(player: Player): boolean
	local character = player.Character
	return character ~= nil and character:GetAttribute("Downed") == true
end

function Survival.Kill(player: Player)
	local character, humanoid = getHumanoid(player)
	if not character or not humanoid then
		return
	end
	local s = state(player)
	if s.revivePrompt then
		s.revivePrompt:Destroy()
		s.revivePrompt = nil
	end
	s.downedUntil = nil
	humanoid.Health = 0
	Data.Stat(player, "deaths", 1)
	Run.Cinematic(player, "Died", { respawn = Players.RespawnTime })
end

function Survival.Revive(player: Player, reviver: Player?)
	local character, humanoid = getHumanoid(player)
	if not character or not humanoid or not character:GetAttribute("Downed") then
		return
	end
	local s = state(player)
	if s.revivePrompt then
		s.revivePrompt:Destroy()
		s.revivePrompt = nil
	end
	s.downedUntil = nil
	character:SetAttribute("Downed", false)
	humanoid.Health = Config.Health.ReviveHealth
	humanoid.JumpPower = 30
	Run.Cinematic(player, "Revived", nil)
	if reviver then
		Run.Notify(nil, reviver.DisplayName .. " أنعش " .. player.DisplayName .. ".", "info")
		Data.Award(reviver, "rescuer")
	end
end

function Survival.Down(player: Player)
	local character, humanoid, root = getHumanoid(player)
	if not character or not humanoid or not root then
		return
	end
	local s = state(player)
	character:SetAttribute("Downed", true)
	Run.DownedThisRun[player] = true
	humanoid.Health = 1
	humanoid.JumpPower = 0
	s.downedUntil = os.clock() + Run.Diff().downedTime
	setFlashlight(player, false)
	s.revivePrompt = Interact.Add(root, {
		text = "أنعش",
		object = player.DisplayName,
		hold = Config.Health.ReviveHoldTime,
		dist = 8,
		los = false,
		name = "RevivePrompt",
	}, function(reviver)
		if reviver ~= player then
			Survival.Revive(player, reviver)
		end
	end)
	Run.Notify(nil, player.DisplayName .. " سقط! اضغط مطولًا على E بجانبه لإنعاشه.", "danger")
	Run.Cinematic(player, "Downed", { time = Run.Diff().downedTime })
end

-- The only way monsters hurt players. Handles downed state instead of instant death.
function Survival.Damage(player: Player, amount: number, source: string?)
	local character, humanoid = getHumanoid(player)
	if not character or not humanoid or humanoid.Health <= 0 then
		return
	end
	if character:GetAttribute("Downed") then
		return
	end
	local dmg = amount * Run.Diff().damage
	character:SetAttribute("LastHurt", workspace:GetServerTimeNow())
	Run.Cinematic(player, "Hurt", { amount = dmg, source = source })
	if humanoid.Health - dmg > 0.5 then
		humanoid.Health -= dmg
		return
	end
	if othersStanding(player) > 0 then
		Survival.Down(player)
	else
		Run.DownedThisRun[player] = true
		Survival.Kill(player)
	end
end

function Survival.Heal(player: Player, amount: number)
	local _, humanoid = getHumanoid(player)
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
	end
end

----------------------------------------------------------------------------------------
-- Spawning / checkpoints
----------------------------------------------------------------------------------------

function Survival.SendToCheckpoint(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local index = table.find(Players:GetPlayers(), player) or 1
	local angle = index * (math.pi * 2 / Config.MaxPlayers)
	local offset = Vector3.new(math.cos(angle) * 2.5, 0, math.sin(angle) * 2.5)
	character:PivotTo(Run.Checkpoint + offset)
end

function Survival.ResetPlayer(player: Player)
	local s = state(player)
	s.stamina = MOVE.StaminaMax
	s.exhausted = false
	s.battery = Config.Flashlight.BatteryMax
	s.mode = "walk"
	setFlashlight(player, false)
	player:SetAttribute("Battery", s.battery)
	player:SetAttribute("Stamina", s.stamina)
end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.BreakJointsOnDeath = false
	humanoid.MaxHealth = Config.Health.Max
	humanoid.Health = Config.Health.Max
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 30
	humanoid.WalkSpeed = MOVE.WalkSpeed
	character:SetAttribute("Downed", false)
	character:SetAttribute("Hidden", false)
	character:SetAttribute("Noise", 0)
	local s = state(player)
	s.downedUntil = nil
	s.revivePrompt = nil
	s.mode = "walk"
	s.stamina = MOVE.StaminaMax
	task.spawn(setupFlashlight, player, character)
	setFlashlight(player, false)
	if Run.IsPlaying() and Run.Participants[player] then
		task.defer(function()
			if character.Parent then
				Survival.SendToCheckpoint(player)
			end
		end)
	end
	humanoid.Died:Connect(function()
		setFlashlight(player, false)
	end)
end

----------------------------------------------------------------------------------------
-- Tick
----------------------------------------------------------------------------------------

local function tick(dt: number)
	local diff = Run.Diff()
	local anyStanding = false
	local anyDowned = false
	for _, player in Players:GetPlayers() do
		local s = state(player)
		local character, humanoid, root = getHumanoid(player)
		if character and humanoid and root and humanoid.Health > 0 then
			local downed = character:GetAttribute("Downed") == true
			local hidden = character:GetAttribute("Hidden") == true
			local horizontal = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude
			local moving = horizontal > 2
			local sprinting = false
			if downed then
				anyDowned = Run.Participants[player] == true or anyDowned
				humanoid.WalkSpeed = MOVE.DownedSpeed
				if s.downedUntil and os.clock() > s.downedUntil then
					Survival.Kill(player)
				end
			elseif hidden then
				humanoid.WalkSpeed = 0
				anyStanding = anyStanding or Run.Participants[player] == true
			else
				anyStanding = anyStanding or Run.Participants[player] == true
				if s.mode == "sprint" and not s.exhausted and s.stamina > 0 and moving then
					sprinting = true
					s.stamina = math.max(0, s.stamina - MOVE.StaminaDrain * dt)
					if s.stamina <= 0 then
						s.exhausted = true
						Run.Cinematic(player, "Exhausted", nil)
					end
				else
					s.stamina = math.min(MOVE.StaminaMax, s.stamina + MOVE.StaminaRegen * dt * (moving and 0.6 or 1))
					if s.exhausted and s.stamina >= MOVE.ExhaustRecover then
						s.exhausted = false
					end
				end
				if sprinting then
					humanoid.WalkSpeed = MOVE.SprintSpeed
				elseif s.mode == "crouch" then
					humanoid.WalkSpeed = MOVE.CrouchSpeed
				else
					humanoid.WalkSpeed = MOVE.WalkSpeed
				end
			end
			-- noise heard by monsters
			local noise = 0
			if moving and not hidden then
				if downed then
					noise = 0.2
				elseif sprinting then
					noise = MOVE.Noise.sprint
				elseif s.mode == "crouch" then
					noise = MOVE.Noise.crouch
				else
					noise = MOVE.Noise.walk
				end
			end
			character:SetAttribute("Noise", noise)
			character:SetAttribute("Sprinting", sprinting)
			-- flashlight battery
			if s.flashlight and Run.IsPlaying() then
				s.battery = math.max(0, s.battery - diff.battery * dt)
				if s.battery <= 0 then
					setFlashlight(player, false)
					Run.Notify(player, "انطفأ المصباح.", "warn")
				end
			end
			player:SetAttribute("Battery", math.floor(s.battery * 10) / 10)
			player:SetAttribute("Stamina", math.floor(s.stamina))
		end
	end
	-- team wipe: nobody left standing -> the downed bleed out immediately
	if Run.IsPlaying() and anyDowned and not anyStanding then
		for _, player in Players:GetPlayers() do
			if Survival.IsDowned(player) then
				Survival.Kill(player)
			end
		end
		Run.Notify(nil, "سقط الجميع. العودة إلى آخر نقطة حفظ...", "danger")
	end
end

function Survival.Init()
	Players.RespawnTime = 5
	Players.PlayerAdded:Connect(function(player)
		state(player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
	end)
	for _, player in Players:GetPlayers() do
		state(player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)

	Net.Event("Move").OnServerEvent:Connect(function(player, mode)
		if typeof(mode) ~= "string" or not MOVE.Noise[mode] or mode == "idle" then
			return
		end
		if not Net.Allow(player, "move", 0.05) then
			return
		end
		state(player).mode = mode
		player:SetAttribute("MoveMode", mode)
	end)

	Net.Event("Flashlight").OnServerEvent:Connect(function(player, on)
		if typeof(on) ~= "boolean" or not Net.Allow(player, "flashlight", 0.15) then
			return
		end
		local character = player.Character
		if on and character and (character:GetAttribute("Downed") or character:GetAttribute("Hidden")) then
			on = false
		end
		setFlashlight(player, on)
		local head = character and character:FindFirstChild("Head")
		if head then
			Sounds.Play("Click", head)
		end
	end)

	Net.Event("UseItem").OnServerEvent:Connect(function(player, itemId)
		if typeof(itemId) ~= "string" or not Net.Allow(player, "useitem", 0.5) then
			return
		end
		local character, humanoid = getHumanoid(player)
		if not character or not humanoid or humanoid.Health <= 0 or character:GetAttribute("Downed") then
			return
		end
		if itemId == "Battery" then
			local s = state(player)
			if s.battery >= Config.Flashlight.BatteryMax - 1 then
				Run.Notify(player, "البطارية ممتلئة بالفعل.", "info")
			elseif Inventory.Remove(player, "Battery", 1) then
				s.battery = Config.Flashlight.BatteryMax
				player:SetAttribute("Battery", s.battery)
				Run.Notify(player, "تم تبديل بطارية المصباح.", "item")
			else
				Run.Notify(player, "ليس لديك بطاريات.", "warn")
			end
		elseif itemId == "Bandage" then
			if humanoid.Health >= humanoid.MaxHealth - 1 then
				Run.Notify(player, "أنت لست مصابًا.", "info")
			elseif Inventory.Remove(player, "Bandage", 1) then
				Survival.Heal(player, Config.Health.BandageHeal)
				Run.Notify(player, "تضمّد جراحك.", "item")
			else
				Run.Notify(player, "ليس لديك ضمادات.", "warn")
			end
		end
	end)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.2)
			local now = os.clock()
			local ok, err = pcall(tick, now - last)
			if not ok then
				warn("[Survival] tick error:", err)
			end
			last = now
		end
	end)
end

return Survival
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
