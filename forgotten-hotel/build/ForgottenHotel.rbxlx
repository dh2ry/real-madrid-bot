      <Item class="Folder" referent="49">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Dynamic soundscape: wind & rain outside, a low drone inside, electrical hum in the
-- basement, a chase layer and heartbeat driven by monster threat, and random distant
-- creaks/whispers/footsteps around the player (3D, local only).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local State = require(script.Parent.State)

local Audio = {}
local player = Players.LocalPlayer
local layers = {}
local nextBeat = 0
local nextAmbient = os.clock() + 15

local function layer(name: string)
	local sound = Sounds.Make(name, nil)
	if sound then
		sound.Volume = 0
		sound:Play()
	end
	layers[name] = { sound = sound, base = Sounds.Library[name].volume or 0.5 }
end

local function fade(name: string, target: number, dt: number, speed: number?)
	local l = layers[name]
	if l and l.sound then
		local goal = l.base * target
		l.sound.Volume += (goal - l.sound.Volume) * math.min(1, dt * (speed or 1.5))
	end
end

local function computeThreat(root: BasePart): number
	local threat = 0
	for _, model in CollectionService:GetTagged("MonsterRig") do
		local mroot = model.PrimaryPart
		if mroot and model:IsDescendantOf(workspace) then
			local d = (mroot.Position - root.Position).Magnitude
			local style = model:GetAttribute("Style")
			if style == "shadow" then
				if model:GetAttribute("Chasing") and model:GetAttribute("TargetId") == player.UserId then
					threat = math.max(threat, 1)
				elseif d < 55 then
					threat = math.max(threat, (1 - d / 55) * (model:GetAttribute("Chasing") and 0.85 or 0.55))
				end
			elseif style == "roomkeeper" and d < 25 then
				threat = math.max(threat, 0.8)
			elseif style == "concierge" and d < 40 then
				threat = math.max(threat, 0.25)
			end
		end
	end
	return threat
end

function Audio.Init()
	for _, name in { "Wind", "Rain", "Drone", "ChaseLayer", "Hum" } do
		layer(name)
	end
	RunService.Heartbeat:Connect(function(dt)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local pos = root and root.Position or workspace.CurrentCamera.CFrame.Position
		local inside = Config.IsInside(pos) and not (State.MenuOpen and not State.InRun())
		local floor = Config.FloorAt(pos.Y)
		fade("Wind", inside and 0.25 or 1, dt)
		fade("Rain", inside and 0.35 or 1.2, dt)
		fade("Drone", inside and (floor == "F3" and 1.4 or 1) or 0.35, dt, 0.6)
		fade("Hum", (inside and floor == "B") and 1 or 0, dt)
		local threat = root and computeThreat(root) or 0
		State.Threat = threat
		local chaseVolume = threat > 0.95 and 0.9 or threat * 0.4
		layers.ChaseLayer.base = 1
		fade("ChaseLayer", chaseVolume, dt, threat > 0.95 and 4 or 1)
		-- heartbeat (lub-dub) speeds up with threat
		local now = os.clock()
		if threat > 0.25 and now >= nextBeat then
			local interval = 1.1 - threat * 0.65
			nextBeat = now + interval
			Sounds.Play("Heartbeat", nil, { Volume = 0.4 + threat * 0.6 })
			task.delay(0.18, function()
				Sounds.Play("Heartbeat", nil, { Volume = 0.3 + threat * 0.5, PlaybackSpeed = 0.38 })
			end)
		end
		-- random distant sounds while inside
		if inside and State.InRun() and now >= nextAmbient then
			nextAmbient = now + math.random(16, 36)
			local names = { "Creak", "Whisper", "Footstep", "DoorClose", "Static" }
			local name = names[math.random(1, #names)]
			local a = math.random() * math.pi * 2
			local offset = Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(14, 30)
			Sounds.PlayAt(name, pos + offset, { Volume = 0.25 + math.random() * 0.2, Looped = false })
		end
	end)
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Camera</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Camera controller: orbiting menu camera, first/third person modes, FOV, sprint FOV kick,
-- crouch height, head bob and mouse sensitivity. Cinematics take over via State.Cinematic.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local State = require(script.Parent.State)

local CameraController = {}
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local MENU_TARGET = Vector3.new(0, 20, -50)
local bobTime = 0
local currentOffset = Vector3.zero
local menuTime = 0

local function humanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

function CameraController.ApplyMode()
	local mode = State.Settings.cameraMode
	if mode == "first" then
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 0.5
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	else
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 6
		player.CameraMaxZoomDistance = 14
	end
end

function CameraController.Toggle()
	local Settings = require(script.Parent.Settings)
	Settings.Set("cameraMode", State.Settings.cameraMode == "first" and "third" or "first")
	CameraController.ApplyMode()
end

local function step(dt: number)
	camera = workspace.CurrentCamera
	UserInputService.MouseDeltaSensitivity = State.Settings.sensitivity
	if State.MenuOpen and not State.InRun() then
		-- slow orbit of the facade in the rain
		menuTime += dt
		camera.CameraType = Enum.CameraType.Scriptable
		local a = math.rad(-120) + math.sin(menuTime * 0.05) * 0.35
		local pos = MENU_TARGET + Vector3.new(math.cos(a) * 78, -8 + math.sin(menuTime * 0.13) * 2, math.sin(a) * 78 - 20)
		camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(pos, MENU_TARGET), math.min(1, dt * 2))
		camera.FieldOfView = 60
		return
	end
	if State.Cinematic or State.Hidden then
		return
	end
	if camera.CameraType == Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Custom
		local hum = humanoid()
		if hum then
			camera.CameraSubject = hum
		end
	end
	local hum = humanoid()
	if not hum then
		return
	end
	-- FOV with sprint kick
	local fov = State.Settings.fov + (State.Sprinting and 7 or 0)
	camera.FieldOfView += (fov - camera.FieldOfView) * math.min(1, dt * 6)
	-- crouch / downed height + head bob + third person shoulder offset
	local target = Vector3.zero
	if State.Downed then
		target = Vector3.new(0, -2.2, 0)
	elseif State.Crouching then
		target = Vector3.new(0, -1.6, 0)
	end
	if State.Settings.cameraMode == "third" then
		target += Vector3.new(1.6, 0.6, 0)
	end
	local root = hum.RootPart
	local speed = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude or 0
	if State.Settings.headBob and State.Settings.cameraMode == "first" and speed > 1 and hum.FloorMaterial ~= Enum.Material.Air then
		bobTime += dt * speed * 0.55
		target += Vector3.new(math.cos(bobTime) * 0.08, math.abs(math.sin(bobTime)) * 0.16, 0)
	else
		bobTime = 0
	end
	currentOffset = currentOffset:Lerp(target, math.min(1, dt * 10))
	hum.CameraOffset = currentOffset
end

function CameraController.Init()
	CameraController.ApplyMode()
	RunService:BindToRenderStep("HotelCamera", Enum.RenderPriority.Camera.Value - 1, step)
	State.Changed:Connect(function(key)
		if key == "SettingsApplied" then
			CameraController.ApplyMode()
		elseif key == "MenuOpen" then
			if not State.MenuOpen then
				camera.CameraType = Enum.CameraType.Custom
				local hum = humanoid()
				if hum then
					camera.CameraSubject = hum
				end
			end
		end
	end)
	player.CharacterAdded:Connect(function()
		task.defer(CameraController.ApplyMode)
	end)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Cinematics</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client side of every scripted moment: camera look-ats and focus shots, shakes, flashes,
-- subtitles, hurt/downed/death feedback, hiding views, elevator rides and lightning.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Sounds = require(Shared.Sounds)

local State = require(script.Parent.State)
local HUD = require(script.Parent.UI.HUD)

local Cinematics = {}
local player = Players.LocalPlayer
local shakeUntil, shakeIntensity = 0, 0
local hideCF: CFrame? = nil
local hideYaw, hidePitch = 0, 0
local busy = 0

local function camera()
	return workspace.CurrentCamera
end

local function beginOverride()
	busy += 1
	State.Set("Cinematic", true)
	HUD.Letterbox(true)
	camera().CameraType = Enum.CameraType.Scriptable
end

local function endOverride()
	busy = math.max(0, busy - 1)
	if busy == 0 then
		HUD.Letterbox(false)
		State.Set("Cinematic", false)
		if not State.Hidden then
			local cam = camera()
			cam.CameraType = Enum.CameraType.Custom
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				cam.CameraSubject = humanoid
			end
		end
	end
end

local function tweenCamera(target: CFrame, time: number)
	local cam = camera()
	local tween = TweenService:Create(cam, TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = target })
	tween:Play()
	tween.Completed:Wait()
end

local handlers = {}

handlers.LookAt = function(data)
	if State.Hidden or State.MenuOpen then
		return
	end
	local cam = camera()
	local position: Vector3 = data.position
	beginOverride()
	local from = cam.CFrame
	tweenCamera(CFrame.lookAt(from.Position, position), 0.45)
	task.wait(data.duration or 2)
	-- turn the character to face what they just saw so control resumes naturally
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		root.CFrame = CFrame.lookAt(root.Position, Vector3.new(position.X, root.Position.Y, position.Z))
	end
	endOverride()
end

handlers.Focus = function(data)
	if State.Hidden then
		return
	end
	beginOverride()
	tweenCamera(data.cf, 0.8)
	task.wait(data.duration or 3)
	endOverride()
end

handlers.Shake = function(data)
	shakeIntensity = math.max(shakeIntensity, data.intensity or 0.4)
	shakeUntil = math.max(shakeUntil, os.clock() + (data.duration or 0.5))
end

handlers.Scare = function(data)
	HUD.Flash(data and data.color or Color3.fromRGB(255, 255, 255), 0.5)
	Sounds.Play("Sting", nil, { Volume = 1 })
	handlers.Shake({ intensity = 0.8, duration = 0.5 })
end

handlers.Subtitle = function(data)
	HUD.Subtitle(data.text, data.duration, data.voice and "voice" or nil)
end

handlers.Whisper = function(data)
	HUD.Subtitle(data.text, 3.5, "whisper")
	if not data.quiet then
		Sounds.Play("Whisper", nil, { Volume = 0.8 })
	end
end

handlers.Hurt = function(data)
	HUD.Hurt(math.clamp((data.amount or 20) / 40, 0.2, 1))
	Sounds.Play("Hit", nil, { Volume = 0.9 })
	handlers.Shake({ intensity = 0.7, duration = 0.35 })
end

handlers.Spotted = function()
	Sounds.Play("Sting", nil, { Volume = 0.8 })
	HUD.Flash(Color3.fromRGB(80, 0, 0), 0.4)
end

handlers.Downed = function(data)
	State.Set("Downed", true)
	HUD.SetDowned(true, data.time)
end

handlers.Revived = function()
	State.Set("Downed", false)
	HUD.SetDowned(false)
	HUD.Notify("عدتَ إلى الوقوف على قدميك.", "item")
end

handlers.Died = function(data)
	State.Set("Downed", false)
	HUD.SetDowned(false)
	HUD.Died(data.respawn or 5)
	Sounds.Play("Scream", nil, { Volume = 0.6, PlaybackSpeed = 0.4 })
end

handlers.Exhausted = function()
	Sounds.Play("Breathing", nil, { Looped = false, Volume = 0.6, PlaybackSpeed = 0.8 })
	HUD.Notify("انقطعت أنفاسك.", "warn")
end

handlers.ElevatorRide = function(data)
	handlers.Shake({ intensity = 0.15, duration = data.duration or 3 })
end

handlers.HideView = function(data)
	State.Set("Hidden", true)
	hideCF = data.cf
	hideYaw, hidePitch = 0, 0
	camera().CameraType = Enum.CameraType.Scriptable
	HUD.SetHidden(true, data.kind)
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
end

handlers.Unhide = function(data)
	State.Set("Hidden", false)
	hideCF = nil
	HUD.SetHidden(false)
	local cam = camera()
	if not State.Cinematic then
		cam.CameraType = Enum.CameraType.Custom
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			cam.CameraSubject = humanoid
		end
	end
	if data and data.forced then
		handlers.Scare({ color = Color3.fromRGB(120, 0, 0) })
	end
end

handlers.Lightning = function(data)
	local rng = Random.new(data and data.seed or 1)
	local grade = Lighting:FindFirstChild("Grade")
	local baseAmbient = Lighting.OutdoorAmbient
	local baseBrightness = Lighting.Brightness
	for _ = 1, rng:NextInteger(1, 3) do
		Lighting.OutdoorAmbient = Color3.fromRGB(190, 200, 230)
		Lighting.Brightness = 3
		if grade then
			grade.Brightness = 0.12
		end
		task.wait(0.05 + rng:NextNumber() * 0.08)
		Lighting.OutdoorAmbient = baseAmbient
		Lighting.Brightness = baseBrightness
		if grade then
			grade.Brightness = 0.02
		end
		task.wait(0.06 + rng:NextNumber() * 0.15)
	end
	task.wait(0.8 + rng:NextNumber() * 2)
	Sounds.Play("Thunder", nil, { Volume = 1.5 + rng:NextNumber() })
end

function Cinematics.Play(name: string, data)
	local handler = handlers[name]
	if handler then
		task.spawn(handler, data or {})
	end
end

function Cinematics.Init()
	Net.Event("Cinematic").OnClientEvent:Connect(Cinematics.Play)

	-- hiding: limited free-look through the gap
	UserInputService.InputChanged:Connect(function(input)
		if hideCF and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Delta
			hideYaw = math.clamp(hideYaw - delta.X * 0.004 * State.Settings.sensitivity, -0.6, 0.6)
			hidePitch = math.clamp(hidePitch - delta.Y * 0.004 * State.Settings.sensitivity, -0.35, 0.35)
		end
	end)

	RunService:BindToRenderStep("HotelCinematicFX", Enum.RenderPriority.Camera.Value + 1, function()
		local cam = camera()
		if hideCF then
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = hideCF * CFrame.Angles(0, hideYaw, 0) * CFrame.Angles(hidePitch, 0, 0)
		end
		local now = os.clock()
		if now < shakeUntil then
			local fade = math.clamp((shakeUntil - now) * 2, 0, 1)
			local i = shakeIntensity * fade
			cam.CFrame = cam.CFrame * CFrame.Angles(
				(math.random() - 0.5) * 0.04 * i,
				(math.random() - 0.5) * 0.04 * i,
				(math.random() - 0.5) * 0.03 * i
			)
		else
			shakeIntensity = 0
		end
	end)

	player.CharacterAdded:Connect(function()
		State.Set("Downed", false)
		State.Set("Hidden", false)
		hideCF = nil
		HUD.SetHidden(false)
		HUD.SetDowned(false)
		if busy > 0 then
			busy = 1
			endOverride()
		end
	end)
end

return Cinematics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Input for PC (keyboard/mouse), gamepad and touch (ContextActionService creates the
-- on-screen buttons on mobile/tablet). Movement speed itself is server authoritative;
-- the client only requests a mode.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
local State = require(script.Parent.State)

local Controls = {}
local player = Players.LocalPlayer
local sprintHeld = false
local crouchOn = false
local lastMode = "walk"
local handlers = {} -- external actions registered by other modules

local function sendMode()
	local mode = "walk"
	if crouchOn then
		mode = "crouch"
	elseif sprintHeld then
		mode = "sprint"
	end
	State.Set("Crouching", crouchOn)
	if mode ~= lastMode then
		lastMode = mode
		Net.Event("Move"):FireServer(mode)
	end
end

function Controls.On(action: string, fn: () -> ())
	handlers[action] = fn
end

local function fire(action: string)
	local fn = handlers[action]
	if fn then
		fn()
	end
end

local function bind(name: string, title: string, keys, callback, position: UDim2?)
	ContextActionService:BindAction(name, function(_, inputState, input)
		return callback(inputState, input)
	end, true, table.unpack(keys))
	ContextActionService:SetTitle(name, title)
	if position then
		ContextActionService:SetPosition(name, position)
	end
	local button = ContextActionService:GetButton(name)
	if button then
		button.Size = UDim2.fromOffset(62, 62)
	end
end

function Controls.Init()
	State.IsTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local mobile = State.IsTouch

	bind("Sprint", "ركض", { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3 }, function(inputState, input)
		if State.InputBlocked() then
			sprintHeld = false
			sendMode()
			return Enum.ContextActionResult.Pass
		end
		if input.UserInputType == Enum.UserInputType.Touch then
			if inputState == Enum.UserInputState.Begin then
				sprintHeld = not sprintHeld
				if sprintHeld then
					crouchOn = false
				end
			end
		else
			sprintHeld = inputState == Enum.UserInputState.Begin
			if sprintHeld then
				crouchOn = false
			end
		end
		sendMode()
		return Enum.ContextActionResult.Sink
	end, UDim2.new(1, -150, 1, -150))

	bind("Crouch", "تسلّل", { Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB }, function(inputState)
		if inputState ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if State.InputBlocked() then
			return Enum.ContextActionResult.Pass
		end
		crouchOn = not crouchOn
		if crouchOn then
			sprintHeld = false
		end
		sendMode()
		return Enum.ContextActionResult.Sink
	end, UDim2.new(1, -220, 1, -110))

	local function tap(action: string)
		return function(inputState)
			if inputState ~= Enum.UserInputState.Begin then
				return Enum.ContextActionResult.Pass
			end
			if action ~= "Menu" and action ~= "Inventory" and State.InputBlocked() then
				return Enum.ContextActionResult.Pass
			end
			fire(action)
			return Enum.ContextActionResult.Sink
		end
	end

	bind("Flashlight", "ضوء", { Enum.KeyCode.F, Enum.KeyCode.ButtonY }, tap("Flashlight"), UDim2.new(1, -90, 1, -215))
	bind("Battery", "بطارية", { Enum.KeyCode.R, Enum.KeyCode.DPadUp }, tap("Battery"), UDim2.new(1, -160, 1, -225))
	bind("Bandage", "علاج", { Enum.KeyCode.H, Enum.KeyCode.DPadDown }, tap("Bandage"), UDim2.new(1, -230, 1, -195))
	bind("CameraMode", "منظور", { Enum.KeyCode.V, Enum.KeyCode.DPadRight }, tap("CameraMode"), mobile and UDim2.new(0, 20, 0, 180) or nil)
	bind("Inventory", "حقيبة", { Enum.KeyCode.Tab, Enum.KeyCode.I, Enum.KeyCode.ButtonR1 }, tap("Inventory"), mobile and UDim2.new(0, 20, 0, 250) or nil)
	bind("Menu", "قائمة", { Enum.KeyCode.M, Enum.KeyCode.P, Enum.KeyCode.ButtonStart }, tap("Menu"), mobile and UDim2.new(0, 20, 0, 110) or nil)

	-- keep the server in sync after respawns
	player.CharacterAdded:Connect(function()
		sprintHeld = false
		crouchOn = false
		lastMode = ""
		sendMode()
	end)
	State.Changed:Connect(function(key)
		if (key == "MenuOpen" or key == "PanelOpen" or key == "Cinematic") and State.InputBlocked() then
			sprintHeld = false
			sendMode()
		end
	end)
	-- player attributes drive the sprint FOV
	player:GetAttributeChangedSignal("Stamina"):Connect(function()
		local character = player.Character
		State.Sprinting = character ~= nil and character:GetAttribute("Sprinting") == true
	end)
end

-- Hide/show touch buttons (e.g. during the main menu).
function Controls.SetVisible(visible: boolean)
	for _, name in { "Sprint", "Crouch", "Flashlight", "Battery", "Bandage", "CameraMode", "Inventory" } do
		local button = ContextActionService:GetButton(name)
		if button then
			button.Visible = visible
		end
	end
end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Flashlight</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Local flashlight. The server owns the on/off state and battery (player attributes);
-- the owner renders a smooth camera-attached beam with shadows, everyone else sees the
-- replicated head light. Low battery makes the beam stutter.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Progression = require(Shared.Progression)
local Sounds = require(Shared.Sounds)
local State = require(script.Parent.State)

local Flashlight = {}
local player = Players.LocalPlayer
local holder: Part
local beam: SpotLight
local fill: PointLight
local smoothed = CFrame.new()

local function isOn(): boolean
	return player:GetAttribute("FlashlightOn") == true
end

local function hideServerLight()
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local light = head and head:FindFirstChild("Flashlight")
	if light and light:IsA("Light") then
		light.Enabled = false
	end
end

function Flashlight.Toggle()
	if State.Hidden or State.Downed then
		return
	end
	Sounds.Play("Click")
	Net.Event("Flashlight"):FireServer(not isOn())
end

local function skinColor(): Color3
	local profile = State.Profile
	local skin = profile and Progression.Skins[profile.skin] or Progression.Skins.classic
	return skin.beam
end

function Flashlight.Init()
	holder = Instance.new("Part")
	holder.Name = "LocalFlashlight"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Parent = workspace
	beam = Instance.new("SpotLight")
	beam.Face = Enum.NormalId.Front
	beam.Range = Config.Flashlight.Range
	beam.Angle = Config.Flashlight.Angle
	beam.Brightness = Config.Flashlight.Brightness
	beam.Shadows = true
	beam.Enabled = false
	beam.Parent = holder
	fill = Instance.new("PointLight")
	fill.Range = 7
	fill.Brightness = 0.25
	fill.Shadows = false
	fill.Enabled = false
	fill.Parent = holder

	RunService.RenderStepped:Connect(function(dt)
		local camera = workspace.CurrentCamera
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		local on = isOn() and not State.Hidden and head ~= nil
		local target
		if State.Settings.cameraMode == "first" or not head then
			target = camera.CFrame * CFrame.new(0.5, -0.45, -0.6)
		else
			local look = camera.CFrame.LookVector
			target = CFrame.lookAt(head.Position + look * 1.2 + Vector3.new(0, -0.3, 0), head.Position + look * 20)
		end
		-- slight lag gives the beam weight
		smoothed = smoothed:Lerp(target, math.min(1, dt * 18))
		holder.CFrame = smoothed
		local battery = player:GetAttribute("Battery") or 100
		local flicker = false
		if on and battery < Config.Flashlight.LowBattery then
			flicker = math.random() < (0.08 + (Config.Flashlight.LowBattery - battery) / 60)
		end
		beam.Enabled = on and not flicker
		fill.Enabled = beam.Enabled
		beam.Color = skinColor()
		beam.Brightness = Config.Flashlight.Brightness * (battery < Config.Flashlight.LowBattery and 0.7 or 1)
		beam.Shadows = State.Settings.shadows
	end)

	player.CharacterAdded:Connect(function(character)
		local head = character:WaitForChild("Head", 10)
		if head then
			head.ChildAdded:Connect(function(child)
				if child.Name == "Flashlight" then
					task.defer(hideServerLight)
					child:GetPropertyChangedSignal("Enabled"):Connect(function()
						if child.Enabled then
							child.Enabled = false
						end
					end)
				end
			end)
			hideServerLight()
			local existing = head:FindFirstChild("Flashlight")
			if existing then
				existing:GetPropertyChangedSignal("Enabled"):Connect(function()
					if existing.Enabled then
						existing.Enabled = false
					end
				end)
			end
		end
	end)
end

return Flashlight
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="55">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- THE FORGOTTEN HOTEL - client bootstrap.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Progression = require(Shared.Progression)

local State = require(script.Parent.State)
local Settings = require(script.Parent.Settings)
local CameraController = require(script.Parent.Camera)
local Controls = require(script.Parent.Controls)
local Flashlight = require(script.Parent.Flashlight)
local Prompts = require(script.Parent.Prompts)
local Audio = require(script.Parent.Audio)
local Cinematics = require(script.Parent.Cinematics)
local MonsterAnimator = require(script.Parent.MonsterAnimator)
local HUD = require(script.Parent.UI.HUD)
local Panels = require(script.Parent.UI.Panels)
local Menu = require(script.Parent.UI.Menu)

local player = Players.LocalPlayer

-- the hotel provides its own HUD; keep the chat and player list
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- server state -> client state (connect before anything can arrive)
Net.Event("Profile").OnClientEvent:Connect(function(profile)
	State.Set("Profile", profile)
end)
Net.Event("RunState").OnClientEvent:Connect(function(runState)
	State.Set("RunState", runState)
end)
Net.Event("Achievement").OnClientEvent:Connect(function(id)
	local def = Progression.Achievements[id]
	if def then
		HUD.Toast(def.name, def.desc)
	end
end)

Settings.Init()
HUD.Init()
Panels.Init()
Menu.Init()
CameraController.Init()
Controls.Init()
Flashlight.Init()
Prompts.Init()
Audio.Init()
Cinematics.Init()
MonsterAnimator.Init()

-- actions
Controls.On("Flashlight", Flashlight.Toggle)
Controls.On("Battery", function()
	Net.Event("UseItem"):FireServer("Battery")
end)
Controls.On("Bandage", function()
	Net.Event("UseItem"):FireServer("Bandage")
end)
Controls.On("CameraMode", CameraController.Toggle)
Controls.On("Inventory", function()
	if not State.MenuOpen then
		Panels.Inventory()
	end
end)
Controls.On("Menu", Menu.Toggle)

-- HUD + touch buttons only while actually playing; character controls frozen in menus
local controls = nil
task.spawn(function()
	local ok, module = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
	end)
	if ok and module then
		controls = module:GetControls()
	end
end)

local function refreshMode()
	local playing = State.InRun() and not State.MenuOpen
	HUD.SetVisible(playing)
	Controls.SetVisible(playing)
	if controls then
		if State.MenuOpen or State.PanelOpen == "Ending" then
			controls:Disable()
		else
			controls:Enable()
		end
	end
end
State.Changed:Connect(function(key)
	if key == "MenuOpen" or key == "RunState" or key == "PanelOpen" then
		refreshMode()
	end
end)
refreshMode()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">MonsterAnimator</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Procedural animation for the monster rigs (no animation assets needed). Every client
-- animates nearby monsters locally through Motor6D.Transform, driven by the "Anim" and
-- "Style" attributes the server sets, plus the rig's actual velocity.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local MonsterAnimator = {}
local rigs = {}

local function setup(model: Model)
	if rigs[model] then
		return
	end
	local torso = model:WaitForChild("Torso", 5)
	local root = model:WaitForChild("HumanoidRootPart", 5)
	if not torso or not root then
		return
	end
	local joints = {}
	for _, name in { "Neck", "LShoulder", "RShoulder", "LHip", "RHip" } do
		joints[name] = torso:WaitForChild(name, 5)
	end
	joints.RootJoint = root:WaitForChild("RootJoint", 5)
	rigs[model] = { joints = joints, root = root, t = math.random() * 10, seed = math.random() * 100, twitch = 0, twitchTarget = 0 }
end

local function set(joint: Motor6D?, cf: CFrame)
	if joint then
		joint.Transform = cf
	end
end

local A = CFrame.Angles

local function animateShadow(rig, anim: string, speed: number, t: number)
	local j = rig.joints
	if anim == "attack" then
		local s = math.sin(t * 18) * 0.15
		set(j.LShoulder, A(math.rad(150) + s, 0, math.rad(-15)))
		set(j.RShoulder, A(math.rad(150) - s, 0, math.rad(15)))
		set(j.RootJoint, A(math.rad(-25), 0, 0))
		set(j.Neck, A(math.rad(-20), 0, 0))
		set(j.LHip, A(math.rad(20), 0, 0))
		set(j.RHip, A(math.rad(-20), 0, 0))
		return
	end
	local run = anim == "run"
	local freq = run and 9 or (anim == "walk" and 5 or 0)
	local swing = run and 0.9 or (anim == "walk" and 0.5 or 0)
	local phase = math.sin(t * freq)
	set(j.LHip, A(phase * swing, 0, 0))
	set(j.RHip, A(-phase * swing, 0, 0))
	if run then
		-- arms reach forward, twitching
		local jitter = math.sin(t * 31 + rig.seed) * 0.12
		set(j.LShoulder, A(math.rad(70) + jitter - phase * 0.3, 0, math.rad(-8)))
		set(j.RShoulder, A(math.rad(70) - jitter + phase * 0.3, 0, math.rad(8)))
		set(j.RootJoint, A(math.rad(-22), math.sin(t * freq) * 0.08, 0))
		set(j.Neck, A(math.rad(10), 0, math.sin(t * 13) * 0.15))
	elseif anim == "walk" then
		set(j.LShoulder, A(-phase * 0.35, 0, math.rad(-4)))
		set(j.RShoulder, A(phase * 0.35, 0, math.rad(4)))
		set(j.RootJoint, A(math.rad(-10), 0, math.sin(t * 2.5) * 0.04))
		set(j.Neck, A(0, math.sin(t * 0.7) * 0.4, math.rad(12)))
	else
		local breathe = math.sin(t * 1.4) * 0.05
		set(j.LShoulder, A(breathe, 0, math.rad(-6)))
		set(j.RShoulder, A(breathe, 0, math.rad(6)))
		set(j.RootJoint, A(math.rad(-6) + breathe, 0, 0))
		-- sudden head twitches
		if t > rig.twitch then
			rig.twitch = t + 0.8 + math.random() * 2
			rig.twitchTarget = (math.random() - 0.5) * 1.6
		end
		set(j.Neck, A(0, 0, rig.twitchTarget))
		set(j.LHip, CFrame.new())
		set(j.RHip, CFrame.new())
	end
end

local function animateConcierge(rig, _anim: string, _speed: number, t: number)
	local j = rig.joints
	local breathe = math.sin(t * 1.1) * 0.03
	-- slow, unnatural head tilt; hands folded in front
	set(j.Neck, A(math.rad(-8), 0, math.rad(18) + math.sin(t * 0.35) * math.rad(14)))
	set(j.LShoulder, A(math.rad(30) + breathe, 0, math.rad(25)))
	set(j.RShoulder, A(math.rad(30) + breathe, 0, math.rad(-25)))
	set(j.RootJoint, A(breathe * 0.5 + (math.sin(t * 0.25) > 0.97 and math.rad(25) or 0), 0, 0))
	set(j.LHip, CFrame.new())
	set(j.RHip, CFrame.new())
end

local function animateRoomkeeper(rig, anim: string, _speed: number, t: number)
	local j = rig.joints
	if anim == "attack" then
		set(j.LShoulder, A(math.rad(160), 0, math.rad(-20)))
		set(j.RShoulder, A(math.rad(160), 0, math.rad(20)))
		set(j.RootJoint, A(math.rad(-35), 0, 0))
		set(j.Neck, A(math.rad(-30), 0, math.rad(40)))
		return
	end
	-- hunched, head bent at a wrong angle, arms dangling; "skip" adds violent jerks
	local jerk = anim == "skip" and (math.random() - 0.5) * 0.6 or 0
	set(j.RootJoint, A(math.rad(-28) + jerk * 0.3, jerk, 0))
	set(j.Neck, A(math.rad(15), 0, math.rad(55) + math.sin(t * 0.8) * 0.1 + jerk))
	local sway = math.sin(t * 1.3) * 0.12
	set(j.LShoulder, A(math.rad(25) + sway + jerk, 0, math.rad(-5)))
	set(j.RShoulder, A(math.rad(25) - sway - jerk, 0, math.rad(5)))
	set(j.LHip, A(math.rad(15), 0, 0))
	set(j.RHip, A(math.rad(-5), 0, 0))
end

local STYLES = {
	shadow = animateShadow,
	concierge = animateConcierge,
	roomkeeper = animateRoomkeeper,
}

function MonsterAnimator.Init()
	for _, model in CollectionService:GetTagged("MonsterRig") do
		task.spawn(setup, model)
	end
	CollectionService:GetInstanceAddedSignal("MonsterRig"):Connect(function(model)
		task.spawn(setup, model)
	end)
	CollectionService:GetInstanceRemovedSignal("MonsterRig"):Connect(function(model)
		rigs[model] = nil
	end)
	RunService.Stepped:Connect(function(_, dt)
		local camPos = workspace.CurrentCamera.CFrame.Position
		for model, rig in rigs do
			if not model.Parent then
				continue
			end
			local root = rig.root
			if (root.Position - camPos).Magnitude < 160 then
				rig.t += dt
				local velocity = root.AssemblyLinearVelocity
				local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
				local animate = STYLES[model:GetAttribute("Style")]
				if animate then
					animate(rig, model:GetAttribute("Anim") or "idle", speed, rig.t)
				end
			end
		end
	end)
end

return MonsterAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Prompts</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Custom-styled ProximityPrompts (all server prompts use Style = Custom). Shows the key
-- (keyboard / gamepad) or a tappable button on touch screens, with a hold-progress bar.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local State = require(script.Parent.State)
local Theme = require(script.Parent.UI.Theme)

local Prompts = {}
local player = Players.LocalPlayer
local active: { [ProximityPrompt]: BillboardGui } = {}

local function keyLabel(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType): string
	if inputType == Enum.ProximityPromptInputType.Gamepad then
		local name = prompt.GamepadKeyCode.Name
		return (name:gsub("Button", ""))
	elseif inputType == Enum.ProximityPromptInputType.Touch then
		return "اضغط"
	end
	return prompt.KeyboardKeyCode.Name
end

local function build(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
	local C = Theme.Colors
	local gui = Instance.new("BillboardGui")
	gui.Name = "Prompt"
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Size = UDim2.fromOffset(240, 62)
	gui.StudsOffset = Vector3.new(0, 1, 0)
	gui.Adornee = prompt.Parent
	gui.ResetOnSpawn = false
	gui.Active = inputType == Enum.ProximityPromptInputType.Touch

	local frame = Instance.new("TextButton")
	frame.Name = "Frame"
	frame.AutoButtonColor = false
	frame.Text = ""
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = C.panel
	frame.BackgroundTransparency = 0.15
	frame.Parent = gui
	Theme.Corner(frame, 8)
	Theme.Stroke(frame, C.gold, 1, 0.4)

	local key = Instance.new("TextLabel")
	key.Name = "Key"
	key.Size = UDim2.fromOffset(44, 44)
	key.Position = UDim2.fromOffset(9, 9)
	key.BackgroundColor3 = C.burgundy
	key.TextColor3 = C.gold
	key.Font = Theme.Fonts.ui
	key.TextScaled = true
	key.Text = keyLabel(prompt, inputType)
	key.Parent = frame
	Theme.Corner(key, 6)
	Theme.Stroke(key, C.gold, 1, 0.2)
	Theme.TextLimit(key, 18)

	local action = Instance.new("TextLabel")
	action.Name = "Action"
	action.BackgroundTransparency = 1
	action.Position = UDim2.fromOffset(62, 8)
	action.Size = UDim2.new(1, -70, 0, 26)
	action.Font = Theme.Fonts.title
	action.TextColor3 = C.text
	action.TextXAlignment = Enum.TextXAlignment.Right
	action.TextScaled = true
	action.Text = prompt.ActionText
	action.Parent = frame
	Theme.TextLimit(action, 22)

	local object = Instance.new("TextLabel")
	object.Name = "Object"
	object.BackgroundTransparency = 1
	object.Position = UDim2.fromOffset(62, 34)
	object.Size = UDim2.new(1, -70, 0, 18)
	object.Font = Theme.Fonts.body
	object.TextColor3 = C.dim
	object.TextXAlignment = Enum.TextXAlignment.Right
	object.TextScaled = true
	object.Text = prompt.ObjectText
	object.Parent = frame
	Theme.TextLimit(object, 16)

	local bar = Instance.new("Frame")
	bar.Name = "Hold"
	bar.BorderSizePixel = 0
	bar.BackgroundColor3 = C.gold
	bar.Position = UDim2.new(0, 0, 1, -3)
	bar.Size = UDim2.new(0, 0, 0, 3)
	bar.Parent = frame

	if inputType == Enum.ProximityPromptInputType.Touch or prompt.ClickablePrompt then
		frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				prompt:InputHoldBegin()
			end
		end)
		frame.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				prompt:InputHoldEnd()
			end
		end)
	end

	local conns = {}
	table.insert(conns, prompt:GetPropertyChangedSignal("ActionText"):Connect(function()
		action.Text = prompt.ActionText
	end))
	table.insert(conns, prompt:GetPropertyChangedSignal("ObjectText"):Connect(function()
		object.Text = prompt.ObjectText
	end))
	local holdTween
	table.insert(conns, prompt.PromptButtonHoldBegan:Connect(function()
		if prompt.HoldDuration > 0 then
			bar.Size = UDim2.new(0, 0, 0, 3)
			holdTween = TweenService:Create(bar, TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear), { Size = UDim2.new(1, 0, 0, 3) })
			holdTween:Play()
		end
	end))
	table.insert(conns, prompt.PromptButtonHoldEnded:Connect(function()
		if holdTween then
			holdTween:Cancel()
		end
		bar.Size = UDim2.new(0, 0, 0, 3)
	end))
	table.insert(conns, prompt.Triggered:Connect(function()
		frame.BackgroundColor3 = C.burgundy
		TweenService:Create(frame, TweenInfo.new(0.3), { BackgroundColor3 = C.panel }):Play()
	end))
	gui.Destroying:Connect(function()
		for _, c in conns do
			c:Disconnect()
		end
	end)

	gui.Parent = player:WaitForChild("PlayerGui")
	frame.Size = UDim2.fromScale(0.85, 0.85)
	frame.Position = UDim2.fromScale(0.075, 0.075)
	TweenService:Create(frame, TweenInfo.new(0.12), { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0, 0) }):Play()
	return gui
end

local function disableOwnPrompts(character: Model)
	local function check(d)
		if d:IsA("ProximityPrompt") then
			d.Enabled = false -- local only: you can't revive yourself
		end
	end
	for _, d in character:GetDescendants() do
		check(d)
	end
	character.DescendantAdded:Connect(check)
end

function Prompts.Init()
	ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
			return
		end
		if active[prompt] then
			active[prompt]:Destroy()
		end
		active[prompt] = build(prompt, inputType)
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt)
		local gui = active[prompt]
		if gui then
			active[prompt] = nil
			gui:Destroy()
		end
	end)
	-- no prompts while menus/cinematics are open
	State.Changed:Connect(function(key)
		if key == "MenuOpen" or key == "PanelOpen" or key == "Cinematic" then
			ProximityPromptService.Enabled = not State.InputBlocked()
		end
	end)
	ProximityPromptService.Enabled = not State.InputBlocked()
	player.CharacterAdded:Connect(disableOwnPrompts)
	if player.Character then
		disableOwnPrompts(player.Character)
	end
	local _ = UserInputService
end

return Prompts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Settings</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Applies player settings locally (graphics, audio, camera) and syncs them to the
-- server profile (debounced).

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local State = require(script.Parent.State)

local Settings = {}
local saveToken = 0

local function setEmitters(tag: string, enabled: boolean)
	for _, emitter in CollectionService:GetTagged(tag) do
		if emitter:IsA("ParticleEmitter") then
			emitter.Enabled = enabled
		end
	end
end

function Settings.Apply()
	local s = State.Settings
	local master = s.master
	for name, key in { SFX = "sfx", Music = "music", Ambience = "ambience" } do
		local group = SoundService:FindFirstChild(name)
		if group and group:IsA("SoundGroup") then
			group.Volume = master * s[key]
		end
	end
	setEmitters("AmbientParticles", s.particles)
	setEmitters("Rain", s.rain)
	Lighting.GlobalShadows = s.shadows
	Lighting.ExposureCompensation = s.brightness
	State.Changed:Fire("SettingsApplied", s)
end

function Settings.Get(key: string)
	return State.Settings[key]
end

function Settings.Set(key: string, value: any)
	local range = Config.SettingRanges[key]
	if range and typeof(value) == "number" then
		value = math.clamp(math.floor(value * 100 + 0.5) / 100, range[1], range[2])
	end
	State.Settings[key] = value
	Settings.Apply()
	saveToken += 1
	local token = saveToken
	task.delay(1.2, function()
		if token == saveToken then
			Net.Event("Settings"):FireServer(State.Settings)
		end
	end)
end

function Settings.Init()
	CollectionService:GetInstanceAddedSignal("AmbientParticles"):Connect(function(emitter)
		if emitter:IsA("ParticleEmitter") then
			emitter.Enabled = State.Settings.particles
		end
	end)
	CollectionService:GetInstanceAddedSignal("Rain"):Connect(function(emitter)
		if emitter:IsA("ParticleEmitter") then
			emitter.Enabled = State.Settings.rain
		end
	end)
	local loadedOnce = false
	State.Changed:Connect(function(key, profile)
		if key == "Profile" and profile and not loadedOnce then
			loadedOnce = true
			for k, v in profile.settings or {} do
				if Config.DefaultSettings[k] ~= nil then
					State.Settings[k] = v
				end
			end
			Settings.Apply()
		end
	end)
	Settings.Apply()
end

return Settings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client-side state store shared between controllers and UI.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)

local State = {
	Profile = nil,
	RunState = { state = "Lobby", players = {}, host = 0, difficulty = "Normal", mission = 0 },
	Inventory = {},
	Mission = { index = 0, id = "", progress = nil },
	Settings = table.clone(Config.DefaultSettings),
	MenuOpen = true,
	PanelOpen = nil :: string?,
	Cinematic = false,
	Hidden = false,
	Downed = false,
	Threat = 0,
	Crouching = false,
	Sprinting = false,
	IsTouch = false,
	Changed = Signal.new(), -- (key, value)
}

function State.Set(key: string, value: any)
	State[key] = value
	State.Changed:Fire(key, value)
end

function State.InRun(): boolean
	local localPlayer = game:GetService("Players").LocalPlayer
	if State.RunState.state ~= "Playing" then
		return false
	end
	for _, p in State.RunState.players or {} do
		if p.userId == localPlayer.UserId then
			return p.inRun == true
		end
	end
	return false
end

-- True while gameplay input should be ignored (menus, panels, cinematics).
function State.InputBlocked(): boolean
	return State.MenuOpen or State.PanelOpen ~= nil or State.Cinematic
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="60">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!nonstrict
-- In-game HUD: health / stamina / flashlight battery, objective panel, inventory hotbar,
-- notifications, achievement toasts, subtitles, and full-screen overlays (vignette,
-- damage, downed, death, hiding, letterbox, flash).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared.Items)
local MissionDefs = require(Shared.Missions)
local Net = require(Shared.Net)
local Sounds = require(Shared.Sounds)
local Config = require(Shared.Config)

local State = require(script.Parent.Parent.State)
local Theme = require(script.Parent.Theme)
local C, F = Theme.Colors, Theme.Fonts

local HUD = {}
local player = Players.LocalPlayer
local gui: ScreenGui
local overlay: ScreenGui
local refs = {}

local function tween(obj, time, props, style)
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

----------------------------------------------------------------------------------------
-- Bars (top-left)
----------------------------------------------------------------------------------------

local function bar(parent, order: number, icon: string, color: Color3, height: number)
	local row = Theme.New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height + 6), LayoutOrder = order, Parent = parent })
	Theme.Label(row, icon, { dims = UDim2.fromOffset(22, height + 6), font = F.ui, color = color, align = Enum.TextXAlignment.Center, max = 18 })
	local back = Theme.New("Frame", {
		BackgroundColor3 = Color3.fromRGB(10, 8, 9),
		BackgroundTransparency = 0.25,
		Position = UDim2.new(0, 28, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(1, -28, 0, height),
		Parent = row,
	})
	Theme.Corner(back, 3)
	Theme.Stroke(back, C.gold, 1, 0.6)
	local fill = Theme.New("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(1, 1), Parent = back })
	Theme.Corner(fill, 3)
	Theme.Gradient(fill, color, color:Lerp(Color3.new(0, 0, 0), 0.45), 90)
	local text = Theme.Label(back, "", { font = F.ui, color = C.text, align = Enum.TextXAlignment.Right, dims = UDim2.new(1, -6, 1, 0), max = 12, z = 3 })
	return fill, text, row
end

local function buildBars()
	local holder = Theme.New("Frame", {
		Name = "Vitals",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 18),
		Size = UDim2.new(0.22, 0, 0, 90),
		Parent = gui,
	})
	Theme.New("UISizeConstraint", { MinSize = Vector2.new(170, 0), MaxSize = Vector2.new(300, 200), Parent = holder })
	Theme.List(holder, 2)
	refs.health, refs.healthText = bar(holder, 1, "♥", Color3.fromRGB(170, 30, 36), 14)
	refs.stamina, _, refs.staminaRow = bar(holder, 2, "»", C.gold, 7)
	refs.battery, refs.batteryText = bar(holder, 3, "🔦", C.cold, 11)
	refs.vitals = holder
end

----------------------------------------------------------------------------------------
-- Objective (top-right)
----------------------------------------------------------------------------------------

local function buildObjective()
	local panel = Theme.New("Frame", {
		Name = "Objective",
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.35,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 18),
		Size = UDim2.new(0.28, 0, 0, 100),
		Parent = gui,
	})
	Theme.New("UISizeConstraint", { MinSize = Vector2.new(200, 0), MaxSize = Vector2.new(380, 200), Parent = panel })
	Theme.Corner(panel, 8)
	Theme.Stroke(panel, C.gold, 1, 0.6)
	Theme.Padding(panel, 10)
	refs.objHeader = Theme.Label(panel, "المهمة", { font = F.bold, color = C.gold, dims = UDim2.new(1, 0, 0, 14), max = 12 })
	refs.objTitle = Theme.Label(panel, "", { font = F.title, color = C.text, dims = UDim2.new(1, 0, 0, 24), pos = UDim2.fromOffset(0, 16), max = 22 })
	refs.objDesc = Theme.Label(panel, "", { font = F.body, color = C.dim, dims = UDim2.new(1, 0, 0, 38), pos = UDim2.fromOffset(0, 42), max = 16, valign = Enum.TextYAlignment.Top })
	refs.objProgress = Theme.Label(panel, "", { font = F.ui, color = C.gold, dims = UDim2.new(1, 0, 0, 14), pos = UDim2.new(0, 0, 1, -14), max = 12 })
	refs.objective = panel
	panel.Visible = false
end

function HUD.Objective(index: number, id: string, progress: string?)
	local def = MissionDefs[index]
	if not def then
		refs.objective.Visible = false
		return
	end
	local changed = refs.objTitle.Text ~= def.title
	refs.objective.Visible = true
	refs.objHeader.Text = string.format("المهمة %d / %d", index, #MissionDefs)
	refs.objTitle.Text = def.title
	refs.objDesc.Text = def.desc
	refs.objProgress.Text = progress or ""
	if changed then
		refs.objective.Position = UDim2.new(1, 30, 0, 18)
		tween(refs.objective, 0.6, { Position = UDim2.new(1, -18, 0, 18) }, Enum.EasingStyle.Back)
		HUD.Banner("مهمة جديدة", def.title)
	end
end

----------------------------------------------------------------------------------------
-- Hotbar (bottom-centre)
----------------------------------------------------------------------------------------

local function buildHotbar()
	local bar = Theme.New("Frame", {
		Name = "Hotbar",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.new(0.6, 0, 0, 58),
		Parent = gui,
	})
	local layout = Theme.List(bar, 6, true, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	refs.hotbar = bar
end

function HUD.RefreshInventory()
	for _, child in refs.hotbar:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for i, entry in State.Inventory do
		local def = Items[entry.id]
		if def then
			local slot = Theme.New("TextButton", {
				AutoButtonColor = false,
				Text = "",
				BackgroundColor3 = C.panel,
				BackgroundTransparency = 0.2,
				Size = UDim2.fromOffset(52, 52),
				LayoutOrder = i,
				Parent = refs.hotbar,
			})
			Theme.Corner(slot, 6)
			Theme.Stroke(slot, def.critical and C.gold or C.goldDim, 1, 0.3)
			Theme.Label(slot, def.icon, { dims = UDim2.new(1, 0, 0.7, 0), font = F.ui, align = Enum.TextXAlignment.Center, max = 26 })
			Theme.Label(slot, entry.count > 1 and ("x" .. entry.count) or "", { dims = UDim2.new(1, -4, 0.3, 0), pos = UDim2.fromScale(0, 0.7), font = F.bold, color = C.gold, align = Enum.TextXAlignment.Right, max = 12 })
			slot.Activated:Connect(function()
				if entry.id == "Battery" or entry.id == "Bandage" then
					Net.Event("UseItem"):FireServer(entry.id)
				else
					HUD.Notify(def.name .. " - " .. def.desc, "info")
				end
			end)
		end
	end
end

----------------------------------------------------------------------------------------
-- Notifications, toasts, banners, subtitles
----------------------------------------------------------------------------------------

local KIND_COLORS = {
	info = C.text,
	item = C.gold,
	warn = Color3.fromRGB(230, 180, 90),
	danger = C.danger,
	doc = Color3.fromRGB(220, 200, 160),
	objective = C.good,
}

function HUD.Notify(text: string, kind: string?)
	local holder = refs.feed
	local label = Theme.Label(holder, text, {
		dims = UDim2.new(1, 0, 0, 24),
		font = F.body,
		color = KIND_COLORS[kind or "info"] or C.text,
		align = Enum.TextXAlignment.Center,
		max = 20,
		order = math.floor(os.clock() * 100) % 1e6,
	})
	Theme.Stroke(label, Color3.new(0, 0, 0), 1, 0.4).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	label.TextTransparency = 1
	tween(label, 0.25, { TextTransparency = 0 })
	local children = {}
	for _, c in holder:GetChildren() do
		if c:IsA("TextLabel") then
			table.insert(children, c)
		end
	end
	if #children > 4 then
		table.sort(children, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		children[1]:Destroy()
	end
	task.delay(5, function()
		if label.Parent then
			tween(label, 0.6, { TextTransparency = 1 })
			task.wait(0.6)
			label:Destroy()
		end
	end)
	if kind == "danger" then
		Sounds.Play("Sting", nil, { Volume = 0.4 })
	end
end

function HUD.Banner(small: string, big: string)
	local b = refs.banner
	refs.bannerSmall.Text = small
	refs.bannerBig.Text = big
	b.Visible = true
	refs.bannerSmall.TextTransparency = 1
	refs.bannerBig.TextTransparency = 1
	tween(refs.bannerSmall, 0.5, { TextTransparency = 0 })
	tween(refs.bannerBig, 0.8, { TextTransparency = 0 })
	local token = os.clock()
	b:SetAttribute("Token", token)
	task.delay(3.4, function()
		if b:GetAttribute("Token") == token then
			tween(refs.bannerSmall, 0.8, { TextTransparency = 1 })
			tween(refs.bannerBig, 0.8, { TextTransparency = 1 })
		end
	end)
end

function HUD.Toast(title: string, desc: string)
	local toast = Theme.Panel(gui, {
		name = "Toast",
		dims = UDim2.fromOffset(320, 64),
		pos = UDim2.new(0.5, 0, 0, -80),
		anchor = Vector2.new(0.5, 0),
		z = 20,
	})
	Theme.Label(toast, "🏆", { dims = UDim2.fromOffset(50, 64), font = F.ui, align = Enum.TextXAlignment.Center, max = 30, z = 21 })
	Theme.Label(toast, "إنجاز جديد", { dims = UDim2.new(1, -60, 0, 14), pos = UDim2.fromOffset(54, 8), font = F.bold, color = C.gold, max = 11, z = 21 })
	Theme.Label(toast, title, { dims = UDim2.new(1, -60, 0, 22), pos = UDim2.fromOffset(54, 22), font = F.title, max = 20, z = 21 })
	Theme.Label(toast, desc, { dims = UDim2.new(1, -60, 0, 14), pos = UDim2.fromOffset(54, 44), font = F.body, color = C.dim, max = 13, z = 21 })
	Sounds.Play("Ding", nil, { PlaybackSpeed = 1.3, Volume = 0.5 })
	tween(toast, 0.5, { Position = UDim2.new(0.5, 0, 0, 16) }, Enum.EasingStyle.Back)
	task.delay(4.5, function()
		tween(toast, 0.4, { Position = UDim2.new(0.5, 0, 0, -80) })
		task.wait(0.5)
		toast:Destroy()
	end)
end

function HUD.Subtitle(text: string, duration: number?, style: string?)
	local label = refs.subtitle
	label.Text = text
	label.Font = style == "whisper" and F.body or F.body
	label.TextColor3 = style == "whisper" and Color3.fromRGB(170, 180, 200) or (style == "voice" and C.gold or C.text)
	label.TextTransparency = 1
	tween(label, 0.3, { TextTransparency = 0 })
	local token = os.clock()
	label:SetAttribute("Token", token)
	task.delay(duration or 4, function()
		if label:GetAttribute("Token") == token then
			tween(label, 0.6, { TextTransparency = 1 })
		end
	end)
end

----------------------------------------------------------------------------------------
-- Overlays
----------------------------------------------------------------------------------------

function HUD.Flash(color: Color3?, duration: number?)
	local f = refs.flash
	f.BackgroundColor3 = color or Color3.new(1, 1, 1)
	f.BackgroundTransparency = 0.05
	tween(f, duration or 0.6, { BackgroundTransparency = 1 })
end

function HUD.Hurt(intensity: number)
	local v = refs.hurt
	v.Visible = true
	for _, strip in v:GetChildren() do
		if strip:IsA("Frame") then
			strip.BackgroundTransparency = 0
			tween(strip, 1.2, { BackgroundTransparency = 1 - 0 })
		end
	end
	v:SetAttribute("Until", os.clock() + 0.9 + intensity)
end

function HUD.SetDowned(on: boolean, seconds: number?)
	refs.downed.Visible = on
	if on then
		local endAt = os.clock() + (seconds or 45)
		task.spawn(function()
			while refs.downed.Visible do
				local left = math.max(0, endAt - os.clock())
				refs.downedTimer.Text = string.format("تنزف... %d", math.ceil(left))
				task.wait(0.2)
			end
		end)
	end
end

function HUD.Died(respawn: number)
	local d = refs.death
	d.Visible = true
	d.BackgroundTransparency = 1
	tween(d, 1.2, { BackgroundTransparency = 0.1 })
	refs.deathTitle.TextTransparency = 1
	tween(refs.deathTitle, 1.5, { TextTransparency = 0 })
	task.delay(respawn + 0.8, function()
		tween(d, 1, { BackgroundTransparency = 1 })
		tween(refs.deathTitle, 0.8, { TextTransparency = 1 })
		task.wait(1)
		d.Visible = false
	end)
end

function HUD.SetHidden(on: boolean, kind: string?)
	refs.hide.Visible = on
	refs.hideSlats.Visible = on and kind ~= "bed"
	refs.hideBed.Visible = on and kind == "bed"
end

function HUD.Letterbox(on: boolean)
	tween(refs.letterTop, 0.5, { Size = UDim2.new(1, 0, on and 0.09 or 0, 0) })
	tween(refs.letterBottom, 0.5, { Size = UDim2.new(1, 0, on and 0.09 or 0, 0) })
end

function HUD.SetVisible(visible: boolean)
	gui.Enabled = visible
end

local function buildOverlays()
	overlay = Theme.New("ScreenGui", {
		Name = "HotelOverlay",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	refs.vignette = Theme.Vignette(overlay, Color3.new(0, 0, 0), 0.75, 1)
	refs.hurt = Theme.Vignette(overlay, Color3.fromRGB(140, 0, 0), 0.9, 2)
	refs.hurt.Visible = false
	refs.threat = Theme.Vignette(overlay, Color3.fromRGB(60, 0, 0), 0.6, 2)
	-- hiding: wardrobe slats / under-bed darkness
	refs.hide = Theme.New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 3, Parent = overlay })
	refs.hideSlats = Theme.New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = refs.hide })
	for i = 0, 13 do
		Theme.New("Frame", {
			BackgroundColor3 = Color3.fromRGB(14, 9, 7),
			Size = UDim2.new(1, 0, 1 / 14, -10),
			Position = UDim2.new(0, 0, i / 14, 0),
			ZIndex = 3,
			Parent = refs.hideSlats,
		})
	end
	refs.hideBed = Theme.New("Frame", { BackgroundColor3 = Color3.fromRGB(6, 5, 5), Size = UDim2.fromScale(1, 0.62), ZIndex = 3, Parent = refs.hide })
	Theme.Gradient(refs.hideBed, Color3.new(0, 0, 0), Color3.new(0, 0, 0), 90).Transparency = NumberSequence.new(0, 0.15)
	local leave = Theme.Button(refs.hide, "اخرج  [E]", function()
		Net.Event("Hide"):FireServer()
	end, { dims = UDim2.fromOffset(170, 46), pos = UDim2.new(0.5, 0, 1, -40), anchor = Vector2.new(0.5, 1), z = 5 })
	leave.ZIndex = 5
	Theme.Label(refs.hide, "أنت مختبئ. ابقَ هادئًا. لا تدعه يراك وأنت تدخل.", { dims = UDim2.new(1, 0, 0, 22), pos = UDim2.new(0, 0, 1, -100), font = F.body, color = C.dim, align = Enum.TextXAlignment.Center, max = 18, z = 5 })
	-- letterbox
	refs.letterTop = Theme.New("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.new(1, 0, 0, 0), ZIndex = 6, Parent = overlay })
	refs.letterBottom = Theme.New("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 0), ZIndex = 6, Parent = overlay })
	-- subtitles
	refs.subtitle = Theme.Label(overlay, "", {
		dims = UDim2.new(0.8, 0, 0, 34),
		pos = UDim2.new(0.5, 0, 0.8, 0),
		anchor = Vector2.new(0.5, 0.5),
		font = F.body,
		align = Enum.TextXAlignment.Center,
		max = 26,
		z = 7,
	})
	Theme.Stroke(refs.subtitle, Color3.new(0, 0, 0), 1.5, 0.2).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	refs.subtitle.TextTransparency = 1
	-- downed
	refs.downed = Theme.New("Frame", { BackgroundColor3 = Color3.fromRGB(60, 0, 0), BackgroundTransparency = 0.55, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 8, Parent = overlay })
	Theme.Label(refs.downed, "لقد سقطت", { dims = UDim2.new(1, 0, 0, 60), pos = UDim2.fromScale(0, 0.38), font = F.title, color = C.text, align = Enum.TextXAlignment.Center, max = 54, z = 9 })
	refs.downedTimer = Theme.Label(refs.downed, "", { dims = UDim2.new(1, 0, 0, 26), pos = UDim2.fromScale(0, 0.38 + 0.08), font = F.body, color = C.dim, align = Enum.TextXAlignment.Center, max = 22, z = 9 })
	Theme.Label(refs.downed, "ازحف إلى مكان آمن. يمكن لأحد رفاقك إنعاشك.", { dims = UDim2.new(1, 0, 0, 22), pos = UDim2.fromScale(0, 0.38 + 0.13), font = F.body, color = C.dim, align = Enum.TextXAlignment.Center, max = 18, z = 9 })
	-- death
	refs.death = Theme.New("Frame", { BackgroundColor3 = Color3.fromRGB(5, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 10, Parent = overlay })
	refs.deathTitle = Theme.Label(refs.death, "لقد متّ", { dims = UDim2.new(1, 0, 0, 80), pos = UDim2.fromScale(0, 0.42), font = F.horror, color = C.danger, align = Enum.TextXAlignment.Center, max = 80, z = 11 })
	-- flash
	refs.flash = Theme.New("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 12, Parent = overlay })
end

----------------------------------------------------------------------------------------
-- Init / update
----------------------------------------------------------------------------------------

function HUD.Init()
	gui = Theme.New("ScreenGui", {
		Name = "HotelHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 4,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	buildOverlays()
	buildBars()
	buildObjective()
	buildHotbar()
	refs.feed = Theme.New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -90),
		Size = UDim2.new(0.6, 0, 0, 120),
		Parent = gui,
	})
	local feedLayout = Theme.List(refs.feed, 2, false, Enum.HorizontalAlignment.Center)
	feedLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	refs.banner = Theme.New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.2), Size = UDim2.new(0.7, 0, 0, 80), Visible = false, Parent = gui })
	refs.bannerSmall = Theme.Label(refs.banner, "", { dims = UDim2.new(1, 0, 0, 18), font = F.bold, color = C.gold, align = Enum.TextXAlignment.Center, max = 14 })
	refs.bannerBig = Theme.Label(refs.banner, "", { dims = UDim2.new(1, 0, 0, 48), pos = UDim2.fromOffset(0, 20), font = F.title, color = C.text, align = Enum.TextXAlignment.Center, max = 42 })
	refs.crosshair = Theme.New("Frame", { BackgroundColor3 = C.text, BackgroundTransparency = 0.5, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), Parent = gui })
	Theme.Corner(refs.crosshair, 2)

	RunService.RenderStepped:Connect(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			local pct = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
			refs.health.Size = UDim2.fromScale(pct, 1)
			refs.healthText.Text = tostring(math.ceil(humanoid.Health))
		end
		local stamina = (player:GetAttribute("Stamina") or 100) / Config.Movement.StaminaMax
		refs.stamina.Size = UDim2.fromScale(stamina, 1)
		refs.staminaRow.Visible = stamina < 0.99
		local battery = player:GetAttribute("Battery") or 100
		refs.battery.Size = UDim2.fromScale(battery / 100, 1)
		refs.battery.BackgroundColor3 = battery < Config.Flashlight.LowBattery and C.danger or C.cold
		refs.batteryText.Text = string.format("%d%%%s", math.floor(battery), player:GetAttribute("FlashlightOn") and " يعمل" or "")
		refs.crosshair.Visible = State.Settings.cameraMode == "first" and not State.Hidden
		-- threat vignette pulses with the heartbeat
		local threat = State.Threat or 0
		local pulse = threat > 0.3 and (0.5 + 0.5 * math.sin(os.clock() * (4 + threat * 6))) or 0
		for _, strip in refs.threat:GetChildren() do
			strip.BackgroundTransparency = 1 - threat * (0.6 + pulse * 0.4)
		end
		if refs.hurt.Visible and os.clock() > (refs.hurt:GetAttribute("Until") or 0) then
			refs.hurt.Visible = false
		end
	end)

	State.Changed:Connect(function(key)
		if key == "Inventory" then
			HUD.RefreshInventory()
		end
	end)
	Net.Event("Notify").OnClientEvent:Connect(HUD.Notify)
	Net.Event("Objective").OnClientEvent:Connect(function(index, id, progress)
		State.Set("Mission", { index = index, id = id, progress = progress })
		HUD.Objective(index, id, progress)
	end)
	Net.Event("Inventory").OnClientEvent:Connect(function(list)
		State.Set("Inventory", list)
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Main menu, multiplayer lobby, settings (graphics / audio / camera / controls) and extras
-- (achievements, flashlight skins, document archive, endings, stats). Doubles as the
-- pause menu during a run.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Documents = require(Shared.Documents)
local MissionDefs = require(Shared.Missions)
local Net = require(Shared.Net)
local Progression = require(Shared.Progression)

local State = require(script.Parent.Parent.State)
local Settings = require(script.Parent.Parent.Settings)
local Theme = require(script.Parent.Theme)
local Panels = require(script.Parent.Panels)
local C, F = Theme.Colors, Theme.Fonts

local Menu = {}
local player = Players.LocalPlayer
local gui: ScreenGui
local root: Frame
local sidePanel: Frame
local buttons = {}
local page: Frame? = nil
local coinsLabel: TextLabel

local function lobbyAction(action: string, arg: any?)
	Net.Event("Lobby"):FireServer(action, arg)
end

local function isHost(): boolean
	return State.RunState.host == player.UserId
end

local function clearPage()
	if page then
		page:Destroy()
		page = nil
	end
end

local function newPage(title: string): Frame
	clearPage()
	page = Theme.Panel(root, {
		name = "Page",
		dims = UDim2.new(0.56, 0, 0.74, 0),
		pos = UDim2.new(0.97, 0, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		maxSize = Vector2.new(760, 640),
		z = 3,
	})
	Theme.Label(page, title, { dims = UDim2.new(1, -40, 0, 34), pos = UDim2.fromOffset(20, 14), font = F.title, color = C.gold, max = 30, z = 4 })
	Theme.Button(page, "✕", clearPage, { dims = UDim2.fromOffset(34, 34), pos = UDim2.new(1, -10, 0, 10), anchor = Vector2.new(1, 0), font = F.ui, z = 5 }).ZIndex = 5
	return page
end

local function scrollArea(parent: Instance, top: number?)
	local scroll = Theme.New("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, top or 58),
		Size = UDim2.new(1, -40, 1, -(top or 58) - 16),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.gold,
		ZIndex = 4,
		Parent = parent,
	})
	Theme.List(scroll, 6)
	return scroll
end

local function tabs(parent: Frame, names: { string }, onSelect: (string) -> ())
	local bar = Theme.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 54), Size = UDim2.new(1, -40, 0, 34), ZIndex = 4, Parent = parent })
	Theme.List(bar, 6, true)
	local tabButtons = {}
	local function select(name)
		for n, b in tabButtons do
			b.BackgroundColor3 = n == name and C.burgundy or C.panel2
		end
		onSelect(name)
	end
	for i, name in names do
		local b = Theme.Button(bar, name, function()
			select(name)
		end, { dims = UDim2.new(1 / #names, -6, 1, 0), order = i, font = F.bold, max = 13, z = 5 })
		b.ZIndex = 5
		tabButtons[name] = b
	end
	select(names[1])
end

----------------------------------------------------------------------------------------
-- Settings
----------------------------------------------------------------------------------------

local function settingRow(parent: Instance, order: number, label: string, getText: () -> string, onMinus: (() -> ())?, onPlus: (() -> ())?)
	local row = Theme.New("Frame", { BackgroundColor3 = C.panel2, BackgroundTransparency = 0.4, Size = UDim2.new(1, -8, 0, 44), LayoutOrder = order, ZIndex = 4, Parent = parent })
	Theme.Corner(row, 6)
	Theme.Label(row, label, { dims = UDim2.new(0.5, -10, 1, 0), pos = UDim2.fromOffset(12, 0), font = F.body, max = 19, z = 5 })
	local value = Theme.Label(row, getText(), { dims = UDim2.new(0.25, 0, 1, 0), pos = UDim2.fromScale(0.58, 0), font = F.ui, color = C.gold, align = Enum.TextXAlignment.Center, max = 16, z = 5 })
	local function refresh()
		value.Text = getText()
	end
	if onMinus then
		Theme.Button(row, "−", function()
			onMinus()
			refresh()
		end, { dims = UDim2.fromOffset(36, 32), pos = UDim2.new(0.5, 0, 0.5, 0), anchor = Vector2.new(0, 0.5), font = F.ui, z = 6 }).ZIndex = 6
	end
	if onPlus then
		Theme.Button(row, "+", function()
			onPlus()
			refresh()
		end, { dims = UDim2.fromOffset(36, 32), pos = UDim2.new(1, -8, 0.5, 0), anchor = Vector2.new(1, 0.5), font = F.ui, z = 6 }).ZIndex = 6
	end
	return row
end

local function numberSetting(parent, order, label, key, step, fmt)
	settingRow(parent, order, label, function()
		return string.format(fmt or "%.2f", State.Settings[key])
	end, function()
		Settings.Set(key, State.Settings[key] - step)
	end, function()
		Settings.Set(key, State.Settings[key] + step)
	end)
end

local function toggleSetting(parent, order, label, key)
	settingRow(parent, order, label, function()
		return State.Settings[key] and "تشغيل" or "إيقاف"
	end, nil, function()
		Settings.Set(key, not State.Settings[key])
	end)
end

local function showSettings()
	local p = newPage("الإعدادات")
	local content
	tabs(p, { "الرسوميات", "الصوت", "الكاميرا", "التحكم" }, function(tab)
		if content then
			content:Destroy()
		end
		content = scrollArea(p, 100)
		if tab == "الرسوميات" then
			toggleSetting(content, 1, "جزيئات الغبار", "particles")
			toggleSetting(content, 2, "المطر", "rain")
			toggleSetting(content, 3, "الظلال الديناميكية", "shadows")
			numberSetting(content, 4, "السطوع", "brightness", 0.05)
			Theme.Label(content, "نصيحة: على الهواتف الضعيفة أوقف الظلال والجزيئات. يضبط Roblox الجودة تلقائيًا أيضًا (Esc > الإعدادات > الرسوميات).", { dims = UDim2.new(1, -8, 0, 44), font = F.body, color = C.dim, max = 15, order = 9, z = 4 })
		elseif tab == "الصوت" then
			numberSetting(content, 1, "الصوت العام", "master", 0.1)
			numberSetting(content, 2, "الموسيقى", "music", 0.1)
			numberSetting(content, 3, "المؤثرات الصوتية", "sfx", 0.1)
			numberSetting(content, 4, "الأجواء", "ambience", 0.1)
		elseif tab == "الكاميرا" then
			settingRow(content, 1, "وضع الكاميرا", function()
				return State.Settings.cameraMode == "first" and "منظور الشخص الأول" or "منظور الشخص الثالث"
			end, nil, function()
				Settings.Set("cameraMode", State.Settings.cameraMode == "first" and "third" or "first")
			end)
			numberSetting(content, 2, "مجال الرؤية", "fov", 5, "%d")
			numberSetting(content, 3, "الحساسية", "sensitivity", 0.1)
			toggleSetting(content, 4, "اهتزاز الرأس", "headBob")
		else
			local lines = {
				"الحركة ........... WASD / العصا اليسرى / عصا اللمس",
				"تفاعل ........... E / زر X / المس الإشارة",
				"المصباح ......... F / زر Y / ضوء",
				"الركض (مطولًا) .. Shift / L3 / ركض (تبديل)",
				"التسلّل .......... C أو Ctrl / زر B / تسلّل",
				"تبديل البطارية .. R / السهم للأعلى / بطارية",
				"ضمادة ........... H / السهم للأسفل / علاج",
				"منظور الكاميرا .. V / السهم لليمين / منظور",
				"الحقيبة ......... Tab أو I / R1 / حقيبة",
				"القائمة ......... M أو P / Start / قائمة",
			}
			for i, text in lines do
				Theme.Label(content, text, { dims = UDim2.new(1, -8, 0, 26), font = Enum.Font.Code, color = C.text, max = 16, order = i, z = 4 })
			end
		end
	end)
end

----------------------------------------------------------------------------------------
-- Extras
----------------------------------------------------------------------------------------

local function showExtras()
	local p = newPage("الإضافات")
	local content
	tabs(p, { "الإنجازات", "المظاهر", "الأرشيف", "النهايات", "الإحصائيات" }, function(tab)
		if content then
			content:Destroy()
		end
		content = scrollArea(p, 100)
		local profile = State.Profile or { achievements = {}, skins = {}, docs = {}, endings = {}, stats = {}, coins = 0 }
		if tab == "الإنجازات" then
			for i, id in Progression.AchievementOrder do
				local def = Progression.Achievements[id]
				local got = profile.achievements[id] ~= nil
				local row = Theme.New("Frame", { BackgroundColor3 = got and C.deep or C.panel2, BackgroundTransparency = 0.3, Size = UDim2.new(1, -8, 0, 50), LayoutOrder = i, ZIndex = 4, Parent = content })
				Theme.Corner(row, 6)
				Theme.Label(row, got and "🏆" or "🔒", { dims = UDim2.fromOffset(46, 50), font = F.ui, align = Enum.TextXAlignment.Center, max = 22, z = 5 })
				Theme.Label(row, def.name, { dims = UDim2.new(1, -60, 0, 24), pos = UDim2.fromOffset(50, 4), font = F.title, color = got and C.gold or C.dim, max = 19, z = 5 })
				Theme.Label(row, def.desc, { dims = UDim2.new(1, -60, 0, 18), pos = UDim2.fromOffset(50, 28), font = F.body, color = C.dim, max = 14, z = 5 })
			end
		elseif tab == "المظاهر" then
			for i, id in Progression.SkinOrder do
				local skin = Progression.Skins[id]
				local owned = profile.skins[id] == true
				local equipped = profile.skin == id
				local row = Theme.New("Frame", { BackgroundColor3 = C.panel2, BackgroundTransparency = 0.3, Size = UDim2.new(1, -8, 0, 54), LayoutOrder = i, ZIndex = 4, Parent = content })
				Theme.Corner(row, 6)
				local swatch = Theme.New("Frame", { BackgroundColor3 = skin.beam, Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(34, 34), ZIndex = 5, Parent = row })
				Theme.Corner(swatch, 17)
				Theme.Stroke(swatch, skin.body, 3, 0)
				Theme.Label(row, skin.name, { dims = UDim2.new(1, -200, 0, 24), pos = UDim2.fromOffset(54, 6), font = F.title, color = owned and C.text or C.dim, max = 19, z = 5 })
				local how = skin.unlock and ("يُفتح بـ: " .. Progression.Achievements[skin.unlock].name) or "افتراضي"
				Theme.Label(row, how, { dims = UDim2.new(1, -200, 0, 18), pos = UDim2.fromOffset(54, 30), font = F.body, color = C.dim, max = 14, z = 5 })
				local b = Theme.Button(row, equipped and "مُجهَّز" or (owned and "تجهيز" or "مقفل"), function()
					Net.Event("EquipSkin"):FireServer(id)
				end, { dims = UDim2.fromOffset(110, 36), pos = UDim2.new(1, -10, 0.5, 0), anchor = Vector2.new(1, 0.5), font = F.bold, max = 13, z = 6 })
				b.ZIndex = 6
				Theme.SetDisabled(b, not owned or equipped)
			end
		elseif tab == "الأرشيف" then
			for i, id in Documents.Order do
				local doc = Documents[id]
				local read = profile.docs[id] == true
				local b = Theme.Button(content, read and doc.title or "??? - " .. doc.where, function()
					if read then
						Menu.Close(true)
						Panels.Document(id)
					end
				end, { dims = UDim2.new(1, -8, 0, 40), order = i, font = F.body, align = Enum.TextXAlignment.Right, max = 17, z = 5 })
				b.ZIndex = 5
				Theme.SetDisabled(b, not read)
			end
		elseif tab == "النهايات" then
			local order = { "escape", "liberation", "concierge", "secret" }
			for i, id in order do
				local ending = Progression.Endings[id]
				local got = profile.endings[id] == true
				local row = Theme.New("Frame", { BackgroundColor3 = got and C.deep or C.panel2, BackgroundTransparency = 0.3, Size = UDim2.new(1, -8, 0, 56), LayoutOrder = i, ZIndex = 4, Parent = content })
				Theme.Corner(row, 6)
				Theme.Label(row, got and ending.title or "? ? ?", { dims = UDim2.new(1, -20, 0, 26), pos = UDim2.fromOffset(12, 4), font = F.title, color = got and C.gold or C.dim, max = 21, z = 5 })
				Theme.Label(row, ending.subtitle, { dims = UDim2.new(1, -20, 0, 18), pos = UDim2.fromOffset(12, 32), font = F.body, color = C.dim, max = 14, z = 5 })
			end
		else
			local stats = profile.stats or {}
			local docCount = 0
			for _ in profile.docs do
				docCount += 1
			end
			for i, text in {
				"العملات: " .. tostring(profile.coins or 0),
				"جولات بدأت: " .. tostring(stats.runs or 0),
				"جولات منتهية: " .. tostring(stats.wins or 0),
				"مرات الهروب: " .. tostring(stats.escapes or 0),
				"مرات الموت: " .. tostring(stats.deaths or 0),
				string.format("الوثائق المقروءة: %d/%d", docCount, Config.TotalDocuments),
				profile.online == false and "الحفظ غير متاح (دون اتصال / Studio بلا وصول API)" or "يُحفظ التقدّم تلقائيًا",
			} do
				Theme.Label(content, text, { dims = UDim2.new(1, -8, 0, 30), font = F.body, color = i == 7 and C.dim or C.text, max = 19, order = i, z = 4 })
			end
		end
	end)
end

----------------------------------------------------------------------------------------
-- Lobby
----------------------------------------------------------------------------------------

local lobbyRefresh: (() -> ())? = nil

local function showLobby()
	local p = newPage("ردهة اللعب الجماعي")
	local list = scrollArea(p, 58)
	list.Size = UDim2.new(0.55, -20, 1, -74)
	local controls = Theme.New("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0.55, 10, 0, 58), Size = UDim2.new(0.45, -30, 1, -74), ZIndex = 4, Parent = p })
	Theme.List(controls, 8)
	local diffLabel = Theme.Label(controls, "", { dims = UDim2.new(1, 0, 0, 22), font = F.bold, color = C.gold, max = 14, order = 1, z = 5 })
	local diffRow = Theme.New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 2, ZIndex = 5, Parent = controls })
	Theme.List(diffRow, 4, true)
	local diffButtons = {}
	for i, id in Config.DifficultyOrder do
		local b = Theme.Button(diffRow, Config.Difficulty[id].label, function()
			lobbyAction("Difficulty", id)
		end, { dims = UDim2.new(1 / 3, -3, 1, 0), order = i, font = F.bold, max = 12, z = 6 })
		b.ZIndex = 6
		diffButtons[id] = b
	end
	local readyButton = Theme.Button(controls, "مستعد", function()
		lobbyAction("Ready")
	end, { order = 3, z = 5 })
	local startButton = Theme.Button(controls, "ابدأ الجولة", function()
		lobbyAction("Start")
	end, { order = 4, z = 5, color = C.burgundy })
	local continueButton = Theme.Button(controls, "متابعة الجولة المحفوظة", function()
		lobbyAction("Continue")
	end, { order = 5, z = 5 })
	Theme.Button(controls, "ادعُ أصدقاءك", function()
		pcall(function()
			SocialService:PromptGameInvite(player)
		end)
	end, { order = 6, z = 5 })
	local privateButton = Theme.Button(controls, "جولة خاصة (للمستعدين)", function()
		lobbyAction("Private")
	end, { order = 7, z = 5, max = 16 })
	local note = Theme.Label(controls, "", { dims = UDim2.new(1, 0, 0, 40), font = F.body, color = C.dim, max = 14, order = 8, z = 5 })

	lobbyRefresh = function()
		if not list.Parent then
			lobbyRefresh = nil
			return
		end
		for _, child in list:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local rs = State.RunState
		for i, entry in rs.players or {} do
			local row = Theme.New("Frame", { BackgroundColor3 = C.panel2, BackgroundTransparency = 0.3, Size = UDim2.new(1, -8, 0, 40), LayoutOrder = i, ZIndex = 5, Parent = list })
			Theme.Corner(row, 6)
			local crown = entry.userId == rs.host and "👑 " or ""
			Theme.Label(row, crown .. entry.name, { dims = UDim2.new(0.65, 0, 1, 0), pos = UDim2.fromOffset(12, 0), font = F.body, max = 18, z = 6 })
			local status = entry.inRun and "في الجولة" or (entry.ready and "مستعد" or "...")
			Theme.Label(row, status, { dims = UDim2.new(0.3, 0, 1, 0), pos = UDim2.fromScale(0.68, 0), font = F.bold, color = entry.ready and C.good or C.dim, align = Enum.TextXAlignment.Right, max = 13, z = 6 })
		end
		local host = isHost()
		diffLabel.Text = "الصعوبة: " .. (Config.Difficulty[rs.difficulty or "Normal"] or Config.Difficulty.Normal).label .. (host and "" or "  (المضيف يقرّر)")
		for id, b in diffButtons do
			b.BackgroundColor3 = id == rs.difficulty and C.burgundy or C.panel2
			Theme.SetDisabled(b, not host or rs.state ~= "Lobby")
		end
		local me
		for _, entry in rs.players or {} do
			if entry.userId == player.UserId then
				me = entry
			end
		end
		readyButton.Label.Text = me and me.ready and "غير مستعد" or "مستعد"
		Theme.SetDisabled(readyButton, rs.state ~= "Lobby")
		Theme.SetDisabled(startButton, not host or rs.state ~= "Lobby")
		continueButton.Visible = host and rs.canContinue == true
		if rs.continueMission and MissionDefs[rs.continueMission] then
			continueButton.Label.Text = "متابعة: " .. MissionDefs[rs.continueMission].title
		end
		Theme.SetDisabled(privateButton, not host or rs.privateServer)
		if rs.state == "Playing" then
			note.Text = "هناك جولة جارية - اضغط «العب» للانضمام."
		elseif rs.privateServer then
			note.Text = "خادم خاص. لا ينضم إلا المدعوون."
		else
			note.Text = string.format("حتى %d لاعبين. تبدأ الجولة عندما يستعد الجميع أو يبدأها المضيف.", Config.MaxPlayers)
		end
	end
	lobbyRefresh()
end

----------------------------------------------------------------------------------------
-- Root menu
----------------------------------------------------------------------------------------

local function refreshButtons()
	local rs = State.RunState
	local inRun = State.InRun()
	local playText
	if inRun then
		playText = "استئناف"
	elseif rs.state == "Playing" then
		playText = "انضم للجولة"
	elseif rs.state == "Ending" then
		playText = "يرجى الانتظار..."
	else
		playText = #(rs.players or {}) > 1 and "العب  (استعد)" or "العب"
	end
	buttons.play.Label.Text = playText
	Theme.SetDisabled(buttons.play, rs.state == "Ending")
	buttons.lobby.Visible = not inRun
	if State.Profile then
		coinsLabel.Text = string.format("🪙  %d", State.Profile.coins or 0)
	end
	if lobbyRefresh then
		lobbyRefresh()
	end
end

function Menu.Open()
	root.Visible = true
	State.Set("MenuOpen", true)
	refreshButtons()
	root.BackgroundTransparency = 1
	TweenService:Create(root, TweenInfo.new(0.4), { BackgroundTransparency = State.InRun() and 0.35 or 0.55 }):Play()
end

function Menu.Close(keepPage: boolean?)
	if not keepPage then
		clearPage()
	end
	root.Visible = false
	State.Set("MenuOpen", false)
end

function Menu.Toggle()
	if root.Visible then
		if State.InRun() then
			Menu.Close()
		end
	else
		Panels.Close()
		Menu.Open()
	end
end

function Menu.Init()
	gui = Theme.New("ScreenGui", {
		Name = "HotelMenu",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 10,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	root = Theme.New("Frame", { Name = "Root", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.55, Size = UDim2.fromScale(1, 1), Parent = gui })
	Theme.New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Modal = true, Parent = root })
	Theme.Vignette(root, Color3.new(0, 0, 0), 0.9, 1)
	sidePanel = Theme.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromScale(0.05, 0.08), Size = UDim2.fromScale(0.34, 0.86), ZIndex = 2, Parent = root })
	Theme.New("UISizeConstraint", { MinSize = Vector2.new(240, 0), MaxSize = Vector2.new(460, 2000), Parent = sidePanel })
	local title = Theme.Label(sidePanel, "الفندق\nالمنسي", { dims = UDim2.new(1, 0, 0.22, 0), font = F.title, color = C.gold, max = 64, z = 3 })
	Theme.Stroke(title, Color3.new(0, 0, 0), 2, 0.3).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	Theme.Label(sidePanel, "THE FORGOTTEN HOTEL", { dims = UDim2.new(1, 0, 0.06, 0), pos = UDim2.fromScale(0, 0.22), font = Enum.Font.Arial, color = C.text, max = 34, z = 3 })
	Theme.Label(sidePanel, "بعض الضيوف لا يغادرون أبدًا.", { dims = UDim2.new(1, 0, 0.04, 0), pos = UDim2.fromScale(0, 0.285), font = F.body, color = C.dim, max = 20, z = 3 })
	local column = Theme.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromScale(0, 0.37), Size = UDim2.new(1, 0, 0.5, 0), ZIndex = 3, Parent = sidePanel })
	local layout = Theme.List(column, 10)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	local function menuButton(order: number, text: string, onClick)
		local b = Theme.Button(column, text, onClick, { dims = UDim2.new(0.86, 0, 0, 50), order = order, align = Enum.TextXAlignment.Right, max = 26, z = 4 })
		b.ZIndex = 4
		return b
	end
	buttons.play = menuButton(1, "العب", function()
		if State.InRun() then
			Menu.Close()
			return
		end
		lobbyAction("Play")
		if #(State.RunState.players or {}) > 1 and State.RunState.state == "Lobby" then
			showLobby()
		end
	end)
	buttons.lobby = menuButton(2, "ردهة اللعب الجماعي", showLobby)
	buttons.settings = menuButton(3, "الإعدادات", showSettings)
	buttons.extras = menuButton(4, "الإضافات", showExtras)
	coinsLabel = Theme.Label(sidePanel, "🪙  0", { dims = UDim2.new(1, 0, 0, 26), pos = UDim2.new(0, 0, 1, -30), font = F.ui, color = C.gold, max = 18, z = 3 })
	Theme.Label(root, "يُنصح باستخدام السماعات.  العب في الظلام.", { dims = UDim2.new(0.5, 0, 0, 20), pos = UDim2.new(0.5, 0, 1, -28), anchor = Vector2.new(0.5, 0), font = F.body, color = C.dim, align = Enum.TextXAlignment.Center, max = 15, z = 2 })

	State.Changed:Connect(function(key, value)
		if key == "RunState" then
			local inRun = State.InRun()
			-- when the run starts for us, close the menu; when we're back in the lobby, open it
			if value.state == "Playing" and inRun and root.Visible and not Menu._wasInRun then
				Menu.Close()
			elseif value.state == "Lobby" and not root.Visible then
				Menu.Open()
			end
			Menu._wasInRun = inRun
			refreshButtons()
		elseif key == "Profile" then
			refreshButtons()
		end
	end)
	Menu.Open()
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Modal panels: document reader, keypad, elevator panel, final choice, inventory and the
-- ending screen. Opening a panel frees the mouse (Modal) and blocks gameplay input.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Documents = require(Shared.Documents)
local Items = require(Shared.Items)
local Net = require(Shared.Net)
local Sounds = require(Shared.Sounds)
local Progression = require(Shared.Progression)
local Config = require(Shared.Config)

local State = require(script.Parent.Parent.State)
local Theme = require(script.Parent.Theme)
local C, F = Theme.Colors, Theme.Fonts

local Panels = {}
local player = Players.LocalPlayer
local gui: ScreenGui
local current: Frame? = nil
local keypadInput: RBXScriptConnection? = nil

function Panels.Close()
	if current then
		current:Destroy()
		current = nil
	end
	if keypadInput then
		keypadInput:Disconnect()
		keypadInput = nil
	end
	State.Set("PanelOpen", nil)
end

local function open(name: string, dims: UDim2, maxSize: Vector2)
	Panels.Close()
	local backdrop = Theme.New("Frame", {
		Name = name,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})
	-- invisible modal button frees the mouse in first person
	Theme.New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Modal = true, Parent = backdrop })
	local panel = Theme.Panel(backdrop, { dims = dims, maxSize = maxSize, z = 2 })
	panel.Size = UDim2.new(dims.X.Scale * 0.92, dims.X.Offset, dims.Y.Scale * 0.92, dims.Y.Offset)
	TweenService:Create(panel, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Size = dims }):Play()
	current = backdrop
	State.Set("PanelOpen", name)
	local close = Theme.Button(panel, "✕", Panels.Close, {
		dims = UDim2.fromOffset(34, 34),
		pos = UDim2.new(1, -8, 0, 8),
		anchor = Vector2.new(1, 0),
		font = F.ui,
		z = 5,
	})
	close.ZIndex = 5
	return panel
end

----------------------------------------------------------------------------------------
-- Document reader
----------------------------------------------------------------------------------------

function Panels.Document(docId: string)
	local doc = Documents[docId]
	if not doc then
		return
	end
	local panel = open("Document", UDim2.fromScale(0.5, 0.78), Vector2.new(620, 760))
	local paper = Theme.New("Frame", {
		BackgroundColor3 = C.paper,
		Position = UDim2.fromOffset(18, 52),
		Size = UDim2.new(1, -36, 1, -70),
		ZIndex = 3,
		Parent = panel,
	})
	Theme.Corner(paper, 4)
	Theme.Gradient(paper, C.paper, Color3.fromRGB(196, 180, 146), 120)
	Theme.Label(panel, (doc.journal and "مذكرات  ·  " or "وثيقة  ·  ") .. doc.where, { dims = UDim2.new(1, -80, 0, 18), pos = UDim2.fromOffset(18, 18), font = F.bold, color = C.gold, max = 13, z = 3 })
	local scroll = Theme.New("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -32, 1, -24),
		Position = UDim2.fromOffset(16, 12),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.ink,
		ZIndex = 4,
		Parent = paper,
	})
	Theme.List(scroll, 10)
	local title = Theme.Label(scroll, doc.title, { dims = UDim2.new(1, -8, 0, 34), font = F.type, color = C.ink, max = 28, order = 1, z = 4 })
	title.TextScaled = true
	local body = Theme.Label(scroll, doc.body, { dims = UDim2.new(1, -8, 0, 0), font = F.type, color = C.ink, scaled = false, size = 19, order = 2, z = 4, valign = Enum.TextYAlignment.Top })
	body.AutomaticSize = Enum.AutomaticSize.Y
	Sounds.Play("Paper")
end

----------------------------------------------------------------------------------------
-- Keypad
----------------------------------------------------------------------------------------

function Panels.Keypad(id: string, title: string, digits: number)
	local panel = open("Keypad", UDim2.fromOffset(300, 430), Vector2.new(300, 430))
	Theme.Label(panel, title, { dims = UDim2.new(1, -60, 0, 24), pos = UDim2.fromOffset(16, 14), font = F.bold, color = C.gold, max = 16, z = 3 })
	local display = Theme.New("TextLabel", {
		BackgroundColor3 = Color3.fromRGB(16, 4, 4),
		Position = UDim2.fromOffset(20, 52),
		Size = UDim2.new(1, -40, 0, 54),
		Font = Enum.Font.Arcade,
		TextColor3 = Color3.fromRGB(255, 90, 60),
		TextScaled = true,
		Text = string.rep("_ ", digits),
		ZIndex = 3,
		Parent = panel,
	})
	Theme.Corner(display, 4)
	local code = ""
	local function refresh()
		local shown = code .. string.rep("_", digits - #code)
		display.Text = shown:gsub(".", "%0 ")
	end
	local function press(key: string)
		if key == "C" then
			code = ""
		elseif key == "OK" then
			if #code == digits then
				Net.Event("Keypad"):FireServer(id, code)
				task.delay(0.15, Panels.Close)
			end
			return
		elseif #code < digits then
			code ..= key
		end
		Sounds.Play("Click")
		refresh()
	end
	local grid = Theme.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 120), Size = UDim2.new(1, -40, 1, -136), ZIndex = 3, Parent = panel })
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(1 / 3, -8, 0.25, -8)
	layout.CellPadding = UDim2.fromOffset(8, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	for i, key in { "1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "OK" } do
		local b = Theme.Button(grid, key, function()
			press(key)
		end, { order = i, font = Enum.Font.Arcade, z = 4, color = key == "OK" and C.burgundy or nil })
		b.ZIndex = 4
	end
	keypadInput = UserInputService.InputBegan:Connect(function(input)
		local name = input.KeyCode.Name
		local map = { Zero = "0", One = "1", Two = "2", Three = "3", Four = "4", Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9" }
		local digit = map[name] or map[(name:gsub("KeypadZero", "Zero"):gsub("^Keypad", ""))]
		if digit then
			press(digit)
		elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
			press("OK")
		elseif input.KeyCode == Enum.KeyCode.Backspace then
			code = code:sub(1, -2)
			refresh()
		end
	end)
end

----------------------------------------------------------------------------------------
-- Choices: elevator panel / final choice
----------------------------------------------------------------------------------------

function Panels.Elevator(data)
	local panel = open("Elevator", UDim2.fromOffset(280, 380), Vector2.new(280, 380))
	Theme.Label(panel, "اختر الطابق", { dims = UDim2.new(1, -60, 0, 24), pos = UDim2.fromOffset(16, 14), font = F.bold, color = C.gold, max = 16, z = 3 })
	local list = Theme.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(20, 52), Size = UDim2.new(1, -40, 1, -70), ZIndex = 3, Parent = panel })
	Theme.List(list, 8)
	for i = #data.floors, 1, -1 do
		local floor = data.floors[i]
		local isCurrent = floor == data.current
		local b = Theme.Button(list, string.format("%s   ·   %s", data.labels[floor], data.names[floor]), function()
			Net.Event("Choice"):FireServer("elevator", floor)
			Panels.Close()
		end, { dims = UDim2.new(1, 0, 0, 60), order = #data.floors - i, z = 4, color = isCurrent and C.burgundy or nil })
		b.ZIndex = 4
	end
end

function Panels.FinalChoice(data)
	local panel = open("FinalChoice", UDim2.fromScale(0.6, 0.7), Vector2.new(760, 620))
	Theme.Label(panel, "القلب", { dims = UDim2.new(1, 0, 0, 44), pos = UDim2.fromOffset(0, 16), font = F.title, color = C.danger, align = Enum.TextXAlignment.Center, max = 40, z = 3 })
	Theme.Label(panel, "الفندق كله يُصغي. اختر.", { dims = UDim2.new(1, 0, 0, 22), pos = UDim2.fromOffset(0, 60), font = F.body, color = C.dim, align = Enum.TextXAlignment.Center, max = 18, z = 3 })
	local list = Theme.New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 96), Size = UDim2.new(1, -48, 1, -112), ZIndex = 3, Parent = panel })
	Theme.List(list, 10)
	for i, option in data.options do
		local card = Theme.Button(list, "", function()
			if option.disabled then
				return
			end
			Net.Event("Choice"):FireServer("final", option.id)
			Panels.Close()
		end, { dims = UDim2.new(1, 0, 0.22, -6), order = i, z = 4, color = option.secret and Color3.fromRGB(30, 50, 46) or nil })
		card.ZIndex = 4
		Theme.Label(card, option.title, { dims = UDim2.new(1, -24, 0.45, 0), pos = UDim2.fromOffset(12, 6), font = F.title, color = option.secret and Color3.fromRGB(170, 255, 220) or C.gold, max = 26, z = 5 })
		Theme.Label(card, option.desc, { dims = UDim2.new(1, -24, 0.45, 0), pos = UDim2.new(0, 12, 0.5, 0), font = F.body, color = C.dim, max = 18, z = 5 })
		if option.disabled then
			Theme.SetDisabled(card, true)
		end
	end
end

----------------------------------------------------------------------------------------
-- Inventory
----------------------------------------------------------------------------------------

function Panels.Inventory()
	if current and current.Name == "Inventory" then
		Panels.Close()
		return
	end
	local panel = open("Inventory", UDim2.fromScale(0.5, 0.6), Vector2.new(640, 520))
	Theme.Label(panel, "الحقيبة", { dims = UDim2.new(1, -60, 0, 28), pos = UDim2.fromOffset(18, 14), font = F.title, color = C.gold, max = 26, z = 3 })
	local scroll = Theme.New("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 54),
		Size = UDim2.new(1, -36, 1, -70),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 4,
		ZIndex = 3,
		Parent = panel,
	})
	Theme.List(scroll, 8)
	if #State.Inventory == 0 then
		Theme.Label(scroll, "جيوبك فارغة.", { dims = UDim2.new(1, 0, 0, 30), font = F.body, color = C.dim, max = 20, z = 3 })
	end
	for i, entry in State.Inventory do
		local def = Items[entry.id]
		if def then
			local row = Theme.New("Frame", { BackgroundColor3 = C.panel2, BackgroundTransparency = 0.3, Size = UDim2.new(1, -8, 0, 64), LayoutOrder = i, ZIndex = 3, Parent = scroll })
			Theme.Corner(row, 6)
			Theme.Label(row, def.icon, { dims = UDim2.fromOffset(56, 64), font = F.ui, align = Enum.TextXAlignment.Center, max = 30, z = 4 })
			Theme.Label(row, def.name .. (entry.count > 1 and ("  x" .. entry.count) or ""), { dims = UDim2.new(1, -170, 0, 26), pos = UDim2.fromOffset(60, 6), font = F.title, color = C.gold, max = 20, z = 4 })
			Theme.Label(row, def.desc, { dims = UDim2.new(1, -170, 0, 26), pos = UDim2.fromOffset(60, 32), font = F.body, color = C.dim, max = 15, z = 4 })
			if entry.id == "Battery" or entry.id == "Bandage" then
				local use = Theme.Button(row, "استخدم", function()
					Net.Event("UseItem"):FireServer(entry.id)
					Panels.Close()
				end, { dims = UDim2.fromOffset(90, 40), pos = UDim2.new(1, -100, 0.5, 0), anchor = Vector2.new(0, 0.5), z = 5 })
				use.ZIndex = 5
			end
		end
	end
end

----------------------------------------------------------------------------------------
-- Ending
----------------------------------------------------------------------------------------

function Panels.Ending(endingId: string, results)
	Panels.Close()
	local ending = Progression.Endings[endingId]
	if not ending then
		return
	end
	local screen = Theme.New("Frame", { Name = "Ending", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 20, Parent = gui })
	Theme.New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Modal = true, ZIndex = 20, Parent = screen })
	current = screen
	State.Set("PanelOpen", "Ending")
	TweenService:Create(screen, TweenInfo.new(2.5), { BackgroundTransparency = 0 }):Play()
	task.wait(2.5)
	local column = Theme.New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.7, 0.8), ZIndex = 21, Parent = screen })
	Theme.New("UISizeConstraint", { MaxSize = Vector2.new(820, 700), Parent = column })
	local function line(text, font, color, height, y, size)
		local l = Theme.Label(column, text, { dims = UDim2.new(1, 0, 0, height), pos = UDim2.fromOffset(0, y), font = font, color = color, align = Enum.TextXAlignment.Center, max = size, z = 22 })
		l.TextTransparency = 1
		TweenService:Create(l, TweenInfo.new(1.5), { TextTransparency = 0 }):Play()
		return l
	end
	line(ending.subtitle, F.bold, C.gold, 20, 0, 16)
	task.wait(0.6)
	line(ending.title, F.title, C.text, 70, 28, 64)
	task.wait(0.8)
	local body = line(ending.text, F.body, C.dim, 180, 110, 22)
	body.TextYAlignment = Enum.TextYAlignment.Top
	task.wait(1)
	local minutes = math.floor(results.time / 60)
	line(string.format("الوقت  %d:%02d     ·     الوثائق  %d/12     ·     %s%s", minutes, results.time % 60, results.documents, (Config.Difficulty[results.difficulty] and Config.Difficulty[results.difficulty].label or results.difficulty), results.untouched and "     ·     دون إصابة" or ""), F.ui, C.text, 22, 310, 16)
	line(string.format("+ %d عملة", results.coins), F.title, C.gold, 34, 344, 28)
	local countdown = line("", F.body, C.dim, 22, 400, 16)
	task.spawn(function()
		for t = 24, 0, -1 do
			if not countdown.Parent then
				return
			end
			countdown.Text = string.format("الفندق سينساك خلال %d...", t)
			task.wait(1)
		end
	end)
end

----------------------------------------------------------------------------------------

function Panels.IsOpen(): boolean
	return current ~= nil
end

function Panels.Init()
	gui = Theme.New("ScreenGui", {
		Name = "HotelPanels",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 8,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	Net.Event("Document").OnClientEvent:Connect(Panels.Document)
	Net.Event("Keypad").OnClientEvent:Connect(Panels.Keypad)
	Net.Event("Choice").OnClientEvent:Connect(function(context, data)
		if context == "elevator" then
			Panels.Elevator(data)
		elseif context == "final" then
			Panels.FinalChoice(data)
		end
	end)
	Net.Event("Ending").OnClientEvent:Connect(function(endingId, results)
		Panels.Ending(endingId, results)
	end)
	State.Changed:Connect(function(key, value)
		if key == "RunState" and value.state == "Lobby" and current and current.Name == "Ending" then
			Panels.Close()
		end
	end)
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!nonstrict
-- UI kit: palette, fonts and small constructors used by every screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Sounds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sounds"))

local Theme = {}

Theme.Colors = {
	bg = Color3.fromRGB(8, 6, 8),
	panel = Color3.fromRGB(20, 12, 14),
	panel2 = Color3.fromRGB(32, 18, 22),
	burgundy = Color3.fromRGB(92, 24, 34),
	deep = Color3.fromRGB(50, 12, 20),
	gold = Color3.fromRGB(196, 160, 92),
	goldDim = Color3.fromRGB(130, 104, 62),
	text = Color3.fromRGB(232, 222, 204),
	dim = Color3.fromRGB(160, 148, 132),
	danger = Color3.fromRGB(210, 50, 44),
	cold = Color3.fromRGB(130, 170, 230),
	good = Color3.fromRGB(110, 200, 130),
	paper = Color3.fromRGB(226, 214, 186),
	ink = Color3.fromRGB(36, 28, 22),
}

Theme.Fonts = {
	title = Enum.Font.Bodoni,
	body = Enum.Font.Garamond,
	ui = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
	type = Enum.Font.SpecialElite,
	horror = Enum.Font.Creepster,
}

function Theme.New(className: string, props, children)
	local inst = Instance.new(className)
	local parent = nil
	for k, v in props or {} do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if inst:IsA("GuiObject") and props and props.BorderSizePixel == nil then
		inst.BorderSizePixel = 0
	end
	inst.Parent = parent
	return inst
end

function Theme.Corner(parent: Instance, radius: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 6)
	c.Parent = parent
	return c
end

function Theme.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Colors.gold
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function Theme.Padding(parent: Instance, px: number)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.Parent = parent
	return p
end

function Theme.TextLimit(label: Instance, maxSize: number, minSize: number?)
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = maxSize
	c.MinTextSize = minSize or 8
	c.Parent = label
	return c
end

function Theme.Gradient(parent: Instance, a: Color3, b: Color3, rotation: number?)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(a, b)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

function Theme.List(parent: Instance, padding: number, horizontal: boolean?, align: Enum.HorizontalAlignment?)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	if align then
		l.HorizontalAlignment = align
	end
	l.Parent = parent
	return l
end

function Theme.Label(parent: Instance, text: string, props)
	props = props or {}
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = props.color or Theme.Colors.text
	label.Font = props.font or Theme.Fonts.body
	label.TextScaled = props.scaled ~= false
	label.TextSize = props.size or 18
	label.TextWrapped = true
	label.TextXAlignment = props.align or Enum.TextXAlignment.Right
	label.TextYAlignment = props.valign or Enum.TextYAlignment.Center
	label.Size = props.dims or UDim2.fromScale(1, 1)
	label.Position = props.pos or UDim2.new()
	label.AnchorPoint = props.anchor or Vector2.zero
	label.RichText = props.rich == true
	label.LayoutOrder = props.order or 0
	label.ZIndex = props.z or 1
	label.BorderSizePixel = 0
	if props.max then
		Theme.TextLimit(label, props.max)
	end
	label.Parent = parent
	return label
end

-- Styled button: dark panel, gold outline, hover glow, click sound.
function Theme.Button(parent: Instance, text: string, onClick: () -> (), props)
	props = props or {}
	local C = Theme.Colors
	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.Text = ""
	button.BackgroundColor3 = props.color or C.panel2
	button.BackgroundTransparency = props.transparency or 0.1
	button.Size = props.dims or UDim2.new(1, 0, 0, 44)
	button.Position = props.pos or UDim2.new()
	button.AnchorPoint = props.anchor or Vector2.zero
	button.LayoutOrder = props.order or 0
	button.ZIndex = props.z or 1
	button.BorderSizePixel = 0
	button.Parent = parent
	Theme.Corner(button, 6)
	local stroke = Theme.Stroke(button, C.gold, 1, 0.55)
	local label = Theme.Label(button, text, {
		font = props.font or Theme.Fonts.title,
		color = props.textColor or C.text,
		align = props.align or Enum.TextXAlignment.Center,
		dims = UDim2.new(1, -16, 1, -10),
		pos = UDim2.fromOffset(8, 5),
		max = props.max or 24,
		z = (props.z or 1) + 1,
	})
	label.Name = "Label"
	button.MouseEnter:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end
		Sounds.Play("UIHover")
		TweenService:Create(stroke, TweenInfo.new(0.15), { Transparency = 0 }):Play()
		TweenService:Create(button, TweenInfo.new(0.15), { BackgroundColor3 = C.burgundy }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(stroke, TweenInfo.new(0.2), { Transparency = 0.55 }):Play()
		TweenService:Create(button, TweenInfo.new(0.2), { BackgroundColor3 = props.color or C.panel2 }):Play()
	end)
	button.Activated:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end
		Sounds.Play("UIClick")
		onClick()
	end)
	return button, label
end

function Theme.SetDisabled(button: GuiButton, disabled: boolean)
	button:SetAttribute("Disabled", disabled)
	button.BackgroundTransparency = disabled and 0.6 or 0.1
	local label = button:FindFirstChild("Label")
	if label then
		label.TextTransparency = disabled and 0.5 or 0
	end
end

-- Dark framed panel with a burgundy gradient and gold border.
function Theme.Panel(parent: Instance, props)
	props = props or {}
	local C = Theme.Colors
	local frame = Instance.new("Frame")
	frame.Name = props.name or "Panel"
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	frame.BackgroundTransparency = props.transparency or 0.04
	frame.Size = props.dims or UDim2.fromScale(0.5, 0.6)
	frame.Position = props.pos or UDim2.fromScale(0.5, 0.5)
	frame.AnchorPoint = props.anchor or Vector2.new(0.5, 0.5)
	frame.ZIndex = props.z or 1
	frame.BorderSizePixel = 0
	frame.Parent = parent
	Theme.Gradient(frame, C.panel2, C.bg, 90)
	Theme.Corner(frame, 10)
	Theme.Stroke(frame, C.gold, 1.2, 0.35)
	if props.maxSize then
		local size = Instance.new("UISizeConstraint")
		size.MaxSize = props.maxSize
		size.Parent = frame
	end
	return frame
end

-- Edge vignette made of four gradient strips (no image assets).
function Theme.Vignette(parent: Instance, color: Color3, strength: number, z: number?)
	local holder = Instance.new("Frame")
	holder.Name = "Vignette"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = z or 1
	holder.Parent = parent
	local specs = {
		{ UDim2.fromScale(1, 0.35), UDim2.fromScale(0, 0), 90 },
		{ UDim2.fromScale(1, 0.35), UDim2.fromScale(0, 0.65), -90 },
		{ UDim2.fromScale(0.3, 1), UDim2.fromScale(0, 0), 0 },
		{ UDim2.fromScale(0.3, 1), UDim2.fromScale(0.7, 0), 180 },
	}
	for _, spec in specs do
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = color
		f.Size = spec[1]
		f.Position = spec[2]
		f.ZIndex = z or 1
		f.Parent = holder
		local g = Instance.new("UIGradient")
		g.Rotation = spec[3]
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1 - strength),
			NumberSequenceKeypoint.new(1, 1),
		})
		g.Parent = f
	end
	return holder
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="65">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
      <int name="StreamingMinRadius">96</int>
      <int name="StreamingTargetRadius">320</int>
    </Properties>
  </Item>
</roblox>